{%- assign rate_22k = gold_rate_22k | default: settings.gold_rate_22k | default: "13,000" -%}
{%- assign rate_18k = gold_rate_18k | default: settings.gold_rate_18k | default: "12,000" -%}
{%- assign rate_silver = settings.silver_rate_925 | default: "160" -%}
<div class="gold-rate-ticker-widget" data-modal-type="hallmark">
  <span class="gold-rate-ticker-dot"></span>
  <span class="gold-rate-ticker-label brand-gold-only">Live Gold Rate:</span>
  <span class="gold-rate-ticker-label brand-silver-only">Live 925 Silver Rate:</span>
  <span class="gold-rate-ticker-value brand-gold-only" data-purity="22k" id="globalGold22k" data-base-rate="{{ rate_22k }}">₹{{ rate_22k }}/g (22K)</span>
  <span class="gold-rate-ticker-value brand-gold-only" data-purity="18k" id="globalGold18k" data-base-rate="{{ rate_18k }}">₹{{ rate_18k }}/g (18K)</span>
  <span class="gold-rate-ticker-value brand-silver-only" data-purity="silver" id="globalSilver925" data-base-rate="{{ rate_silver }}">₹{{ rate_silver }}/g (925 Silver)</span>
  <span class="gold-rate-ticker-transparency">(Verify Purity)</span>
</div>

<style>
.gold-rate-ticker-widget {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(212, 175, 55, 0.08);
  border: 1px solid rgba(212, 175, 55, 0.25);
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-gold-glow);
  cursor: pointer;
  transition: var(--transition-fast);
}

.gold-rate-ticker-widget:hover {
  background: rgba(212, 175, 55, 0.15);
  border-color: rgba(212, 175, 55, 0.5);
}

.gold-rate-ticker-dot {
  width: 6px;
  height: 6px;
  background-color: #25d366;
  border-radius: 50%;
  animation: pulseGreen 1.5s infinite;
}

.gold-rate-ticker-label {
  color: rgba(255, 255, 255, 0.6);
}

.gold-rate-ticker-value {
  color: var(--color-light);
  font-weight: 600;
  margin-right: 4px;
}

.gold-rate-ticker-transparency {
  color: var(--color-gold);
  font-size: 9px;
  text-decoration: underline;
  margin-left: 2px;
}

@media (max-width: 480px) {
  .gold-rate-ticker-label {
    display: none !important;
  }
  .gold-rate-ticker-transparency {
    font-size: 8px;
  }
  .gold-rate-ticker-widget {
    gap: 4px;
    padding: 3px 6px;
  }
}

@keyframes pulseGreen {
  0% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7);
  }
  70% {
    transform: scale(1.1);
    box-shadow: 0 0 0 4px rgba(37, 211, 102, 0);
  }
  100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
  }
}
</style>
