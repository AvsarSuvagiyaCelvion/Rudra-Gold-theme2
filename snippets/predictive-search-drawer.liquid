{% comment %}
  Predictive Search Drawer Snippet - Supporting dual brands (Rudra Gold & TGM)
{% endcomment %}

{%- assign selected_brand = 'gold' -%}
{%- if request.query_string contains 'brand=silver' or request.path contains 'silver' or request.path contains 'grand-mother' or request.path contains 'tgm' -%}
  {%- assign selected_brand = 'silver' -%}
{%- endif -%}

<div id="predictiveSearchModal" class="luxury-modal predictive-search-modal" aria-hidden="true">
  <div class="luxury-modal-overlay" id="predictiveSearchOverlay"></div>
  <div class="search-drawer-container">
    
    <!-- Top Brand Header Bar with Close Button -->
    <div class="search-drawer-top-bar">
      <h3 class="search-drawer-brand-title Cormorant">
        <span class="brand-gold-only">Search RUDRA GOLD</span>
        <span class="brand-silver-only">Search THE GRAND MOTHER</span>
      </h3>
      
      <!-- Prominent Close Button for Both Brands -->
      <button class="search-drawer-close-btn" id="predictiveSearchClose" onclick="closePredictiveSearchDrawerWindow()" aria-label="Close search window" title="Close Search">
        <span class="close-btn-text">CLOSE</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="search-drawer-header">
      <div class="search-input-wrapper">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" class="search-icon">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="predictiveSearchInput" placeholder="Search gold rings, bridal necklaces, 925 silver, solitaires..." autocomplete="off" aria-label="Search products">
        <button type="button" id="clearSearchBtn" class="clear-search-btn" style="display: none;" aria-label="Clear search">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <div class="search-drawer-body">
      <!-- Default Quick Suggestions & Trending Queries -->
      <div id="searchQuickSuggestions" class="search-suggestions-block">
        <div class="suggestion-group">
          <span class="suggestion-title">Trending Searches</span>
          <div class="search-pills">
            <a href="/collections/gold-rings" class="search-pill">22K Gold Rings</a>
            <a href="/collections/bridal" class="search-pill">Bridal Heritage Sets</a>
            <a href="/collections/solitaires" class="search-pill">Solitaire Engagement Rings</a>
            <a href="/collections/silver" class="search-pill">TGM 925 Silver Bands</a>
            <a href="/collections/mangalsutras" class="search-pill">Modern Mangalsutras</a>
          </div>
        </div>

        <div class="suggestion-group" style="margin-top: 24px;">
          <span class="suggestion-title">Popular Collections</span>
          <div class="search-collections-grid">
            <a href="/collections/bridal" class="search-collection-card">
              <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=150&q=80" alt="Bridal">
              <span>Bridal Edit</span>
            </a>
            <a href="/collections/temple" class="search-collection-card">
              <img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=150&q=80" alt="Temple Gold">
              <span>Temple Gold</span>
            </a>
            <a href="/collections/solitaires" class="search-collection-card">
              <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=150&q=80" alt="Solitaires">
              <span>Solitaire Collection</span>
            </a>
            <a href="/collections/silver" class="search-collection-card">
              <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=150&q=80" alt="TGM Silver">
              <span>TGM 925 Silver</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Realtime Results Container -->
      <div id="searchResultsContainer" class="search-results-block" style="display: none;">
        <span class="suggestion-title">Search Results</span>
        <div id="searchResultsGrid" class="search-results-grid"></div>
      </div>
    </div>
  </div>
</div>
