{% comment %}
  Renders a luxury product card.
  Accepts:
  - product: {Object} Shopify Product object (optional)
  - title: {String} Mock title
  - price: {Number} Mock price (in Rs)
  - image: {String} Mock image URL
  - hover_image: {String} Mock hover image URL
  - purity: {String} Gold purity (e.g. '22K Gold' or '18K Gold')
  - rating: {Number} Rating score out of 5
{% endcomment %}

  {%- assign card_title = title | default: "Royal Heritage Ring" -%}
  {%- assign card_price = price | default: 78500 -%}
  {%- assign card_purity = purity | default: "22K Gold" -%}
  {%- assign card_rating = rating | default: 5 -%}
  {%- assign card_weight = weight | default: "12.5" -%}
  {%- assign card_img = image | default: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80" -%}
  {%- assign card_hover_img = hover_image | default: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80" -%}
  {%- assign card_url = "/products/womens-ring" -%}
  {%- assign card_variant_id = "" -%}

  {%- if product != blank -%}
    {%- assign card_title = product.title -%}
    {%- assign card_price = product.price | money_without_currency | replace: ',', '' | plus: 0 -%}
    {%- assign card_variant_id = product.first_available_variant.id -%}
    {%- assign card_purity = "22K Gold" -%}
    {%- if product.metafields.custom.purity != blank -%}
      {%- assign card_purity = product.metafields.custom.purity -%}
    {%- endif -%}
    {%- assign card_weight = product.metafields.custom.metal_weight | default: product.variants.first.weight -%}
    {%- if card_weight != blank and card_weight > 0 -%}
      {%- if card_weight < 1.0 -%}
        {%- assign card_weight = card_weight | times: 1000 -%}
      {%- endif -%}
    {%- else -%}
      {%- assign card_weight = "32.4" -%}
    {%- endif -%}
    {%- assign card_img = product.featured_image | image_url: width: 600 -%}
    {%- if product.images[1] != blank -%}
      {%- assign card_hover_img = product.images[1] | image_url: width: 600 -%}
    {%- else -%}
      {%- assign card_hover_img = card_img -%}
    {%- endif -%}
    {%- assign card_url = product.url -%}
  {%- endif -%}

  {%- assign is_silver = false -%}
  {%- if product != blank -%}
    {%- assign product_tags_str = product.tags | join: ',' | downcase -%}
    {%- assign product_title_down = product.title | downcase -%}
    {%- if product_tags_str contains 'silver' or product_tags_str contains 'grand-mother' or product_title_down contains 'silver' or product_title_down contains 'grand mother' or product.type contains 'Silver' -%}
      {%- assign is_silver = true -%}
    {%- endif -%}
  {%- else -%}
    {%- assign card_title_down = card_title | downcase -%}
    {%- if card_title_down contains 'silver' or card_title_down contains 'grand mother' -%}
      {%- assign is_silver = true -%}
    {%- endif -%}
  {%- endif -%}

  {%- if is_silver -%}
    {%- assign card_purity = "925 Silver" -%}
    {%- if product.metafields.custom.purity != blank -%}
      {%- assign card_purity = product.metafields.custom.purity -%}
    {%- endif -%}
    {%- assign dynamic_price = card_price -%}
  {%- else -%}
    {%- assign gold_rate = 6850 -%}
    {%- if card_purity contains '18K' or card_purity contains '18k' -%}
      {%- assign gold_rate = 5605 -%}
    {%- endif -%}
    {%- assign weight_num = card_weight | plus: 0 -%}
    {%- assign metal_price = weight_num | times: gold_rate | round -%}
    {%- assign making_charges = metal_price | times: 0.12 | round -%}
    {%- assign subtotal = metal_price | plus: making_charges -%}
    {%- assign gst = subtotal | times: 0.03 | round -%}
    {%- assign dynamic_price = subtotal | plus: gst -%}
  {%- endif -%}

<div class="product-card tilt-card {% if is_silver %}silver-product-card{% else %}gold-product-card{% endif %}" data-purity="{{ card_purity | downcase }}">
  <div class="product-card-img-wrapper">
    <!-- Purity Badge -->
    <div class="purity-badge">{% if is_silver %}925 Silver{% else %}{{ card_purity }}{% endif %}</div>

    <!-- Wishlist Button -->
    <button class="wishlist-btn" aria-label="Add to Wishlist"
      data-title="{{ card_title | escape }}"
      data-price="₹{{ dynamic_price }}"
      data-raw-price="{{ dynamic_price }}"
      data-img="{{ card_img }}">
      {% render 'icon-wishlist' %}
    </button>

    <!-- Images -->
    <a href="{{ card_url }}">
      <img src="{{ card_img }}" alt="{{ card_title | escape }}" class="product-card-img primary-img" loading="lazy" width="400" height="400">
      <img src="{{ card_hover_img }}" alt="{{ card_title | escape }}" class="product-card-img hover-img" loading="lazy" width="400" height="400">
    </a>

    <!-- Hover Action Overlay -->
    <div class="product-card-actions">
      <span class="card-action-btn" onclick="addToCartAjax('{{ card_title | escape }}', {{ dynamic_price }}, '{{ card_img }}', '{{ card_purity }}', '{{ card_variant_id }}')">Quick Add</span>
      <span class="card-action-btn" onclick="triggerQuickView('{{ card_title | escape }}', {{ dynamic_price }}, '{{ card_img }}', '', '{{ card_variant_id }}')">Quick View</span>
    </div>
  </div>

  <div class="product-card-info">
    <h3 class="product-card-title">
      <a href="{{ card_url }}">{{ card_title }}</a>
    </h3>
    <div class="product-card-rating">
      {%- for i in (1..5) -%}
        {% render 'icon-star' %}
      {%- endfor -%}
    </div>
    
    <!-- Dynamic Certification and Spec Overlay -->
    <div class="product-card-spec-badges" style="margin: 4px 0; display: flex; gap: 4px; flex-wrap: wrap; justify-content: center;">
      {%- if is_silver -%}
        <span style="font-size: 9px; padding: 2px 6px; background: rgba(192, 192, 192, 0.15); border: 1px solid rgba(192, 192, 192, 0.3); border-radius: 2px; color: #555; text-transform: uppercase; font-weight: 600;">925 Certified</span>
        <span style="font-size: 9px; padding: 2px 6px; background: rgba(0, 150, 136, 0.1); border: 1px solid rgba(0, 150, 136, 0.2); border-radius: 2px; color: #00796B; text-transform: uppercase; font-weight: 600;">Anti-Tarnish</span>
      {%- else -%}
        <span style="font-size: 9px; padding: 2px 6px; background: rgba(200, 161, 61, 0.15); border: 1px solid rgba(200, 161, 61, 0.3); border-radius: 2px; color: #8F6B25; text-transform: uppercase; font-weight: 600;">BIS Hallmark</span>
        <span style="font-size: 9px; padding: 2px 6px; background: rgba(200, 161, 61, 0.1); border: 1px solid rgba(200, 161, 61, 0.2); border-radius: 2px; color: #8F6B25; text-transform: uppercase; font-weight: 600;">12% Making</span>
      {%- endif -%}
    </div>

    <div class="product-card-weight" style="font-size: 11px; color: var(--color-text-muted); margin-top: 4px; margin-bottom: 4px;">
      {{ card_weight }} grams
    </div>
    <div class="product-card-price" data-card-price-el data-purity="{{ card_purity }}" data-weight="{{ card_weight }}" data-title="{{ card_title | escape }}" data-img="{{ card_img }}" data-variant-id="{{ card_variant_id }}">
      ₹{{ dynamic_price }}
    </div>
  </div>
</div>
