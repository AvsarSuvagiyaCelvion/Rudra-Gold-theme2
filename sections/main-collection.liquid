{% schema %}
{
  "name": "Main Collection Grid",
  "settings": []
}
{% endschema %}

{%- assign current_url = canonical_url | downcase -%}
{%- assign selected_brand = 'gold' -%}
{%- if current_url contains 'brand=silver' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif current_url contains 'brand=gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif request.path contains 'silver' or request.path contains 'grand-mother' or request.path contains 'tgm' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif request.path contains 'gold' or request.path contains 'rudra-gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif product != blank -%}
  {%- assign product_tags_down = product.tags | join: ',' | downcase -%}
  {%- if product_tags_down contains 'silver' or product_tags_down contains 'grand mother' or product_tags_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- elsif collection != blank -%}
  {%- assign collection_handle_down = collection.handle | downcase -%}
  {%- if collection_handle_down contains 'silver' or collection_handle_down contains 'grand-mother' or collection_handle_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- endif -%}
<section class="main-collection-section section-padding">
  <!-- Mobile Filter Overlay Drawer -->
  <div class="mobile-filter-overlay" id="mobileFilterOverlay"></div>

  <div class="container">
    
    <!-- Top Filter & Sort Bar -->
    <div class="collection-top-bar">
      <div class="top-bar-left">
        {%- assign cat_label = "" -%}
        {%- if current_url contains 'cat=rings' -%}
          {%- assign cat_label = " Rings" -%}
        {%- elsif current_url contains 'cat=chains' -%}
          {%- assign cat_label = " Chains & Necklaces" -%}
        {%- elsif current_url contains 'cat=bangles' -%}
          {%- assign cat_label = " Bracelets & Bangles" -%}
        {%- elsif current_url contains 'cat=mangalsutras' -%}
          {%- assign cat_label = " Mangalsutras" -%}
        {%- elsif current_url contains 'cat=pendants' -%}
          {%- assign cat_label = " Pendants" -%}
        {%- elsif current_url contains 'cat=earrings' -%}
          {%- assign cat_label = " Earrings" -%}
        {%- elsif current_url contains 'cat=bridal' -%}
          {%- assign cat_label = " Bridal Heritage" -%}
        {%- elsif current_url contains 'cat=temple' -%}
          {%- assign cat_label = " Temple Gold" -%}
        {%- elsif current_url contains 'cat=daily-wear' -%}
          {%- assign cat_label = " Daily Wear" -%}
        {%- elsif current_url contains 'cat=solitaires' -%}
          {%- assign cat_label = " Solitaires" -%}
        {%- elsif current_url contains 'cat=rhodium' -%}
          {%- assign cat_label = " Rhodium Anti-Tarnish" -%}
        {%- elsif current_url contains 'cat=gold-plated' -%}
          {%- assign cat_label = " 18K Gold Plated Silver" -%}
        {%- elsif current_url contains 'cat=oxidized' -%}
          {%- assign cat_label = " Oxidized Silver" -%}
        {%- elsif current_url contains 'cat=zirconia' -%}
          {%- assign cat_label = " CZ Diamond Zirconia" -%}
        {%- elsif current_url contains 'cat=new-arrivals' -%}
          {%- assign cat_label = " New Arrivals" -%}
        {%- endif -%}

        <h2 class="collection-page-title">
          {%- if selected_brand == 'silver' -%}
            The Grand Mother Silver{{ cat_label }} Curation
          {%- else -%}
            Heritage Gold{{ cat_label }} Collection
          {%- endif -%}
        </h2>
        <span class="product-count">12 Exquisite Pieces Found</span>
      </div>

      <div class="top-bar-right">
        <!-- Filter Button on Mobile -->
        <button class="mobile-filter-trigger-btn" id="mobileFilterTriggerBtn">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
          </svg>
          Filter
        </button>

        <!-- Sort By -->
        <div class="sort-wrapper">
          <label for="sortBySelect">Sort By:</label>
          <select id="sortBySelect" class="sort-select-dropdown">
            <option value="featured">Featured Curation</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="bestsellers">Bestselling</option>
          </select>
        </div>

        <!-- Column Layout Grid Switcher -->
        <div class="grid-switcher">
          <span class="switcher-label">View:</span>
          <button class="grid-switcher-btn" data-columns="2" aria-label="Show 2 columns">2 Cols</button>
          <button class="grid-switcher-btn active" data-columns="3" aria-label="Show 3 columns">3 Cols</button>
          <button class="grid-switcher-btn" data-columns="4" aria-label="Show 4 columns">4 Cols</button>
        </div>
      </div>
    </div>

    <div class="collection-main-layout">
      
      <!-- Left Sidebar: Filters -->
      <aside class="collection-sidebar-filters" id="collectionSidebarFilters">
        <div class="sidebar-header-mobile">
          <h3>Refine Curation</h3>
          <button class="sidebar-close-btn-mobile" id="mobileFilterClose" aria-label="Close filters">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="sidebar-header-desktop">
          <h3 class="filter-sidebar-title">Refine By</h3>
          <button type="button" class="clear-filters-btn" id="clearFiltersBtn" title="Clear all active filters">
            Clear All
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <!-- Price Range Filter -->
        <div class="filter-group">
          <h4>Price Range</h4>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox price-filter" value="under-15k">
            <span>Under ₹15,000</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox price-filter" value="15k-50k">
            <span>₹15,000 - ₹50,000</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox price-filter" value="50k-150k">
            <span>₹50,000 - ₹1,50,000</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox price-filter" value="150k-up">
            <span>Over ₹1,50,000</span>
          </label>
        </div>

        <!-- Category Filter -->
        <div class="filter-group">
          <h4>Category</h4>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox cat-filter" value="rings">
            <span>Rings & Bands</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox cat-filter" value="chains">
            <span>Chains & Necklaces</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox cat-filter" value="mangalsutras">
            <span>Mangalsutras</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox cat-filter" value="bangles">
            <span>Bracelets & Bangles</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox cat-filter" value="pendants">
            <span>Pendants</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox cat-filter" value="earrings">
            <span>Earrings & Studs</span>
          </label>
        </div>

        <!-- Gender Filter -->
        <div class="filter-group">
          <h4>Gender</h4>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox gender-filter" value="women">
            <span>Women</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox gender-filter" value="men">
            <span>Men</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox gender-filter" value="unisex">
            <span>Unisex</span>
          </label>
        </div>

        <!-- Weight Range Filter -->
        <div class="filter-group">
          <h4>Metal Weight</h4>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox weight-filter" value="under-5g">
            <span>Under 5 grams</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox weight-filter" value="5g-15g">
            <span>5 - 15 grams</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox weight-filter" value="15g-up">
            <span>Over 15 grams</span>
          </label>
        </div>
      </aside>

      <!-- Right Side: Product Grid -->
      <div class="collection-content-grid-wrapper">
        {%- paginate collection.products by 12 -%}
        <div class="collection-grid cols-3" id="collectionProductGrid">
          {%- assign req_query = canonical_url | downcase -%}
          {%- assign active_cat = "" -%}
          {%- if req_query contains 'cat=rings' -%}
            {%- assign active_cat = "rings" -%}
          {%- elsif req_query contains 'cat=chains' -%}
            {%- assign active_cat = "chains" -%}
          {%- elsif req_query contains 'cat=mangalsutras' -%}
            {%- assign active_cat = "mangalsutras" -%}
          {%- elsif req_query contains 'cat=bangles' -%}
            {%- assign active_cat = "bangles" -%}
          {%- elsif req_query contains 'cat=pendants' -%}
            {%- assign active_cat = "pendants" -%}
          {%- elsif req_query contains 'cat=earrings' -%}
            {%- assign active_cat = "earrings" -%}
          {%- elsif req_query contains 'cat=bridal' -%}
            {%- assign active_cat = "bridal" -%}
          {%- elsif req_query contains 'cat=temple' -%}
            {%- assign active_cat = "temple" -%}
          {%- elsif req_query contains 'cat=daily-wear' -%}
            {%- assign active_cat = "daily-wear" -%}
          {%- elsif req_query contains 'cat=solitaires' -%}
            {%- assign active_cat = "solitaires" -%}
          {%- endif -%}

          {%- assign rendered_any_product = false -%}
          {%- if collection.products.size > 0 -%}
            {%- for product in collection.products -%}
              {%- assign product_tags_down = product.tags | join: ',' | downcase -%}
              {%- assign product_title_down = product.title | downcase -%}
              {%- assign product_type_down = product.type | downcase -%}
              
              {%- assign is_silver_product = false -%}
              {%- if product_tags_down contains 'silver' or product_tags_down contains 'grand mother' or product_tags_down contains 'tgm' or product_title_down contains 'silver' or product_type_down contains 'silver' -%}
                {%- assign is_silver_product = true -%}
              {%- endif -%}

              {%- assign is_brand_match = false -%}
              {%- if selected_brand == 'silver' and is_silver_product -%}
                {%- assign is_brand_match = true -%}
              {%- elsif selected_brand == 'gold' and is_silver_product == false -%}
                {%- assign is_brand_match = true -%}
              {%- endif -%}

              {%- if is_brand_match -%}
                {%- assign is_cat_match = true -%}
                {%- if active_cat != "" -%}
                  {%- assign combined_text = product_title_down | append: ' ' | append: product_tags_down | append: ' ' | append: product_type_down -%}
                  {%- case active_cat -%}
                    {%- when 'rings' -%}
                      {%- unless combined_text contains 'ring' or combined_text contains 'band' -%}
                        {%- assign is_cat_match = false -%}
                      {%- endunless -%}
                    {%- when 'chains' -%}
                      {%- unless combined_text contains 'chain' or combined_text contains 'necklace' or combined_text contains 'choker' -%}
                        {%- assign is_cat_match = false -%}
                      {%- endunless -%}
                    {%- when 'mangalsutras' -%}
                      {%- unless combined_text contains 'mangalsutra' or combined_text contains 'pendant' -%}
                        {%- assign is_cat_match = false -%}
                      {%- endunless -%}
                    {%- when 'bangles' -%}
                      {%- unless combined_text contains 'bangle' or combined_text contains 'bracelet' or combined_text contains 'anklet' or combined_text contains 'kada' -%}
                        {%- assign is_cat_match = false -%}
                      {%- endunless -%}
                    {%- when 'pendants' -%}
                      {%- unless combined_text contains 'pendant' -%}
                        {%- assign is_cat_match = false -%}
                      {%- endunless -%}
                    {%- when 'earrings' -%}
                      {%- unless combined_text contains 'earring' or combined_text contains 'jhumka' or combined_text contains 'stud' or combined_text contains 'hoop' or combined_text contains 'chandbali' -%}
                        {%- assign is_cat_match = false -%}
                      {%- endunless -%}
                  {%- endcase -%}
                {%- endif -%}

                {%- if is_cat_match -%}
                  {%- assign rendered_any_product = true -%}
                  {%- render 'product-card', product: product -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          
          {%- if collection.products.size == 0 or rendered_any_product == false -%}
            {%- comment -%} Fallback mock items dynamically filtered by category {%- endcomment -%}
            {%- if selected_brand == 'silver' -%}
              {%- if active_cat == 'rings' -%}
                {%- render 'product-card', title: "Classic Silver Solitaire Ring", price: 8500, image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
                {%- render 'product-card', title: "Minimalist Silver Stackable Band", price: 3200, image: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
                {%- render 'product-card', title: "TGM Celestial Diamond Star Band", price: 12400, image: "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
              {%- elsif active_cat == 'chains' -%}
                {%- render 'product-card', title: "Contemporary Sterling Silver Chain", price: 6800, image: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
                {%- render 'product-card', title: "Vintage Oxidized Silver Choker", price: 24000, image: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
              {%- elsif active_cat == 'bangles' -%}
                {%- render 'product-card', title: "Artisanal Silver Filigree Bangle", price: 15500, image: "https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
                {%- render 'product-card', title: "Silver Zirconia Tennis Bracelet", price: 18000, image: "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
              {%- elsif active_cat == 'earrings' -%}
                {%- render 'product-card', title: "Contemporary Sterling Hoop Earrings", price: 4200, image: "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
              {%- else -%}
                {%- render 'product-card', title: "Classic Silver Solitaire Ring", price: 8500, image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
                {%- render 'product-card', title: "Contemporary Sterling Hoop Earrings", price: 4200, image: "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
                {%- render 'product-card', title: "Silver Zirconia Tennis Bracelet", price: 18000, image: "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=600&q=80", purity: "925 Sterling Silver" -%}
              {%- endif -%}
            {%- else -%}
              {%- if active_cat == 'rings' -%}
                {%- render 'product-card', title: "Mayur Heritage Temple Ring", price: 68000, image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80", hover_image: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
                {%- render 'product-card', title: "Royal Peacock Gold Band", price: 49500, image: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=600&q=80", purity: "18K Gold" -%}
                {%- render 'product-card', title: "Imperial Diamond Solitaire Ring", price: 185000, image: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80", purity: "18K Gold" -%}
                {%- render 'product-card', title: "Ganga Jamuna Antique Ring", price: 72000, image: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
              {%- elsif active_cat == 'chains' -%}
                {%- render 'product-card', title: "Rudra Royal Signature Necklace", price: 245000, image: "https://images.unsplash.com/photo-1599643438383-e18e821d3e80?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
                {%- render 'product-card', title: "Nizami Pearl Heritage Choker", price: 380000, image: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
              {%- elsif active_cat == 'mangalsutras' -%}
                {%- render 'product-card', title: "Aadhya Royal Diamond Mangalsutra", price: 115000, image: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80", purity: "18K Gold" -%}
                {%- render 'product-card', title: "Heritage Black Bead Gold Mangalsutra", price: 98000, image: "https://images.unsplash.com/photo-1599643438383-e18e821d3e80?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
              {%- elsif active_cat == 'pendants' -%}
                {%- render 'product-card', title: "Royal Lakshmi Gold Temple Pendant", price: 58000, image: "https://images.unsplash.com/photo-1599643438383-e18e821d3e80?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
                {%- render 'product-card', title: "Solitaire Diamond Gold Pendant", price: 85000, image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80", purity: "18K Gold" -%}
                {%- render 'product-card', title: "Vedic Gold Ganesha Pendant", price: 42000, image: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
              {%- elsif active_cat == 'bangles' -%}
                {%- render 'product-card', title: "Glow Silhouette Bangles Set", price: 165000, image: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
                {%- render 'product-card', title: "Classic Solitaire Tennis Bracelet", price: 450000, image: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80", purity: "18K Gold" -%}
              {%- elsif active_cat == 'earrings' -%}
                {%- render 'product-card', title: "Imperial Heritage Gold Jhumkas", price: 88000, image: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
              {%- else -%}
                {%- render 'product-card', title: "Mayur Heritage Temple Ring", price: 68000, image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80", hover_image: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
                {%- render 'product-card', title: "Rudra Royal Signature Necklace", price: 245000, image: "https://images.unsplash.com/photo-1599643438383-e18e821d3e80?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
                {%- render 'product-card', title: "Glow Silhouette Bangles Set", price: 165000, image: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=600&q=80", purity: "22K Gold" -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        </div>

        <!-- Load More Trigger Button -->
        <div class="collection-load-more-wrapper">
          {%- if collection.products.size > 0 -%}
            {%- if paginate.next -%}
              <button class="btn-secondary" id="loadMoreBtn" data-next-url="{{ paginate.next.url }}" onclick="loadMoreProductsAJAX()">
                Discover More Pieces
              </button>
            {%- endif -%}
          {%- else -%}
            <button class="btn-secondary" id="loadMoreBtn" onclick="simulateLoadMore()">
              Discover More Pieces
            </button>
          {%- endif -%}
        </div>
        {%- endpaginate -%}
      </div>

    </div>

  </div>
</section>

<script>
  (function initCollectionPageController() {
    function parsePrice(card) {
      const priceBtn = card.querySelector('.wishlist-btn');
      if (priceBtn && priceBtn.dataset.rawPrice) {
        return parseInt(priceBtn.dataset.rawPrice, 10) || 0;
      }
      const priceEl = card.querySelector('.product-card-price, [data-card-price-el], .price');
      if (!priceEl) return 0;
      const text = priceEl.textContent.replace(/[^0-9]/g, '');
      return parseInt(text, 10) || 0;
    }

    function parseWeight(card) {
      const weightEl = card.querySelector('.product-card-weight');
      if (!weightEl) return 0;
      const text = weightEl.textContent.replace(/[^0-9.]/g, '');
      return parseFloat(text) || 0;
    }

    function applyFiltersAndSorting() {
      const urlParams = new URLSearchParams(window.location.search);
      let cat = urlParams.get('cat');
      const pathname = window.location.pathname.toLowerCase();
      const brand = urlParams.get('brand') || (localStorage.getItem('active_brand') || 'gold');

      if (!cat) {
        if (pathname.includes('ring')) cat = 'rings';
        else if (pathname.includes('chain') || pathname.includes('necklace')) cat = 'chains';
        else if (pathname.includes('mangalsutra')) cat = 'mangalsutras';
        else if (pathname.includes('pendant')) cat = 'pendants';
        else if (pathname.includes('bracelet') || pathname.includes('bangle') || pathname.includes('bracelate')) cat = 'bangles';
        else if (pathname.includes('earring')) cat = 'earrings';
      }

      // Title Update
      const pageTitle = document.querySelector('.collection-page-title');
      const catTitles = {
        'rings': (brand === 'silver') ? 'The Grand Mother Silver Rings Curation' : 'Heritage Gold Rings Collection',
        'chains': (brand === 'silver') ? 'The Grand Mother Silver Chains & Necklaces' : 'Heritage Gold Chains & Necklaces',
        'mangalsutras': (brand === 'silver') ? 'The Grand Mother Silver Mangalsutras' : 'Heritage Gold Mangalsutras Collection',
        'bangles': (brand === 'silver') ? 'The Grand Mother Silver Bracelets & Anklets' : 'Heritage Gold Bracelets & Bangles',
        'pendants': (brand === 'silver') ? 'The Grand Mother Silver Pendants' : 'Heritage Gold Pendants Collection',
        'earrings': (brand === 'silver') ? 'The Grand Mother Silver Earrings' : 'Heritage Gold Earrings Collection'
      };

      if (pageTitle && cat && catTitles[cat]) {
        pageTitle.textContent = catTitles[cat];
      }

      const gridContainer = document.getElementById('collectionProductGrid');
      if (!gridContainer) return;
      const gridCards = Array.from(gridContainer.querySelectorAll('.product-card, .product-card-wrapper'));
      if (!gridCards || gridCards.length === 0) return;

      // Active sidebar checkbox filters
      const checkedCats = Array.from(document.querySelectorAll('.cat-filter:checked')).map(cb => cb.value);
      const checkedPrices = Array.from(document.querySelectorAll('.price-filter:checked')).map(cb => cb.value);
      const checkedGenders = Array.from(document.querySelectorAll('.gender-filter:checked')).map(cb => cb.value);
      const checkedWeights = Array.from(document.querySelectorAll('.weight-filter:checked')).map(cb => cb.value);

      let visibleCount = 0;

      gridCards.forEach(card => {
        const titleText = card.textContent.toLowerCase();
        const priceVal = parsePrice(card);
        const weightVal = parseWeight(card);

        let matchesCategory = true;
        let matchesPrice = true;
        let matchesGender = true;
        let matchesWeight = true;

        // Category matching (from URL or checkbox)
        const targetCat = checkedCats.length > 0 ? checkedCats : (cat ? [cat] : []);
        if (targetCat.length > 0) {
          matchesCategory = targetCat.some(c => {
            if (c === 'rings' && (titleText.includes('ring') || titleText.includes('band'))) return true;
            if (c === 'chains' && (titleText.includes('chain') || titleText.includes('necklace') || titleText.includes('choker'))) return true;
            if (c === 'mangalsutras' && (titleText.includes('mangalsutra') || titleText.includes('pendant'))) return true;
            if (c === 'pendants' && titleText.includes('pendant')) return true;
            if (c === 'bangles' && (titleText.includes('bangle') || titleText.includes('bracelet') || titleText.includes('anklet') || titleText.includes('kada'))) return true;
            if (c === 'earrings' && (titleText.includes('earring') || titleText.includes('jhumka') || titleText.includes('stud') || titleText.includes('hoop'))) return true;
            return false;
          });
        }

        // Price range matching
        if (checkedPrices.length > 0) {
          matchesPrice = checkedPrices.some(p => {
            if (p === 'under-15k' && priceVal > 0 && priceVal < 15000) return true;
            if (p === '15k-50k' && priceVal >= 15000 && priceVal <= 50000) return true;
            if (p === '50k-150k' && priceVal > 50000 && priceVal <= 150000) return true;
            if (p === '150k-up' && priceVal > 150000) return true;
            return false;
          });
        }

        // Gender matching
        if (checkedGenders.length > 0) {
          matchesGender = checkedGenders.some(g => {
            if (g === 'men' && (titleText.includes("men's") || (titleText.includes('men') && !titleText.includes('women')))) return true;
            if (g === 'women' && (titleText.includes("women's") || titleText.includes('women') || titleText.includes('mangalsutra') || titleText.includes('jhumka'))) return true;
            if (g === 'unisex') return true;
            return false;
          });
        }

        // Weight matching
        if (checkedWeights.length > 0) {
          matchesWeight = checkedWeights.some(w => {
            if (w === 'under-5g' && weightVal > 0 && weightVal < 5) return true;
            if (w === '5g-15g' && weightVal >= 5 && weightVal <= 15) return true;
            if (w === '15g-up' && weightVal > 15) return true;
            return false;
          });
        }

        if (matchesCategory && matchesPrice && matchesGender && matchesWeight) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Update Piece Count
      const countSpan = document.querySelector('.product-count');
      if (countSpan) {
        countSpan.textContent = visibleCount + ' Exquisite Pieces Found';
      }

      // Sort cards
      const sortSelect = document.getElementById('sortBySelect');
      if (sortSelect) {
        const sortVal = sortSelect.value;
        if (sortVal === 'price-low') {
          gridCards.sort((a, b) => parsePrice(a) - parsePrice(b));
          gridCards.forEach(c => gridContainer.appendChild(c));
        } else if (sortVal === 'price-high') {
          gridCards.sort((a, b) => parsePrice(b) - parsePrice(a));
          gridCards.forEach(c => gridContainer.appendChild(c));
        }
      }
    }

    // Grid Switcher (2 Cols, 3 Cols, 4 Cols)
    function initGridSwitcher() {
      const gridContainer = document.getElementById('collectionProductGrid');
      const switcherBtns = document.querySelectorAll('.grid-switcher-btn');
      if (!gridContainer || !switcherBtns) return;

      switcherBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          switcherBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const cols = btn.dataset.columns;

          gridContainer.classList.remove('cols-2', 'cols-3', 'cols-4');
          gridContainer.classList.add(`cols-${cols}`);
        });
      });
    }

    // Bind event listeners
    function bindEvents() {
      const sortSelect = document.getElementById('sortBySelect');
      if (sortSelect) {
        sortSelect.addEventListener('change', applyFiltersAndSorting);
      }

      const checkboxes = document.querySelectorAll('.filter-checkbox');
      checkboxes.forEach(cb => {
        cb.addEventListener('change', applyFiltersAndSorting);
      });

      // Clear All Filters Handler
      const clearBtn = document.getElementById('clearFiltersBtn');
      if (clearBtn) {
        clearBtn.addEventListener('click', (e) => {
          e.preventDefault();
          checkboxes.forEach(cb => cb.checked = false);
          
          // Clear query param from URL state cleanly
          if (window.location.search.includes('cat=')) {
            const newUrl = new URL(window.location.href);
            newUrl.searchParams.delete('cat');
            window.history.pushState({}, '', newUrl.toString());
          }

          // Reset Title if needed
          const pageTitle = document.querySelector('.collection-page-title');
          const brand = (new URLSearchParams(window.location.search)).get('brand') || 'gold';
          if (pageTitle) {
            pageTitle.textContent = (brand === 'silver') ? 'The Grand Mother Silver Jewellery Curation' : 'Heritage Gold Jewellery Collection';
          }

          applyFiltersAndSorting();
        });
      }

      // Mobile filter drawer toggles
      const mobileBtn = document.getElementById('mobileFilterTriggerBtn');
      const mobileClose = document.getElementById('mobileFilterClose');
      const sidebar = document.getElementById('collectionSidebarFilters');
      const overlay = document.getElementById('mobileFilterOverlay');

      if (mobileBtn && sidebar && overlay) {
        mobileBtn.addEventListener('click', () => {
          sidebar.classList.add('active');
          overlay.classList.add('active');
        });
      }
      if (mobileClose && sidebar && overlay) {
        mobileClose.addEventListener('click', () => {
          sidebar.classList.remove('active');
          overlay.classList.remove('active');
        });
      }
      if (overlay && sidebar) {
        overlay.addEventListener('click', () => {
          sidebar.classList.remove('active');
          overlay.classList.remove('active');
        });
      }

      initGridSwitcher();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        applyFiltersAndSorting();
        bindEvents();
      });
    } else {
      applyFiltersAndSorting();
      bindEvents();
    }
  })();
</script>

