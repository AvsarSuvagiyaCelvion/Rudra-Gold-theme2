{% schema %}
{
  "name": "Main Collection Grid",
  "settings": []
}
{% endschema %}

<section class="main-collection-section section-padding">
  <!-- Mobile Filter Overlay Drawer -->
  <div class="mobile-filter-overlay" id="mobileFilterOverlay"></div>

  <div class="container">
    
    <!-- Top Filter & Sort Bar -->
    <div class="collection-top-bar">
      <div class="top-bar-left">
        <h2>Heritage Gold Jewellery</h2>
        <span class="product-count">12 Exquisite Pieces Found</span>
      </div>

      <div class="top-bar-right">
        <!-- Filter Button on Mobile -->
        <button class="mobile-filter-trigger-btn" id="mobileFilterTriggerBtn">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
          </svg>
          Filter
        </button>

        <!-- Sort By -->
        <div class="sort-wrapper">
          <label for="sortBySelect">Sort By:</label>
          <select id="sortBySelect" class="sort-select-dropdown">
            <option value="featured">Featured Curation</option>
            <option value="price-low">Price: Low to High</option>
            <option value="price-high">Price: High to Low</option>
            <option value="bestsellers">Bestselling</option>
          </select>
        </div>

        <!-- Column Layout Grid Switcher -->
        <div class="grid-switcher">
          <span class="switcher-label">View:</span>
          <button class="grid-switcher-btn" data-columns="2" aria-label="Show 2 columns">2 Cols</button>
          <button class="grid-switcher-btn active" data-columns="3" aria-label="Show 3 columns">3 Cols</button>
          <button class="grid-switcher-btn" data-columns="4" aria-label="Show 4 columns">4 Cols</button>
        </div>
      </div>
    </div>

    <div class="collection-main-layout">
      
      <!-- Left Sidebar: Filters -->
      <aside class="collection-sidebar-filters" id="collectionSidebarFilters">
        <div class="sidebar-header-mobile">
          <h3>Refine Curation</h3>
          <button class="sidebar-close-btn-mobile" id="mobileFilterClose" aria-label="Close filters">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <h3 class="filter-sidebar-title">Refine By</h3>

        <div class="filter-group">
          <h4>Metal Purity</h4>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox" value="22k" checked>
            <span>22K Gold (916)</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox" value="18k">
            <span>18K Gold (750)</span>
          </label>
        </div>

        <div class="filter-group">
          <h4>Price Range</h4>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox" value="0-50">
            <span>Under ₹50,000</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox" value="50-150">
            <span>₹50,000 - ₹1,50,000</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox" value="150-up" checked>
            <span>Over ₹1,50,000</span>
          </label>
        </div>

        <div class="filter-group">
          <h4>Product Type</h4>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox" value="rings">
            <span>Rings & Bands</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox" value="necklaces">
            <span>Necklaces & Chokers</span>
          </label>
          <label class="filter-checkbox-row">
            <input type="checkbox" class="filter-checkbox" value="bangles">
            <span>Bangles & Kada</span>
          </label>
        </div>
      </aside>

      <!-- Right Side: Product Grid -->
      <div class="collection-content-grid-wrapper">
        {%- paginate collection.products by 6 -%}
        <div class="collection-grid cols-3" id="collectionProductGrid">
          {%- if collection.products.size > 0 -%}
            {%- for product in collection.products -%}
              {%- render 'product-card', product: product -%}
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} Fallback mock items if no catalog products are set up yet {%- endcomment -%}
            {%- render 'product-card',
              title: "Mayur Heritage Temple Ring",
              price: 68000,
              image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80",
              hover_image: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80",
              purity: "22K Gold"
            -%}

            {%- render 'product-card',
              title: "Royal Peacock Gold Band",
              price: 49500,
              image: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=600&q=80",
              purity: "18K Gold"
            -%}

            {%- render 'product-card',
              title: "Rudra Royal Signature Necklace",
              price: 245000,
              image: "https://images.unsplash.com/photo-1599643438383-e18e821d3e80?auto=format&fit=crop&w=600&q=80",
              purity: "22K Gold"
            -%}

            {%- render 'product-card',
              title: "Nizami Pearl Heritage Choker",
              price: 380000,
              image: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80",
              purity: "22K Gold"
            -%}

            {%- render 'product-card',
              title: "Glow Silhouette Bangles Set",
              price: 165000,
              image: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=600&q=80",
              purity: "22K Gold"
            -%}

            {%- render 'product-card',
              title: "Classic Solitaire Tennis Bracelet",
              price: 450000,
              image: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80",
              purity: "18K Gold"
            -%}
          {%- endif -%}
        </div>

        <!-- Load More Trigger Button -->
        <div class="collection-load-more-wrapper">
          {%- if collection.products.size > 0 -%}
            {%- if paginate.next -%}
              <button class="btn-secondary" id="loadMoreBtn" data-next-url="{{ paginate.next.url }}" onclick="loadMoreProductsAJAX()">
                Discover More Pieces
              </button>
            {%- endif -%}
          {%- else -%}
            <button class="btn-secondary" id="loadMoreBtn" onclick="simulateLoadMore()">
              Discover More Pieces
            </button>
          {%- endif -%}
        </div>
        {%- endpaginate -%}
      </div>

    </div>

  </div>
</section>

<style>
.collection-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid var(--color-gray-border);
  padding-bottom: 20px;
  margin-bottom: 30px;
}

.top-bar-left h2 {
  font-family: var(--font-serif);
  font-size: 26px;
  color: var(--color-dark);
}

.product-count {
  font-size: 11px;
  color: var(--color-text-muted);
}

.top-bar-right {
  display: flex;
  align-items: center;
  gap: 30px;
}

.sort-wrapper {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
}

.sort-select-dropdown {
  border: 1px solid var(--color-gray-border);
  padding: 6px 12px;
  background-color: var(--color-light);
}

.grid-switcher {
  display: flex;
  align-items: center;
  gap: 6px;
}

.switcher-label {
  font-size: 12px;
}

.grid-switcher-btn {
  background-color: transparent;
  border: 1px solid var(--color-gray-border);
  padding: 4px 8px;
  font-size: 11px;
  font-weight: 500;
  cursor: pointer;
  transition: var(--transition-fast);
}

.grid-switcher-btn.active, .grid-switcher-btn:hover {
  background-color: var(--color-dark);
  color: var(--color-light);
  border-color: var(--color-dark);
}

/* Sidebar Grid layout */
.collection-main-layout {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: 40px;
}

.collection-sidebar-filters {
  align-self: flex-start;
}

.filter-sidebar-title {
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-dark);
  margin-bottom: 24px;
  border-bottom: 1.5px solid var(--color-gold);
  padding-bottom: 8px;
}

.filter-group {
  margin-bottom: 30px;
}

.filter-group h4 {
  font-family: var(--font-serif);
  font-size: 15px;
  margin-bottom: 12px;
  color: var(--color-dark);
}

.filter-checkbox-row {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 12px;
  margin-bottom: 8px;
  cursor: pointer;
}

.filter-checkbox-row input {
  accent-color: var(--color-gold);
}

/* Grids count */
.collection-grid {
  display: grid;
  gap: 30px;
}

.collection-grid.cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.collection-grid.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.collection-grid.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.collection-load-more-wrapper {
  text-align: center;
  margin-top: 50px;
}

.mobile-filter-trigger-btn {
  display: none;
}
.sidebar-header-mobile {
  display: none;
}
.mobile-filter-overlay {
  display: none;
}

@media (max-width: 991px) {
  .collection-main-layout {
    grid-template-columns: 1fr;
  }
  .collection-sidebar-filters {
    display: block !important;
    position: fixed;
    top: 0;
    left: -100%;
    width: 100%;
    max-width: 320px;
    height: 100%;
    background-color: var(--color-light);
    z-index: 1008;
    padding: 30px 24px;
    overflow-y: auto;
    box-shadow: 10px 0 30px rgba(0, 0, 0, 0.2);
    transition: left 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .collection-sidebar-filters.active {
    left: 0;
  }
  .sidebar-header-mobile {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    border-bottom: 1.5px solid var(--color-gold);
    padding-bottom: 12px;
  }
  .sidebar-header-mobile h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--color-dark);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .sidebar-close-btn-mobile {
    cursor: pointer;
    color: var(--color-dark);
    transition: var(--transition-fast);
  }
  .sidebar-close-btn-mobile:hover {
    color: var(--color-gold);
  }
  .filter-sidebar-title {
    display: none !important;
  }
  .mobile-filter-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-gray-border);
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-light);
    color: var(--color-dark);
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .mobile-filter-trigger-btn:hover {
    border-color: var(--color-gold);
    color: var(--color-gold);
  }
  .mobile-filter-overlay {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(11, 11, 11, 0.6);
    backdrop-filter: blur(3px);
    z-index: 1007;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.4s ease, visibility 0.4s;
  }
  .mobile-filter-overlay.active {
    visibility: visible;
    opacity: 1;
  }
  .grid-switcher {
    display: none; /* Hide grid layouts switcher on tablet */
  }
  .collection-grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
}

@media (max-width: 575px) {
  .collection-grid {
    grid-template-columns: 1fr !important;
  }
  .collection-top-bar {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }
  .top-bar-right {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .sort-wrapper {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }
  .sort-select-dropdown {
    flex: 1;
    max-width: 160px;
  }
}
</style>

<script>
// Real dynamic AJAX pagination for collection products
async function loadMoreProductsAJAX() {
  const btn = document.getElementById('loadMoreBtn');
  const grid = document.getElementById('collectionProductGrid');
  if (!btn || !grid) return;

  const nextUrl = btn.getAttribute('data-next-url');
  if (!nextUrl) return;

  btn.textContent = "Loading Curation...";
  btn.disabled = true;

  try {
    const res = await fetch(nextUrl);
    if (!res.ok) throw new Error("Failed to load products");
    const htmlText = await res.text();
    
    // Parse the retrieved document
    const parser = new DOMParser();
    const doc = parser.parseFromString(htmlText, 'text/html');
    
    // Select product cards from retrieved grid
    const newCards = doc.querySelectorAll('#collectionProductGrid .product-card');
    newCards.forEach(card => {
      grid.appendChild(card);
    });

    // Extract next URL from loaded button
    const nextBtn = doc.getElementById('loadMoreBtn');
    if (nextBtn && nextBtn.getAttribute('data-next-url')) {
      btn.setAttribute('data-next-url', nextBtn.getAttribute('data-next-url'));
      btn.textContent = "Discover More Pieces";
      btn.disabled = false;
    } else {
      btn.style.display = 'none'; // No more pages
    }

    // Re-trigger custom tilts and cursor bindings for newly appended items
    if (window.initCustomCursor) initCustomCursor();
  } catch (err) {
    console.error("Failed to load AJAX products, redirecting to page:", err);
    window.location.href = nextUrl;
  }
}

// Client-side fallback simulation avoiding raw server-side liquid in JS
function simulateLoadMore() {
  const grid = document.getElementById('collectionProductGrid');
  const btn = document.getElementById('loadMoreBtn');
  if (!grid || !btn) return;

  btn.textContent = "Loading Curation...";
  btn.disabled = true;

  setTimeout(() => {
    const newItemsHTML = `
      <div class="product-card tilt-card" data-purity="22k gold">
        <div class="product-card-img-wrapper">
          <div class="purity-badge">22K Gold</div>
          <button class="wishlist-btn" aria-label="Add to Wishlist">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
          <a href="#">
            <img src="https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=600&q=80" alt="Mayura Filigree Kada" class="product-card-img primary-img" loading="lazy">
            <img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=600&q=80" alt="Mayura Filigree Kada" class="product-card-img hover-img" loading="lazy">
          </a>
          <div class="product-card-actions">
            <span class="card-action-btn" onclick="addToCartAjax('Mayura Filigree Kada', 215000, 'https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=600&q=80', '22K Gold')">Quick Add</span>
            <span class="card-action-btn" onclick="triggerQuickView('Mayura Filigree Kada', 215000, 'https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=600&q=80')">Quick View</span>
          </div>
        </div>
        <div class="product-card-info">
          <h3 class="product-card-title"><a href="#">Mayura Filigree Kada</a></h3>
          <div class="product-card-rating">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </div>
          <div class="product-card-price">₹2,15,000</div>
        </div>
      </div>
      <div class="product-card tilt-card" data-purity="18k gold">
        <div class="product-card-img-wrapper">
          <div class="purity-badge">18K Gold</div>
          <button class="wishlist-btn" aria-label="Add to Wishlist">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </button>
          <a href="#">
            <img src="https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80" alt="Aura Solitaire Drop Necklace" class="product-card-img primary-img" loading="lazy">
            <img src="https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?auto=format&fit=crop&w=600&q=80" alt="Aura Solitaire Drop Necklace" class="product-card-img hover-img" loading="lazy">
          </a>
          <div class="product-card-actions">
            <span class="card-action-btn" onclick="addToCartAjax('Aura Solitaire Drop Necklace', 320000, 'https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80', '18K Gold')">Quick Add</span>
            <span class="card-action-btn" onclick="triggerQuickView('Aura Solitaire Drop Necklace', 320000, 'https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80')">Quick View</span>
          </div>
        </div>
        <div class="product-card-info">
          <h3 class="product-card-title"><a href="#">Aura Solitaire Drop Necklace</a></h3>
          <div class="product-card-rating">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          </div>
          <div class="product-card-price">₹3,20,000</div>
        </div>
      </div>
    `;
    grid.insertAdjacentHTML('beforeend', newItemsHTML);
    btn.style.display = 'none'; // Hide button after fallback simulation

    // Re-bind hover interactions for newly added items
    if (window.initCustomCursor) initCustomCursor();
  }, 1000);
}

// Mobile Filter Sidebar Toggle listeners
document.addEventListener('DOMContentLoaded', () => {
  const filterBtn = document.getElementById('mobileFilterTriggerBtn');
  const filterClose = document.getElementById('mobileFilterClose');
  const filterOverlay = document.getElementById('mobileFilterOverlay');
  const filterSidebar = document.getElementById('collectionSidebarFilters');

  if (filterBtn && filterSidebar) {
    const openFilters = () => {
      filterSidebar.classList.add('active');
      if (filterOverlay) filterOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    };
    
    const closeFilters = () => {
      filterSidebar.classList.remove('active');
      if (filterOverlay) filterOverlay.classList.remove('active');
      document.body.style.overflow = '';
    };

    filterBtn.addEventListener('click', openFilters);
    if (filterClose) filterClose.addEventListener('click', closeFilters);
    if (filterOverlay) filterOverlay.addEventListener('click', closeFilters);
  }
});
</script>
