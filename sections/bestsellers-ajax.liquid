{% schema %}
{
  "name": "Bestsellers Grid",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Gold Subtitle",
      "default": "CURATED EXQUISITE CREATIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Gold Section Title",
      "default": "Rudra Bestsellers"
    },
    {
      "type": "collection",
      "id": "gold_collection",
      "label": "Gold Bestsellers Collection (Select in Admin)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 4,
      "label": "Number of Products to Display on Homepage"
    },
    {
      "type": "text",
      "id": "silver_subtitle",
      "label": "Silver Subtitle",
      "default": "THE GRAND MOTHER • STERLING SILVER"
    },
    {
      "type": "text",
      "id": "silver_title",
      "label": "Silver Section Title",
      "default": "Silver Bestsellers"
    },
    {
      "type": "collection",
      "id": "silver_collection",
      "label": "Silver Bestsellers Collection (Select in Admin)"
    }
  ],
  "presets": [
    {
      "name": "Bestsellers Grid"
    }
  ]
}
{% endschema %}

<!-- BRAND GOLD BLOCK -->
<div class="brand-gold-only-block brand-gold-only" style="width: 100%;">
  <section class="bestsellers-ajax section-padding">
    <div class="container">
      
      <div class="section-header text-center">
        <span class="section-subtitle">{{ section.settings.subtitle }}</span>
        <h2 class="section-title">{{ section.settings.title }}</h2>
      </div>

      {%- assign gold_coll = section.settings.gold_collection | default: collections['bestsellers'] | default: collections['all'] -%}
      {%- assign product_limit = section.settings.products_to_show | default: 4 -%}

      <div class="product-grid bestsellers-product-grid">
        {%- if gold_coll != blank and gold_coll.products.size > 0 -%}
          {%- for product in gold_coll.products limit: product_limit -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- else -%}
          <!-- Premium Gold Fallbacks -->
          {% render 'product-card',
            title: "Mayur Heritage Temple Ring",
            price: 68000,
            image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80",
            purity: "22K Gold"
          %}
          {% render 'product-card',
            title: "Rudra Royal Signature Necklace",
            price: 245000,
            image: "https://images.unsplash.com/photo-1599643438383-e18e821d3e80?auto=format&fit=crop&w=600&q=80",
            purity: "22K Gold"
          %}
          {% render 'product-card',
            title: "Glow Silhouette Bangles Set",
            price: 165000,
            image: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=600&q=80",
            purity: "22K Gold"
          %}
          {% render 'product-card',
            title: "Imperial Diamond Solitaire Ring",
            price: 185000,
            image: "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=600&q=80",
            purity: "18K Gold"
          %}
        {%- endif -%}
      </div>

      <div class="bestsellers-cta-wrapper">
        <a href="/collections/all?sort_by=best-selling&brand=gold" class="btn-secondary bestsellers-cta-btn">
          Explore All Bestsellers
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

    </div>
  </section>
</div>

<!-- BRAND SILVER BLOCK -->
<div class="brand-silver-only-block brand-silver-only" style="width: 100%;">
  <section class="bestsellers-ajax section-padding">
    <div class="container">
      
      <div class="section-header text-center">
        <span class="section-subtitle" style="color: #C0C0C0;">{{ section.settings.silver_subtitle }}</span>
        <h2 class="section-title">{{ section.settings.silver_title }}</h2>
      </div>

      {%- assign silver_coll = section.settings.silver_collection | default: collections['silver-bestsellers'] | default: collections['all'] -%}

      <div class="product-grid bestsellers-product-grid">
        {%- if silver_coll != blank and silver_coll.products.size > 0 -%}
          {%- for product in silver_coll.products limit: product_limit -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        {%- else -%}
          <!-- Premium Silver Fallbacks -->
          {% render 'product-card',
            title: "Classic Silver Solitaire Ring",
            price: 8500,
            image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80",
            purity: "925 Silver"
          %}
          {% render 'product-card',
            title: "Contemporary Sterling Hoop Earrings",
            price: 4200,
            image: "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=600&q=80",
            purity: "925 Silver"
          %}
          {% render 'product-card',
            title: "Vintage Oxidized Silver Choker",
            price: 24000,
            image: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80",
            purity: "925 Silver"
          %}
          {% render 'product-card',
            title: "Silver Zirconia Tennis Bracelet",
            price: 18000,
            image: "https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=600&q=80",
            purity: "925 Silver"
          %}
        {%- endif -%}
      </div>

      <div class="bestsellers-cta-wrapper">
        <a href="/collections/all?sort_by=best-selling&brand=silver" class="btn-secondary bestsellers-cta-btn silver-cta-btn">
          Explore Silver Bestsellers
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

    </div>
  </section>
</div>

<style>
.section-header.text-center {
  text-align: center;
  margin-bottom: 40px;
}

.bestsellers-product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28px;
}

.bestsellers-cta-wrapper {
  text-align: center;
  margin-top: 48px;
}

.bestsellers-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 32px;
  border: 1px solid var(--color-gold);
  color: var(--color-gold);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.4s ease;
}

.bestsellers-cta-btn:hover {
  background: var(--color-gold);
  color: #000000;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(200, 161, 61, 0.3);
}

.silver-cta-btn {
  border-color: #C0C0C0;
  color: #C0C0C0;
}

.silver-cta-btn:hover {
  background: #C0C0C0;
  color: #000000;
  box-shadow: 0 8px 20px rgba(192, 192, 192, 0.3);
}

@media (max-width: 991px) {
  .bestsellers-product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

@media (max-width: 480px) {
  .bestsellers-product-grid {
    grid-template-columns: 1fr;
  }
}
</style>
