              hover_image: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=600&q=80",
              purity: "18K Gold"
            %}

            {% render 'product-card',
              title: "Mayura Filigree Kada",
              price: 215000,
              image: "https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=600&q=80",
              hover_image: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=600&q=80",
              purity: "22K Gold"
            %}

            {% render 'product-card',
              title: "Aura Solitaire Drop Necklace",
              price: 320000,
              image: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80",
              hover_image: "https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?auto=format&fit=crop&w=600&q=80",
              purity: "18K Gold"
            %}

          </div>
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<style>
.tabs-nav-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 40px;
  border-bottom: 1px solid var(--color-gray-border);
}

.tabs-nav {
  display: flex;
  gap: 40px;
}

.tab-btn {
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-text-muted);
  padding: 15px 0;
  position: relative;
  cursor: pointer;
  transition: var(--transition-fast);
}

.tab-btn::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--color-gold);
  transition: var(--transition-fast);
}

.tab-btn.active {
  color: var(--color-dark);
}

.tab-btn.active::after {
  width: 100%;
}

.tab-pane {
  display: none;
}

.tab-pane.active {
  display: block;
  animation: fadeIn 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 991px) {
  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .tabs-nav {
    gap: 20px;
  }
  .tab-btn {
    font-size: 11px;
  }
}

@media (max-width: 575px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
  .tabs-nav {
    width: 100%;
    overflow-x: auto;
    white-space: nowrap;
    padding-bottom: 5px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const tabs = document.querySelectorAll('.tab-btn');
  tabs.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tabTarget;
      
      // Remove active from navigation buttons
      tabs.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // Hide all tabs content
      document.querySelectorAll('.tab-pane').forEach(pane => {
        pane.classList.remove('active');
      });

      // Show targeted pane
      const activePane = document.getElementById(`tab-${target}`);
      if (activePane) {
        activePane.classList.add('active');
      }
    });
  });
});
</script>
