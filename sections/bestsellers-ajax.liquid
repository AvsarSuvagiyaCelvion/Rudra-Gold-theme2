      <div class="tabs-nav-wrapper">
        <div class="tabs-nav">
          <button class="tab-btn active" data-tab-target="gold-rings">Gold Rings</button>
          <button class="tab-btn" data-tab-target="gold-chains">Gold Chains</button>
          <button class="tab-btn" data-tab-target="gold-mangalsutras">Mangalsutras</button>
