            %}

          </div>
        </div>

        <!-- Tab 3: Solitaires -->
        <div class="tab-pane" id="tab-solitaires">
          <div class="product-grid">
            
            {% render 'product-card',
              title: "Glow Silhouette Bangles Set",
              price: 165000,
              image: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=600&q=80",
              hover_image: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=600&q=80",
              purity: "22K Gold"
            %}

            {% render 'product-card',
              title: "Classic Solitaire Tennis Bracelet",
