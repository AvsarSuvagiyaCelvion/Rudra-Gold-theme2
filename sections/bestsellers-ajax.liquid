              hover_image: "https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?auto=format&fit=crop&w=600&q=80",
              purity: "22K Gold"
            %}

            {% render 'product-card',
              title: "Vajra Sparkling Solitaire Drops",
              price: 290000,
