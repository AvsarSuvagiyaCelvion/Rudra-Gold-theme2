<style>


.tabs-nav-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 40px;
  border-bottom: 1px solid var(--color-gray-border);
}

.tabs-nav {
  display: flex;
  gap: 40px;
}

.tab-btn {
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-text-muted);
  padding: 15px 0;
  position: relative;
  cursor: pointer;
  transition: var(--transition-fast);
}

.tab-btn::after {
  content: '';
  position: absolute;
  bottom: -1px;
  left: 0;
  width: 0;
  height: 2px;
  background-color: var(--color-gold);
  transition: var(--transition-fast);
}

.tab-btn.active {
  color: var(--color-dark);
}

.tab-btn.active::after {
  width: 100%;
}

.tab-pane {
  display: none;
}

.tab-pane.active {
  display: block;
  animation: fadeIn 0.6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(15px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 991px) {
  .product-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .tabs-nav {
    gap: 20px;
  }
  .tab-btn {
    font-size: 11px;
  }
}

@media (max-width: 480px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 575px) {
  .tabs-nav {
    width: 100%;
    overflow-x: auto;
    white-space: nowrap;
    padding-bottom: 5px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const tabContainers = document.querySelectorAll('.brand-gold-only-block, .brand-silver-only-block');
  tabContainers.forEach(container => {
    const tabs = container.querySelectorAll('.tab-btn');
    const panes = container.querySelectorAll('.tab-pane');
    tabs.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tabTarget;
        
        // Remove active from navigation buttons inside this container only
        tabs.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Hide all tabs content inside this container only
        panes.forEach(pane => {
          pane.classList.remove('active');
        });

        // Show targeted pane
        const activePane = document.getElementById(`tab-${target}`);
        if (activePane) {
          activePane.classList.add('active');
        }
      });
    });
  });
});
</script>
