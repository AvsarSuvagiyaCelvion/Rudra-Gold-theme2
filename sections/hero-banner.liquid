{% schema %}
{
  "name": "Split Brand Hero",
  "settings": [
    {
      "type": "header",
      "content": "Rudra Gold Settings"
    },
    {
      "type": "image_picker",
      "id": "gold_image",
      "label": "Gold Background Image"
    },
    {
      "type": "text",
      "id": "gold_subtitle",
      "label": "Gold Subtitle",
      "default": "RUDRA GOLD • ROYAL HERITAGE"
    },
    {
      "type": "text",
      "id": "gold_title",
      "label": "Gold Title",
      "default": "Timeless Golden Purity"
    },
    {
      "type": "textarea",
      "id": "gold_desc",
      "label": "Gold Description",
      "default": "Exquisite hand-carved heritage temple jewellery and certified bridal gold masterworks."
    },
    {
      "type": "text",
      "id": "gold_btn_text",
      "label": "Gold Button Text",
      "default": "Shop Gold Curation"
    },
    {
      "type": "url",
      "id": "gold_link",
      "label": "Gold Button Link"
    },
    {
      "type": "header",
      "content": "The Grand Mother Settings"
    },
    {
      "type": "image_picker",
      "id": "silver_image",
      "label": "Silver Background Image"
    },
    {
      "type": "text",
      "id": "silver_subtitle",
      "label": "Silver Subtitle",
      "default": "THE GRAND MOTHER • STERLING SILVER"
    },
    {
      "type": "text",
      "id": "silver_title",
      "label": "Silver Title",
      "default": "Sleek Silver Elegance"
    },
    {
      "type": "textarea",
      "id": "silver_desc",
      "label": "Silver Description",
      "default": "Premium 925 sterling silver and anti-tarnish diamond essentials for modern daily luxury."
    },
    {
      "type": "text",
      "id": "silver_btn_text",
      "label": "Silver Button Text",
      "default": "Shop Silver Curation"
    },
    {
      "type": "url",
      "id": "silver_link",
      "label": "Silver Button Link"
    }
  ]
}
{% endschema %}
<section class="split-hero">
  <!-- Interactive Sparkle Canvas -->
  <canvas class="split-hero-canvas" id="splitSparkleCanvas"></canvas>

  <!-- The Grand Mother Full-width Hero -->
  <div class="hero-full pane-silver brand-silver-only" id="paneSilver">
    <div class="pane-bg-wrapper">
      {% if section.settings.silver_image != blank %}
        <img src="{{ section.settings.silver_image | image_url: width: 2000 }}" alt="The Grand Mother Silver Collection" class="pane-bg">
      {% else %}
        <div class="pane-bg default-silver-bg"></div>
      {% endif %}
      <div class="pane-overlay silver-overlay"></div>
    </div>

    <div class="container hero-content-container">
      <div class="pane-content">
        <span class="pane-subtitle">{{ section.settings.silver_subtitle }}</span>
        <h2 class="pane-title Cormorant">{{ section.settings.silver_title }}</h2>
        <p class="pane-description">{{ section.settings.silver_desc }}</p>
        <div class="pane-actions">
          <a href="{{ section.settings.silver_link | default: '/collections/all?brand=silver' }}" class="btn-primary silver-cta-btn">
            {{ section.settings.silver_btn_text }}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Rudra Gold Full-width Hero -->
  <div class="hero-full pane-gold brand-gold-only" id="paneGold">
    <div class="pane-bg-wrapper">
      {% if section.settings.gold_image != blank %}
        <img src="{{ section.settings.gold_image | image_url: width: 2000 }}" alt="Rudra Gold Luxury Collection" class="pane-bg">
      {% else %}
        <div class="pane-bg default-gold-bg"></div>
      {% endif %}
      <div class="pane-overlay gold-overlay"></div>
    </div>
    
    <div class="container hero-content-container">
      <div class="pane-content">
        <span class="pane-subtitle">{{ section.settings.gold_subtitle }}</span>
        <h2 class="pane-title Cormorant">{{ section.settings.gold_title }}</h2>
        <p class="pane-description">{{ section.settings.gold_desc }}</p>
        <div class="pane-actions">
          <a href="{{ section.settings.gold_link | default: '/collections/all?brand=gold' }}" class="btn-primary gold-cta-btn">
            {{ section.settings.gold_btn_text }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.split-hero {
  display: flex;
  height: 100vh;
  min-height: 650px;
  overflow: hidden;
  position: relative;
  background-color: var(--color-dark);
  z-index: 1;
}

.split-hero-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  pointer-events: none;
}

.hero-full {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
  padding: 60px;
  box-sizing: border-box;
}

.hero-content-container {
  display: flex;
  justify-content: flex-start;
  width: 100%;
}

.pane-bg-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -2;
}

.pane-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  animation: heroBgZoom 20s infinite alternate ease-in-out;
}

.pane-bg.default-gold-bg {
  background: linear-gradient(rgba(11, 11, 11, 0.45), rgba(11, 11, 11, 0.75)), url('https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat;
  animation: heroBgZoom 20s infinite alternate ease-in-out;
}

.pane-bg.default-silver-bg {
  background: linear-gradient(rgba(11, 11, 11, 0.45), rgba(11, 11, 11, 0.75)), url('https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat;
  animation: heroBgZoom 20s infinite alternate ease-in-out;
}

.pane-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

.gold-overlay {
  background: linear-gradient(to right, rgba(11, 11, 11, 0.75), rgba(11, 11, 11, 0.35));
}

.silver-overlay {
  background: linear-gradient(to right, rgba(11, 11, 11, 0.75), rgba(11, 11, 11, 0.35));
}

.pane-content {
  max-width: 620px;
  color: var(--color-light);
  text-align: left;
  z-index: 5;
}

.pane-subtitle {
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.25em;
  display: inline-block;
  margin-bottom: 18px;
  animation: heroFadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s backwards;
  text-transform: uppercase;
}

.pane-gold .pane-subtitle {
  color: #C8A13D;
  text-shadow: 0 0 15px rgba(200, 161, 61, 0.4);
}

.pane-silver .pane-subtitle {
  color: #E0E0E0;
  text-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
}

.pane-title {
  font-size: clamp(36px, 5.5vw, 62px);
  line-height: 1.15;
  margin-bottom: 24px;
  font-weight: 400;
  animation: heroFadeInUp 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s backwards;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
}

.pane-description {
  font-size: 16px;
  font-weight: 300;
  line-height: 1.8;
  margin-bottom: 38px;
  color: rgba(255, 255, 255, 0.9);
  animation: heroFadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.6s backwards;
}

.pane-actions {
  display: flex;
  justify-content: flex-start;
  animation: heroFadeInUp 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.8s backwards;
}

.gold-cta-btn {
  border-color: #C8A13D !important;
  box-shadow: 0 6px 20px rgba(200, 161, 61, 0.25);
  transition: all 0.4s ease !important;
}
.gold-cta-btn:hover {
  background-color: #C8A13D !important;
  color: var(--color-dark) !important;
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 10px 30px rgba(200, 161, 61, 0.45);
}

.silver-cta-btn {
  border-color: #C0C0C0 !important;
  box-shadow: 0 6px 20px rgba(192, 192, 192, 0.25);
  transition: all 0.4s ease !important;
}
.silver-cta-btn:hover {
  background-color: #C0C0C0 !important;
  color: var(--color-dark) !important;
  transform: translateY(-3px) scale(1.03);
  box-shadow: 0 10px 30px rgba(255, 255, 255, 0.45);
}

@keyframes heroFadeInUp {
  0% {
    opacity: 0;
    transform: translateY(35px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes heroBgZoom {
  0% {
    transform: scale(1);
  }
  100% {
    transform: scale(1.07);
  }
}

/* Mobile Responsiveness */
@media (max-width: 991px) {
  .hero-full {
    padding: 30px;
  }
  .pane-title {
    font-size: clamp(24px, 7vw, 34px);
    margin-bottom: 16px;
  }
  .pane-description {
    font-size: 14px;
    margin-bottom: 24px;
  }
}

@media (max-width: 768px) {
  .split-hero {
    height: auto;
    min-height: 440px;
    position: relative;
    padding: 0;
  }
  .hero-full {
    height: auto;
    min-height: 440px;
    width: 100%;
    box-sizing: border-box;
    padding: 50px 20px 50px 20px;
    display: flex;
    align-items: center;
  }
  .pane-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
  }
  .pane-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-content-container {
    margin-top: 0;
  }
  .pane-content {
    margin-top: 0;
  }
  .pane-subtitle {
    font-size: 11px;
    margin-bottom: 10px;
    letter-spacing: 0.18em;
  }
  .pane-title {
    font-size: 28px;
    margin-bottom: 12px;
    line-height: 1.25;
  }
  .pane-description {
    font-size: 13px;
    margin-bottom: 20px;
    line-height: 1.55;
  }
  .gold-cta-btn, .silver-cta-btn {
    padding: 12px 24px;
    font-size: 11px;
  }
}

@media (max-width: 575px) {
  .hero-full {
    padding: 16px;
  }
}
</style>

<script>
function switchBrandLocal(brand) {
  if (window.switchBrand) {
    window.switchBrand(brand);
  }
}

// Particle/Sparkles Canvas script for luxury feel
document.addEventListener('DOMContentLoaded', () => {
  const canvas = document.getElementById('splitSparkleCanvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  
  let width = canvas.width = canvas.offsetWidth;
  let height = canvas.height = canvas.offsetHeight;
  
  window.addEventListener('resize', () => {
    width = canvas.width = canvas.offsetWidth;
    height = canvas.height = canvas.offsetHeight;
  });

  const particles = [];
  const maxParticles = 60;
  let hoverBrand = 'none';

  // Listen to pane hover states to determine sparkle color
  const paneGold = document.getElementById('paneGold');
  const paneSilver = document.getElementById('paneSilver');
  
  if (paneGold && paneSilver) {
    paneGold.addEventListener('mouseenter', () => hoverBrand = 'gold');
    paneGold.addEventListener('mouseleave', () => hoverBrand = 'none');
    paneSilver.addEventListener('mouseenter', () => hoverBrand = 'silver');
    paneSilver.addEventListener('mouseleave', () => hoverBrand = 'none');
  }

  class Particle {
    constructor() {
      this.x = Math.random() * width;
      this.y = Math.random() * height;
      this.size = Math.random() * 2.5 + 0.5;
      this.speedX = Math.random() * 0.4 - 0.2;
      this.speedY = Math.random() * -0.6 - 0.2;
      this.alpha = Math.random() * 0.5 + 0.1;
      this.fadeSpeed = Math.random() * 0.005 + 0.002;
      this.color = '#C8A13D'; // Default gold
    }

    update() {
      this.x += this.speedX;
      this.y += this.speedY;
      this.alpha -= this.fadeSpeed;

      // Color based on active hover or pane location
      if (this.x < width / 2) {
        this.color = hoverBrand === 'silver' ? '#C0C0C0' : '#C8A13D';
      } else {
        this.color = hoverBrand === 'gold' ? '#C8A13D' : '#C0C0C0';
      }

      if (this.alpha <= 0 || this.y < 0) {
        this.x = Math.random() * width;
        this.y = height + 10;
        this.alpha = Math.random() * 0.6 + 0.2;
        this.size = Math.random() * 2.5 + 0.5;
      }
    }

    draw() {
      ctx.save();
      ctx.globalAlpha = this.alpha;
      ctx.fillStyle = this.color;
      ctx.shadowBlur = 8;
      ctx.shadowColor = this.color;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
  }

  for (let i = 0; i < maxParticles; i++) {
    particles.push(new Particle());
  }

  function animate() {
    ctx.clearRect(0, 0, width, height);
    particles.forEach(p => {
      p.update();
      p.draw();
    });
    requestAnimationFrame(animate);
  }

  animate();
});
</script>
