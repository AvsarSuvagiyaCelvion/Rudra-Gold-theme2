{% schema %}
{
  "name": "Luxury Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Hero Subtitle",
      "default": "ESTD 1918 • ROYAL HERITAGE"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Title Line 1",
      "default": "Timeless Purity,"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "Title Line 2",
      "default": "Crafted for Royalty"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Hero Description",
      "default": "Indulge in our exquisite collection of hand-carved temple jewellery and certified solitaires, designed for luxury connoisseurs."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link",
      "default": "/collections"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "Book Store Curation"
    }
  ]
}
{% endschema %}

<section class="hero-banner">
  <!-- Parallax Background Image -->
  <div class="hero-parallax-bg-wrapper">
    {% if section.settings.background_image != blank %}
      <img src="{{ section.settings.background_image | image_url: width: 1920 }}" alt="Rudra Gold Luxury Collection" class="hero-parallax-bg">
    {% else %}
      <!-- Premium dark aesthetic luxury fallback background -->
      <div class="hero-parallax-bg default-bg"></div>
    {% endif %}
  </div>

  <!-- Subtle golden overlay gradient -->
  <div class="hero-overlay"></div>

  <!-- Interactive gold sparkles canvas -->
  <canvas class="hero-sparkles-canvas" id="sparkleCanvas"></canvas>

  <!-- Hero Content -->
  <div class="container hero-container-inner">
    <div class="hero-content">
      <span class="hero-subtitle">{{ section.settings.subtitle }}</span>
      
      <h2 class="hero-title">
        <span class="hero-title-line">{{ section.settings.title_line1 }}</span>
        <span class="hero-title-line gold-gradient-text">{{ section.settings.title_line2 }}</span>
      </h2>

      <p class="hero-description">{{ section.settings.description }}</p>

      <div class="hero-actions">
        <a href="{{ section.settings.primary_btn_link }}" class="btn-primary">
          {{ section.settings.primary_btn_text }}
        </a>
        <button class="btn-secondary text-white-btn" data-modal-type="vip-visit">
          {{ section.settings.secondary_btn_text }}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
.hero-banner {
  height: 100vh;
  min-height: 700px;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  z-index: 1;
  background-color: var(--color-dark);
}

.hero-parallax-bg-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 120%; /* Extra height to accommodate GSAP scroll parallax */
  z-index: -3;
}

.hero-parallax-bg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: translateY(0);
}

.hero-parallax-bg.default-bg {
  background-image: linear-gradient(rgba(11, 11, 11, 0.4), rgba(11, 11, 11, 0.75)), url('https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?auto=format&fit=crop&w=1920&q=80');
  background-size: cover;
  background-position: center;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(11, 11, 11, 0.5) 0%,
    rgba(11, 11, 11, 0.1) 40%,
    rgba(11, 11, 11, 0.75) 100%
  );
  z-index: -2;
  pointer-events: none;
}

.hero-sparkles-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  pointer-events: none;
}

.hero-container-inner {
  position: relative;
  z-index: 2;
  width: 100%;
}

.hero-content {
  max-width: 680px;
  color: var(--color-light);
  display: flex;
  flex-direction: column;
}

.hero-subtitle {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.3em;
  color: var(--color-gold);
  margin-bottom: 24px;
  text-transform: uppercase;
}

.hero-title {
  font-size: 58px;
  line-height: 1.15;
  margin-bottom: 24px;
  font-weight: 500;
}

.hero-title-line {
  display: block;
}

.hero-description {
  font-size: 15px;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 40px;
  line-height: 1.65;
  letter-spacing: 0.02em;
}

.hero-actions {
  display: flex;
  gap: 20px;
  align-items: center;
}

.text-white-btn {
  color: var(--color-light) !important;
  border-color: var(--color-light) !important;
}

.text-white-btn:hover {
  background-color: var(--color-light) !important;
  color: var(--color-dark) !important;
}

@media (max-width: 768px) {
  .hero-title {
    font-size: 42px;
  }
  .hero-description {
    font-size: 13px;
    margin-bottom: 30px;
  }
  .hero-actions {
    flex-direction: column;
    align-items: stretch;
    gap: 15px;
  }
}
</style>
