{% schema %}
{
  "name": "Contact Page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get In Touch" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "We'd love to hear from you" },
    { "type": "text", "id": "address", "label": "Address", "default": "340, First Floor, Varsha Society, Matavadi, Varachha, Surat - 395006" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+91 74055 44338" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@rudragold.com" },
    { "type": "text", "id": "hours", "label": "Store Hours", "default": "Mon – Sat: 10:00 AM – 8:00 PM" }
  ]
}
{% endschema %}

{%- assign selected_brand = 'gold' -%}
{%- if request.query_string contains 'brand=silver' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif request.query_string contains 'brand=gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif request.path contains 'silver' or request.path contains 'grand-mother' or request.path contains 'tgm' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif request.path contains 'gold' or request.path contains 'rudra-gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif product != blank -%}
  {%- assign product_tags_down = product.tags | join: ',' | downcase -%}
  {%- if product_tags_down contains 'silver' or product_tags_down contains 'grand mother' or product_tags_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- elsif collection != blank -%}
  {%- assign collection_handle_down = collection.handle | downcase -%}
  {%- if collection_handle_down contains 'silver' or collection_handle_down contains 'grand-mother' or collection_handle_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- endif -%}

{%- assign display_phone = section.settings.phone -%}
{%- assign display_whatsapp = section.settings.phone | remove: ' ' | remove: '+' -%}

{%- if selected_brand == 'silver' -%}
  {%- assign display_phone = '+91 88494 86223' -%}
  {%- if settings.whatsapp_silver_number != blank -%}
    {%- assign display_phone = settings.whatsapp_silver_number -%}
  {%- endif -%}
  {%- assign display_whatsapp = settings.whatsapp_silver_number | default: '918849486223' -%}
{%- else -%}
  {%- if settings.whatsapp_gold_number != blank -%}
    {%- assign display_phone = settings.whatsapp_gold_number -%}
    {%- assign display_whatsapp = settings.whatsapp_gold_number -%}
  {%- endif -%}
{%- endif -%}

<section class="contact-page section-padding">
  <div class="container">

    <!-- Header -->
    <div class="section-header">
      <p class="section-subtitle">{{ section.settings.subheading }}</p>
      <h1 class="section-title">{{ section.settings.heading }}</h1>
    </div>

    <div class="contact-layout">

      <!-- Info Panel -->
      <div class="contact-info-panel">

        <div class="contact-info-item">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <h4>Our Boutique</h4>
            <p>{{ section.settings.address }}</p>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            {%- assign msg = settings.whatsapp_gold_message | default: 'Hello Rudra Gold, I would like to inquire about your gold jewellery.' | url_encode -%}
            {%- if selected_brand == 'silver' -%}
              {%- assign msg = settings.whatsapp_silver_message | default: 'Hello The Grand Mother, I would like to inquire about your 925 sterling silver jewellery.' | url_encode -%}
            {%- endif -%}
            <p><a href="https://wa.me/{{ display_whatsapp }}?text={{ msg }}" data-contact-phone-link>{{ display_phone }}</a></p>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div>
            <h4>Email Us</h4>
            <p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
          </div>
        </div>

        <div class="contact-info-item">
          <div class="contact-info-icon">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div>
            <h4>Store Hours</h4>
            <p>{{ section.settings.hours }}</p>
          </div>
        </div>

      </div>

      <!-- Contact Form -->
      <div class="contact-form-panel">
        {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="contact-success">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <p>Thank you! We'll get back to you shortly.</p>
            </div>
          {% endif %}

          <div class="contact-form-row">
            <div class="contact-field">
              <label for="ContactFormName">Full Name</label>
              <input type="text" id="ContactFormName" name="contact[name]" value="{{ form.name }}" placeholder="Your full name" required>
            </div>
            <div class="contact-field">
              <label for="ContactFormEmail">Email Address</label>
              <input type="email" id="ContactFormEmail" name="contact[email]" value="{{ form.email }}" placeholder="your@email.com" required>
            </div>
          </div>

          <div class="contact-field">
            <label for="ContactFormPhone">Phone Number</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" placeholder="+91 00000 00000">
          </div>

          <div class="contact-field">
            <label for="ContactFormSubject">Subject</label>
            <select id="ContactFormSubject" name="contact[subject]">
              <option value="">Select a topic</option>
              <option value="Product Enquiry">Product Enquiry</option>
              <option value="Custom Order">Custom Order</option>
              <option value="VIP Store Visit">VIP Store Visit</option>
              <option value="After Sales Service">After Sales Service</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="contact-field">
            <label for="ContactFormMessage">Message</label>
            <textarea id="ContactFormMessage" name="contact[body]" rows="5" placeholder="Tell us how we can help you...">{{ form.body }}</textarea>
          </div>

          <button type="submit" class="btn-primary contact-submit-btn">Send Message</button>
        {% endform %}
      </div>

    </div>
  </div>
</section>

<style>
.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1.6fr;
  gap: 60px;
  align-items: start;
}

.contact-info-panel {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.contact-info-item {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.contact-info-icon {
  width: 44px;
  height: 44px;
  border: 1px solid var(--color-gold);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-gold);
  flex-shrink: 0;
}

.contact-info-item h4 {
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--color-gold);
  margin-bottom: 4px;
}

.contact-info-item p,
.contact-info-item a {
  font-size: 13px;
  color: var(--color-text-muted);
  line-height: 1.6;
}

.contact-info-item a:hover {
  color: var(--color-gold);
}

/* Form */
.contact-form-panel {
  background-color: var(--color-cream);
  border: 1px solid var(--color-gray-border);
  padding: 40px;
}

.contact-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.contact-field {
  display: flex;
  flex-direction: column;
  margin-bottom: 20px;
}

.contact-field label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-dark);
  margin-bottom: 8px;
}

.contact-field input,
.contact-field select,
.contact-field textarea {
  border: 1px solid var(--color-gray-border);
  padding: 12px 14px;
  font-size: 13px;
  color: var(--color-dark);
  background-color: var(--color-light);
  transition: border-color 0.2s ease;
  font-family: var(--font-sans);
}

.contact-field input:focus,
.contact-field select:focus,
.contact-field textarea:focus {
  border-color: var(--color-gold);
  outline: none;
}

.contact-field textarea {
  resize: vertical;
}

.contact-submit-btn {
  width: 100%;
  margin-top: 4px;
}

.contact-success {
  display: flex;
  align-items: center;
  gap: 12px;
  background-color: rgba(212, 175, 55, 0.08);
  border: 1px solid var(--color-gold);
  padding: 16px 20px;
  margin-bottom: 24px;
  color: var(--color-dark);
  font-size: 13px;
}

.contact-success svg {
  color: var(--color-gold);
  flex-shrink: 0;
}

@media (max-width: 991px) {
  .contact-layout {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .contact-info-panel {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 24px;
  }
  .contact-info-item {
    flex: 1 1 calc(50% - 12px);
  }
}

@media (max-width: 575px) {
  .contact-form-panel {
    padding: 24px;
  }
  .contact-form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .contact-info-item {
    flex: 1 1 100%;
  }
}
</style>
