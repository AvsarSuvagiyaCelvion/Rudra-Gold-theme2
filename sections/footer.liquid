{% schema %}
{
  "name": "Luxury Footer",
  "settings": [
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "© 2026 RUDRA GOLD. All Rights Reserved."
    }
  ]
}
{% endschema %}

{%- assign selected_brand = 'gold' -%}
{%- if request.query_string contains 'brand=silver' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif request.query_string contains 'brand=gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif request.path contains 'silver' or request.path contains 'grand-mother' or request.path contains 'tgm' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif request.path contains 'gold' or request.path contains 'rudra-gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif product != blank -%}
  {%- assign product_tags_down = product.tags | join: ',' | downcase -%}
  {%- if product_tags_down contains 'silver' or product_tags_down contains 'grand mother' or product_tags_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- elsif collection != blank -%}
  {%- assign collection_handle_down = collection.handle | downcase -%}
  {%- if collection_handle_down contains 'silver' or collection_handle_down contains 'grand-mother' or collection_handle_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- endif -%}

<footer class="site-footer">
  <div class="container footer-top-padding">
    <div class="footer-grid">
      
      <!-- Brand Profile column -->
      <div class="footer-col brand-col">
        <!-- Gold Version -->
        <div class="brand-gold-only">
          <h2 class="footer-logo">RUDRA GOLD</h2>
          <p class="footer-tagline">"Timeless Purity, Crafted for Royalty"</p>
          <p class="footer-about">Crafting legacy bridal jewellery and conflict-free solitaire diamonds. A century-long trust built on metal melt purity and hallmark transparency.</p>
        </div>
        <!-- Silver Version -->
        <div class="brand-silver-only">
          <h2 class="footer-logo" style="color: #C0C0C0;">THE GRAND MOTHER</h2>
          <p class="footer-tagline">"Sleek Elegance, Silver & Diamond"</p>
          <p class="footer-about">Premium 925 sterling silver and anti-tarnish diamond essentials for modern daily luxury. Curated collections certified for purity and longevity.</p>
        </div>
        
        <!-- Address & Contact Info -->
        <div class="footer-contact-info" style="margin-bottom: 20px; font-size: 12px; color: rgba(255,255,255,0.7); line-height: 1.6;">
          <p style="margin-bottom: 6px;">
            <strong>Office:</strong> 340, First Floor, Varsha Society, Matavadi, Varachha, Surat - 395006
          </p>
          <p>
            <strong>Phone/WhatsApp:</strong> 
            {%- if selected_brand == 'silver' -%}
              {%- assign num = settings.whatsapp_silver_number | default: '918849486223' -%}
              {%- assign msg = settings.whatsapp_silver_message | default: 'Hello The Grand Mother, I would like to inquire about your 925 sterling silver jewellery.' | url_encode -%}
              {%- assign display_phone = '+91 88494 86223' -%}
              {%- if settings.whatsapp_silver_number != blank -%}
                {%- assign display_phone = settings.whatsapp_silver_number -%}
              {%- endif -%}
              <a href="https://wa.me/{{ num }}?text={{ msg }}" data-contact-phone-link style="color: #C0C0C0;">{{ display_phone }}</a>
            {%- else -%}
              {%- assign num = settings.whatsapp_gold_number | default: '917405544338' -%}
              {%- assign msg = settings.whatsapp_gold_message | default: 'Hello Rudra Gold, I would like to inquire about your gold jewellery.' | url_encode -%}
              {%- assign display_phone = '+91 74055 44338' -%}
              {%- if settings.whatsapp_gold_number != blank -%}
                {%- assign display_phone = settings.whatsapp_gold_number -%}
              {%- endif -%}
              <a href="https://wa.me/{{ num }}?text={{ msg }}" data-contact-phone-link style="color: var(--color-gold);">{{ display_phone }}</a>
            {%- endif -%}
          </p>
        </div>
        
        <!-- Store Locator Link -->
        <a href="/pages/store-locator" class="store-locator-cta">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          Locate Flagship Boutique
        </a>
      </div>

      <!-- Quick Links column -->
      <div class="footer-col">
        <h3>Our Collections</h3>
        <!-- Gold Version -->
        <ul class="brand-gold-only">
          <li><a href="/collections/bridal">Bridal Heritage</a></li>
          <li><a href="/collections/temple">Temple Gold Collection</a></li>
          <li><a href="/collections/daily-wear">Daily Wear Essentials</a></li>
          <li><a href="/collections/solitaires">Solitaire Diamonds</a></li>
          <li><a href="/collections/bangles">Bangles & Kadas</a></li>
        </ul>
        <!-- Silver Version -->
        <ul class="brand-silver-only">
          <li><a href="/collections/sterling-silver">Contemporary Sterling</a></li>
          <li><a href="/collections/oxidized-silver">Oxidized Heritage</a></li>
          <li><a href="/collections/silver-crystal">Silver Zirconia</a></li>
          <li><a href="/collections/gifts-silver">Luxury Gifting</a></li>
          <li><a href="/collections/silver-rings">Silver Rings</a></li>
        </ul>
      </div>

      <!-- Customer Care column -->
      <div class="footer-col">
        <h3>Customer Concierge</h3>
        <ul>
          <li><a href="#" data-modal-type="vip-visit">Book Store Curation</a></li>
          <li><a href="#" data-modal-type="vip-visit">VIP Home Trial Curation</a></li>
          <li><a href="#" data-modal-type="hallmark">BIS Hallmark Transparency</a></li>
          <li><a href="/pages/gold-rate-tracker">Live Gold Rates Tracker</a></li>
          <li><a href="/pages/faq">Lifetime Exchange Policies</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        </ul>
      </div>

      <!-- Trust Certifications column -->
      <div class="footer-col certs-col">
        <h3>Certifications</h3>
        <div class="certifications-logos">
          
          <div class="cert-item" data-modal-type="hallmark">
            <span class="cert-icon">916</span>
            <div class="cert-lbl">
              <h4>BIS Hallmark</h4>
              <span>Melt Transparency</span>
            </div>
          </div>

          <div class="cert-item" data-modal-type="hallmark">
            <span class="cert-icon">IGI</span>
            <div class="cert-lbl">
              <h4>IGI certified</h4>
              <span>100% Conflict-free</span>
            </div>
          </div>

          <div class="cert-item" data-modal-type="hallmark">
            <span class="cert-icon">GIA</span>
            <div class="cert-lbl">
              <h4>GIA Certified</h4>
              <span>Rare Solitaires</span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      
      

      <!-- Copyright -->
      <div class="footer-copyright">
        <span class="brand-gold-only">{{ section.settings.copyright_text }}</span>
        <span class="brand-silver-only">© 2026 THE GRAND MOTHER. All Rights Reserved.</span>
      </div>

     

    </div>
  </div>
</footer>

<style>
.site-footer {
  background-color: var(--color-dark);
  color: var(--color-light);
  border-top: 1px solid rgba(212, 175, 55, 0.2);
}

.footer-top-padding {
  padding: 80px 10px 50px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
  gap: 40px;
}

.brand-col h2 {
  font-family: var(--font-serif);
  font-size: 28px;
  letter-spacing: 0.1em;
  color: var(--color-gold);
  margin-bottom: 5px;
}

.footer-tagline {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-gold-glow);
  margin-bottom: 20px;
}

.footer-about {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
  margin-bottom: 24px;
}

.store-locator-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid var(--color-gold);
  color: var(--color-gold);
  padding: 10px 18px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border-radius: 2px;
  transition: var(--transition-fast);
}

.store-locator-cta:hover {
  background-color: var(--color-gold);
  color: var(--color-dark);
}

.footer-col h3 {
  font-family: var(--font-serif);
  font-size: 16px;
  font-weight: 600;
  color: var(--color-gold);
  margin-bottom: 24px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.footer-col ul {
  list-style: none;
}

.footer-col ul li {
  margin-bottom: 12px;
}

.footer-col ul li a {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.6);
  transition: var(--transition-fast);
}

.footer-col ul li a:hover {
  color: var(--color-gold);
  padding-left: 3px;
}

/* Certifications Column */
.certifications-logos {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.cert-item {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
}

.cert-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid var(--color-gold);
  color: var(--color-gold);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 700;
  background-color: rgba(255, 255, 255, 0.03);
}

.cert-lbl h4 {
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 600;
  color: var(--color-light);
  line-height: 1.2;
}

.cert-lbl span {
  font-size: 9px;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Bottom Footer Styling */
.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  padding: 30px 0;
  font-size: 11px;
  color: rgba(255, 255, 255, 0.4);
}

.footer-bottom-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.footer-selectors {
  display: flex;
  gap: 15px;
}

.selector-btn {
  background-color: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.7);
  padding: 8px 16px;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.footer-payments {
  display: flex;
  gap: 10px;
}

.payment-icon {
  opacity: 0.5;
  color: var(--color-light);
}

@media (max-width: 991px) {
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }
}

@media (max-width: 768px) {
  .site-footer {
    text-align: center !important;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center !important;
  }
  .footer-col h3,
  .footer-col ul,
  .footer-col ul li,
  .footer-col ul li a,
  .brand-col h2,
  .footer-tagline,
  .footer-about {
    text-align: center !important;
  }
  .footer-col ul {
    width: 100%;
    padding: 0;
  }
  .footer-col ul li a:hover {
    padding-left: 0;
  }
  
  /* Center the block of contact info, but keep text left-aligned inside it for clean vertical alignment */
  .footer-contact-info {
    text-align: left !important;
    width: fit-content !important;
    margin: 0 auto 20px !important;
  }
  .footer-contact-info p {
    text-align: left !important;
    margin-left:15px;
  }
  
  /* Center the certifications block, but left-align the list items internally so icons align vertically */
  .certifications-logos {
    display: flex;
    flex-direction: column;
    align-items: flex-start !important;
    width: fit-content !important;
    margin: 0 auto !important;
  }
  .cert-item {
    text-align: left !important;
    justify-content: flex-start !important;
    width: 100%;
  }
  
  .footer-bottom-container {
    flex-direction: column;
    gap: 20px;
    text-align: center;
  }
  .footer-selectors {
    justify-content: center;
  }
  .footer-payments {
    justify-content: center;
  }
  .store-locator-cta {
    justify-content: center;
    width: 100%;
    max-width: 280px;
  }
}

@media (max-width: 575px) {
  .footer-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}
</style>
