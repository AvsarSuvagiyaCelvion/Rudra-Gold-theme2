{% schema %}
{
  "name": "Curated Collections",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "ROYAL HERITAGE SELECTIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Collection"
    }
  ]
}
{% endschema %}

<section class="curated-collections section-padding">
  <div class="container">
    
    <!-- Gold Version -->
    <div class="brand-gold-only" style="width: 100%;">
      <div class="section-header">
        <span class="section-subtitle">{{ section.settings.subtitle }}</span>
        <h2 class="section-title">{{ section.settings.title }}</h2>
      </div>

      <div class="collections-grid">
        <!-- Card 1: Bridal (Large/Hero block) -->
        <a href="/collections/bridal" class="collection-item large-item">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80" alt="Bridal Heritage" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag">Exquisite Craft</span>
            <h3>Bridal Heritage</h3>
            <span class="collection-cta">Discover Royalty</span>
          </div>
        </a>

        <!-- Card 2: Temple Gold -->
        <a href="/collections/temple" class="collection-item">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=500&q=80" alt="Temple Gold" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag">Traditional</span>
            <h3>Temple Gold</h3>
            <span class="collection-cta">View Pieces</span>
          </div>
        </a>

        <!-- Card 3: Solitaire Diamonds -->
        <a href="/collections/solitaires" class="collection-item">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=500&q=80" alt="Solitaires" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag">Brilliance</span>
            <h3>Solitaire Diamonds</h3>
            <span class="collection-cta">Explore Rare</span>
          </div>
        </a>

        <!-- Card 4: Daily Wear Essentials -->
        <a href="/collections/daily-wear" class="collection-item">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=500&q=80" alt="Daily Wear" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag">Modern Elegant</span>
            <h3>Daily Wear</h3>
            <span class="collection-cta">Shop Minimalist</span>
          </div>
        </a>

        <!-- Card 5: Fine Necklaces -->
        <a href="/collections/necklaces" class="collection-item">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?auto=format&fit=crop&w=500&q=80" alt="Necklaces" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag">Masterpieces</span>
            <h3>Fine Necklaces</h3>
            <span class="collection-cta">View Collection</span>
          </div>
        </a>
      </div>
    </div>

    <!-- Silver Version -->
    <div class="brand-silver-only" style="width: 100%;">
      <div class="section-header">
        <span class="section-subtitle" style="color: #C0C0C0;">THE GRAND MOTHER • STERLING SILVER</span>
        <h2 class="section-title">Silver Curation</h2>
      </div>

      <div class="collections-grid">
        <!-- Card 1: Contemporary Sterling (Large/Hero block) -->
        <a href="/collections/sterling-silver" class="collection-item large-item" style="border-color: rgba(192, 192, 192, 0.25);">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=800&q=80" alt="Contemporary Sterling" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">925 Sterling</span>
            <h3 style="color: #fff;">Contemporary Sterling</h3>
            <span class="collection-cta" style="color: #fff;">Discover Silver</span>
          </div>
        </a>

        <!-- Card 2: Oxidized Heritage -->
        <a href="/collections/oxidized-silver" class="collection-item" style="border-color: rgba(192, 192, 192, 0.25);">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=500&q=80" alt="Oxidized Heritage" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">Artisanal</span>
            <h3 style="color: #fff;">Oxidized Heritage</h3>
            <span class="collection-cta" style="color: #fff;">View Pieces</span>
          </div>
        </a>

        <!-- Card 3: Silver Zirconia -->
        <a href="/collections/silver-crystal" class="collection-item" style="border-color: rgba(192, 192, 192, 0.25);">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=500&q=80" alt="Zirconia Luxury" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">Shine</span>
            <h3 style="color: #fff;">Silver Zirconia</h3>
            <span class="collection-cta" style="color: #fff;">Explore Crystals</span>
          </div>
        </a>

        <!-- Card 4: Luxury Gifting -->
        <a href="/collections/gifts-silver" class="collection-item" style="border-color: rgba(192, 192, 192, 0.25);">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1549439602-43ebca2327af?auto=format&fit=crop&w=500&q=80" alt="Luxury Gifting" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">Gifts</span>
            <h3 style="color: #fff;">Luxury Gifting</h3>
            <span class="collection-cta" style="color: #fff;">Shop Gifts</span>
          </div>
        </a>

        <!-- Card 5: Silver Rings -->
        <a href="/collections/silver-rings" class="collection-item" style="border-color: rgba(192, 192, 192, 0.25);">
          <div class="collection-img-wrapper">
            <img src="https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=500&q=80" alt="Silver Rings" loading="lazy">
          </div>
          <div class="collection-overlay-content">
            <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">Essentials</span>
            <h3 style="color: #fff;">Silver Rings</h3>
            <span class="collection-cta" style="color: #fff;">View Collection</span>
          </div>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
.collections-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-auto-rows: 280px;
  gap: 24px;
}

.collection-item {
  position: relative;
  overflow: hidden;
  border-radius: 2px;
  border: 1px solid rgba(212, 175, 55, 0.15);
  display: block;
}

.collection-item.large-item {
  grid-column: span 2;
  grid-row: span 2;
}

.collection-img-wrapper {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.collection-img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.25, 1, 0.5, 1);
}

.collection-item:hover .collection-img-wrapper img {
  transform: scale(1.06);
}

.collection-overlay-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(360deg, rgba(11, 11, 11, 0.8) 0%, rgba(11, 11, 11, 0.2) 60%, transparent 100%);
  padding: 30px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: var(--color-light);
  z-index: 2;
}

.collection-tag {
  font-size: 9px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-gold);
  margin-bottom: 8px;
}

.collection-item h3 {
  font-family: var(--font-serif);
  font-size: 24px;
  margin-bottom: 8px;
  font-weight: 500;
}

.collection-item.large-item h3 {
  font-size: 34px;
}

.collection-cta {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  text-decoration: underline;
  text-underline-offset: 4px;
  color: var(--color-light);
  opacity: 0.8;
  transition: var(--transition-fast);
}

.collection-item:hover .collection-cta {
  opacity: 1;
  color: var(--color-gold);
}

@media (max-width: 991px) {
  .collections-grid {
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 250px;
  }
  .collection-item.large-item {
    grid-column: span 2;
    grid-row: span 1;
  }
}

@media (max-width: 575px) {
  .collections-grid {
    grid-template-columns: 1fr;
    grid-auto-rows: 240px;
  }
  .collection-item.large-item {
    grid-column: span 1;
    grid-row: span 1;
  }
  .collection-item.large-item h3 {
    font-size: 24px;
  }
}
</style>
