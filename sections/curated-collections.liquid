{% schema %}
{
  "name": "Curated Collections",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Gold Subtitle",
      "default": "ROYAL HERITAGE SELECTIONS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Gold Title",
      "default": "Shop by Collection"
    },
    {
      "type": "collection_list",
      "id": "gold_collections",
      "label": "Gold Collections (Select in Admin)",
      "limit": 6
    },
    {
      "type": "text",
      "id": "silver_subtitle",
      "label": "Silver Subtitle",
      "default": "THE GRAND MOTHER • STERLING SILVER"
    },
    {
      "type": "text",
      "id": "silver_title",
      "label": "Silver Title",
      "default": "Silver Curation"
    },
    {
      "type": "collection_list",
      "id": "silver_collections",
      "label": "Silver Collections (Select in Admin)",
      "limit": 6
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "select",
          "id": "brand",
          "label": "Brand Mode",
          "options": [
            { "value": "gold", "label": "Gold Brand (Rudra)" },
            { "value": "silver", "label": "Silver Brand (TGM)" }
          ],
          "default": "gold"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection in Shopify Admin"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (Optional Override)"
        },
        {
          "type": "text",
          "id": "custom_tag",
          "label": "Custom Tag",
          "default": "Handcrafted"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Optional Override)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curated Collections",
      "blocks": [
        { "type": "collection_card", "settings": { "brand": "gold", "custom_title": "Bridal Heritage", "custom_tag": "Exquisite Craft" } },
        { "type": "collection_card", "settings": { "brand": "gold", "custom_title": "Temple Gold", "custom_tag": "Traditional" } },
        { "type": "collection_card", "settings": { "brand": "gold", "custom_title": "Solitaire Diamonds", "custom_tag": "Brilliance" } },
        { "type": "collection_card", "settings": { "brand": "gold", "custom_title": "Daily Wear", "custom_tag": "Modern Elegant" } },
        { "type": "collection_card", "settings": { "brand": "silver", "custom_title": "Contemporary Sterling", "custom_tag": "925 Sterling" } },
        { "type": "collection_card", "settings": { "brand": "silver", "custom_title": "Oxidized Heritage", "custom_tag": "Artisanal" } }
      ]
    }
  ]
}
{% endschema %}

<section class="curated-collections section-padding">
  <div class="container">
    
    <!-- Gold Version -->
    <div class="brand-gold-only" style="width: 100%;">
      <div class="section-header">
        <span class="section-subtitle">{{ section.settings.subtitle }}</span>
        <h2 class="section-title">{{ section.settings.title }}</h2>
      </div>

      <div class="collections-grid">
        {%- assign gold_blocks = section.blocks | where: "type", "collection_card" -%}
        {%- assign gold_rendered = 0 -%}

        {%- if section.settings.gold_collections != blank and section.settings.gold_collections.size > 0 -%}
          {%- for coll in section.settings.gold_collections -%}
            {%- assign gold_rendered = gold_rendered | plus: 1 -%}
            {%- assign coll_img = coll.featured_image | image_url: width: 800 -%}
            {%- if coll_img == blank -%}
              {%- assign coll_img = "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80" -%}
            {%- endif -%}
            <a href="{{ coll.url }}" class="collection-item {% if forloop.first %}large-item{% endif %}">
              <div class="collection-img-wrapper">
                <img src="{{ coll_img }}" alt="{{ coll.title }}" loading="lazy">
              </div>
              <div class="collection-overlay-content">
                <span class="collection-tag">Heritage Curation</span>
                <h3>{{ coll.title }}</h3>
                <span class="collection-cta">Explore Collection</span>
              </div>
            </a>
          {%- endfor -%}
        {%- elsif gold_blocks.size > 0 -%}
          {%- for block in gold_blocks -%}
            {%- if block.settings.brand == 'gold' -%}
              {%- assign gold_rendered = gold_rendered | plus: 1 -%}
              {%- assign coll_obj = block.settings.collection -%}
              {%- assign item_title = block.settings.custom_title -%}
              {%- if item_title == blank and coll_obj != blank -%}
                {%- assign item_title = coll_obj.title -%}
              {%- endif -%}
              {%- if item_title == blank -%}
                {%- assign item_title = "Gold Collection" -%}
              {%- endif -%}

              {%- assign item_url = "/collections/all?brand=gold" -%}
              {%- if coll_obj != blank -%}
                {%- assign item_url = coll_obj.url -%}
              {%- endif -%}

              {%- assign item_img = "" -%}
              {%- if block.settings.custom_image != blank -%}
                {%- assign item_img = block.settings.custom_image | image_url: width: 800 -%}
              {%- elsif coll_obj != blank and coll_obj.featured_image != blank -%}
                {%- assign item_img = coll_obj.featured_image | image_url: width: 800 -%}
              {%- endif -%}
              {%- if item_img == blank -%}
                {%- assign item_img = "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80" -%}
              {%- endif -%}

              <a href="{{ item_url }}" class="collection-item {% if forloop.first %}large-item{% endif %}" {{ block.shopify_attributes }}>
                <div class="collection-img-wrapper">
                  <img src="{{ item_img }}" alt="{{ item_title }}" loading="lazy">
                </div>
                <div class="collection-overlay-content">
                  <span class="collection-tag">{{ block.settings.custom_tag | default: "Handcrafted" }}</span>
                  <h3>{{ item_title }}</h3>
                  <span class="collection-cta">Discover Royalty</span>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if gold_rendered == 0 -%}
          <!-- Default Fallback Cards -->
          <a href="/collections/all?cat=bridal&brand=gold" class="collection-item large-item">
            <div class="collection-img-wrapper">
              <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=800&q=80" alt="Bridal Heritage" loading="lazy">
            </div>
            <div class="collection-overlay-content">
              <span class="collection-tag">Exquisite Craft</span>
              <h3>Bridal Heritage</h3>
              <span class="collection-cta">Discover Royalty</span>
            </div>
          </a>

          <a href="/collections/all?cat=temple&brand=gold" class="collection-item">
            <div class="collection-img-wrapper">
              <img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=500&q=80" alt="Temple Gold" loading="lazy">
            </div>
            <div class="collection-overlay-content">
              <span class="collection-tag">Traditional</span>
              <h3>Temple Gold</h3>
              <span class="collection-cta">View Pieces</span>
            </div>
          </a>

          <a href="/collections/all?cat=solitaires&brand=gold" class="collection-item">
            <div class="collection-img-wrapper">
              <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=500&q=80" alt="Solitaires" loading="lazy">
            </div>
            <div class="collection-overlay-content">
              <span class="collection-tag">Brilliance</span>
              <h3>Solitaire Diamonds</h3>
              <span class="collection-cta">Explore Rare</span>
            </div>
          </a>

          <a href="/collections/all?cat=daily-wear&brand=gold" class="collection-item">
            <div class="collection-img-wrapper">
              <img src="https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=500&q=80" alt="Daily Wear" loading="lazy">
            </div>
            <div class="collection-overlay-content">
              <span class="collection-tag">Modern Elegant</span>
              <h3>Daily Wear</h3>
              <span class="collection-cta">Shop Minimalist</span>
            </div>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Silver Version -->
    <div class="brand-silver-only" style="width: 100%;">
      <div class="section-header">
        <span class="section-subtitle" style="color: #C0C0C0;">{{ section.settings.silver_subtitle }}</span>
        <h2 class="section-title">{{ section.settings.silver_title }}</h2>
      </div>

      <div class="collections-grid">
        {%- assign silver_blocks = section.blocks | where: "type", "collection_card" -%}
        {%- assign silver_rendered = 0 -%}

        {%- if section.settings.silver_collections != blank and section.settings.silver_collections.size > 0 -%}
          {%- for coll in section.settings.silver_collections -%}
            {%- assign silver_rendered = silver_rendered | plus: 1 -%}
            {%- assign coll_img = coll.featured_image | image_url: width: 800 -%}
            {%- if coll_img == blank -%}
              {%- assign coll_img = "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=800&q=80" -%}
            {%- endif -%}
            <a href="{{ coll.url }}" class="collection-item {% if forloop.first %}large-item{% endif %}" style="border-color: rgba(192, 192, 192, 0.25);">
              <div class="collection-img-wrapper">
                <img src="{{ coll_img }}" alt="{{ coll.title }}" loading="lazy">
              </div>
              <div class="collection-overlay-content">
                <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">925 Sterling</span>
                <h3 style="color: #fff;">{{ coll.title }}</h3>
                <span class="collection-cta" style="color: #fff;">Discover Silver</span>
              </div>
            </a>
          {%- endfor -%}
        {%- elsif silver_blocks.size > 0 -%}
          {%- for block in silver_blocks -%}
            {%- if block.settings.brand == 'silver' -%}
              {%- assign silver_rendered = silver_rendered | plus: 1 -%}
              {%- assign coll_obj = block.settings.collection -%}
              {%- assign item_title = block.settings.custom_title -%}
              {%- if item_title == blank and coll_obj != blank -%}
                {%- assign item_title = coll_obj.title -%}
              {%- endif -%}
              {%- if item_title == blank -%}
                {%- assign item_title = "Silver Collection" -%}
              {%- endif -%}

              {%- assign item_url = "/collections/all?brand=silver" -%}
              {%- if coll_obj != blank -%}
                {%- assign item_url = coll_obj.url -%}
              {%- endif -%}

              {%- assign item_img = "" -%}
              {%- if block.settings.custom_image != blank -%}
                {%- assign item_img = block.settings.custom_image | image_url: width: 800 -%}
              {%- elsif coll_obj != blank and coll_obj.featured_image != blank -%}
                {%- assign item_img = coll_obj.featured_image | image_url: width: 800 -%}
              {%- endif -%}
              {%- if item_img == blank -%}
                {%- assign item_img = "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=800&q=80" -%}
              {%- endif -%}

              <a href="{{ item_url }}" class="collection-item {% if forloop.first %}large-item{% endif %}" style="border-color: rgba(192, 192, 192, 0.25);" {{ block.shopify_attributes }}>
                <div class="collection-img-wrapper">
                  <img src="{{ item_img }}" alt="{{ item_title }}" loading="lazy">
                </div>
                <div class="collection-overlay-content">
                  <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">{{ block.settings.custom_tag | default: "925 Sterling" }}</span>
                  <h3 style="color: #fff;">{{ item_title }}</h3>
                  <span class="collection-cta" style="color: #fff;">Discover Silver</span>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- if silver_rendered == 0 -%}
          <!-- Default Silver Fallback Cards -->
          <a href="/collections/all?cat=rhodium&brand=silver" class="collection-item large-item" style="border-color: rgba(192, 192, 192, 0.25);">
            <div class="collection-img-wrapper">
              <img src="https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=800&q=80" alt="Contemporary Sterling" loading="lazy">
            </div>
            <div class="collection-overlay-content">
              <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">925 Sterling</span>
              <h3 style="color: #fff;">Contemporary Sterling</h3>
              <span class="collection-cta" style="color: #fff;">Discover Silver</span>
            </div>
          </a>

          <a href="/collections/all?cat=oxidized&brand=silver" class="collection-item" style="border-color: rgba(192, 192, 192, 0.25);">
            <div class="collection-img-wrapper">
              <img src="https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=500&q=80" alt="Oxidized Heritage" loading="lazy">
            </div>
            <div class="collection-overlay-content">
              <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">Artisanal</span>
              <h3 style="color: #fff;">Oxidized Heritage</h3>
              <span class="collection-cta" style="color: #fff;">View Pieces</span>
            </div>
          </a>

          <a href="/collections/all?cat=zirconia&brand=silver" class="collection-item" style="border-color: rgba(192, 192, 192, 0.25);">
            <div class="collection-img-wrapper">
              <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?auto=format&fit=crop&w=500&q=80" alt="Zirconia Luxury" loading="lazy">
            </div>
            <div class="collection-overlay-content">
              <span class="collection-tag" style="background: rgba(255,255,255,0.15); border-color: rgba(255,255,255,0.3); color: #fff;">Shine</span>
              <h3 style="color: #fff;">Silver Zirconia</h3>
              <span class="collection-cta" style="color: #fff;">Explore Crystals</span>
            </div>
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<style>
.collections-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  width: 100%;
}

.collection-item {
  position: relative;
  display: block;
  border-radius: 8px;
  overflow: hidden;
  aspect-ratio: 4 / 5;
  border: 1px solid var(--color-gray-border);
  text-decoration: none;
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}

.collection-item:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
}

.collection-item.large-item {
  grid-column: span 2;
  grid-row: span 1;
  aspect-ratio: 16 / 9;
}

.collection-img-wrapper {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.collection-img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.collection-item:hover .collection-img-wrapper img {
  transform: scale(1.08);
}

.collection-overlay-content {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 30%, rgba(0,0,0,0.8) 100%);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 24px;
  z-index: 2;
  color: #ffffff;
}

.collection-tag {
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: rgba(200, 161, 61, 0.25);
  border: 1px solid rgba(200, 161, 61, 0.5);
  color: #fff;
  padding: 3px 8px;
  border-radius: 2px;
  width: fit-content;
  margin-bottom: 8px;
  font-weight: 600;
}

.collection-overlay-content h3 {
  font-family: var(--font-serif);
  font-size: 22px;
  color: #ffffff;
  margin-bottom: 6px;
  font-weight: 500;
}

.collection-cta {
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-gold);
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

@media (max-width: 991px) {
  .collections-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .collection-item.large-item {
    grid-column: span 2;
  }
}

@media (max-width: 576px) {
  .collections-grid {
    grid-template-columns: 1fr;
  }
  .collection-item.large-item {
    grid-column: span 1;
    aspect-ratio: 4 / 3;
  }
}
</style>
