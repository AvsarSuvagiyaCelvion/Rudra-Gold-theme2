{% schema %}
{
  "name": "Luxury Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "VERIFIED BUYER PATRONAGE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Patron Testimonials"
    }
  ]
}
{% endschema %}

<section class="testimonials-glass section-padding">
  <div class="testimonials-bg-accent"></div>
  <div class="container">
    
    <div class="section-header">
      <span class="section-subtitle">{{ section.settings.subtitle }}</span>
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>

    <!-- Testimonials Slider Wrapper -->
    <div class="testimonials-slider-container">
      <div class="testimonials-track" id="testimonialsTrack">
        
        <!-- Card 1 -->
        <div class="testimonial-card glass-card">
          <div class="test-rating">
            {%- for i in (1..5) -%}
              {% render 'icon-star' %}
            {%- endfor -%}
          </div>
          <p class="test-quote">"Purchased my bridal gold jewellery set from Rudra Gold and the craftsmanship is unmatched. Every single filigree node is absolutely perfect. The VIP Home Trial was incredibly convenient!"</p>
          <div class="test-author-info">
            <h4>Anjali Sharma</h4>
            <span>Mumbai • Verified Luxury Buyer</span>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="testimonial-card glass-card">
          <div class="test-rating">
            {%- for i in (1..5) -%}
              {% render 'icon-star' %}
            {%- endfor -%}
          </div>
          <p class="test-quote">"The pricing transparency is what made me buy. They calculate live gold rates and make charges flat. Verify purity with HUID on BIS care. Most trustworthy jeweler."</p>
          <div class="test-author-info">
            <h4>Devendra Goel</h4>
            <span>New Delhi • Elite Diamond Collector</span>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="testimonial-card glass-card">
          <div class="test-rating">
            {%- for i in (1..5) -%}
              {% render 'icon-star' %}
            {%- endfor -%}
          </div>
          <p class="test-quote">"I was amazed by the customer service. The bespoke consultation was highly personalized. The customized initials laser engraving on my wedding bands came out beautifully."</p>
          <div class="test-author-info">
            <h4>Priya Nair</h4>
            <span>Bangalore • Bridal Patron</span>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
.testimonials-glass {
  position: relative;
  background-color: var(--color-cream);
  overflow: hidden;
}

.testimonials-bg-accent {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.08) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

.testimonials-slider-container {
  position: relative;
  z-index: 1;
  overflow: hidden;
  padding: 20px 0;
}

.testimonials-track {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.testimonial-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: rgba(255, 255, 255, 0.6) !important;
  border: 1px solid rgba(212, 175, 55, 0.2) !important;
  box-shadow: 0 10px 30px rgba(11, 11, 11, 0.02);
}

.test-rating {
  color: var(--color-gold);
  margin-bottom: 20px;
  display: flex;
  gap: 4px;
}

.test-rating svg {
  width: 14px;
  height: 14px;
}

.test-quote {
  font-family: var(--font-serif);
  font-size: 15px;
  line-height: 1.6;
  color: var(--color-dark);
  font-style: italic;
  margin-bottom: 30px;
  flex: 1;
}

.test-author-info h4 {
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-dark);
}

.test-author-info span {
  font-size: 10px;
  color: var(--color-text-muted);
}

@media (max-width: 991px) {
  .testimonials-track {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

@media (max-width: 575px) {
  .testimonials-track {
    grid-template-columns: 1fr;
  }
}
</style>
