<script>
function updateShopifyVariant(variantId) {
  const select = document.getElementById('puritySelector');
  if (!select) return;
  
  // Set variant ID for PDP Cart Button data attribute
  const addBtn = document.getElementById('pdpAddToCartBtn');
  if (addBtn) {
    addBtn.setAttribute('data-variant-id', variantId);
  }

  // Trigger pricing recalculation inside theme.js
  if (typeof calculateVariantPricing === 'function') {
    calculateVariantPricing();
  }
}

function switchPDPImage(src) {
  const mainImg = document.getElementById('pdpMainImage');
  if (mainImg) mainImg.src = src;

  // Active thumb highlight toggle
  document.querySelectorAll('.pdp-thumb').forEach(el => {
    el.classList.remove('active');
    if (el.src === src) el.classList.add('active');
  });
}

function toggleAccordion(btn) {
  const content = btn.nextElementSibling;
  btn.classList.toggle('active');
  
  if (content.style.display === 'block') {
    content.style.display = 'none';
  } else {
    content.style.display = 'block';
  }
}

function togglePDPEngraveText(check) {
  const input = document.getElementById('pdpLaserEngraveText');
  if (input) {
    input.style.display = check.checked ? 'block' : 'none';
    if (!check.checked) input.value = '';
  }
}

function switchPDPTab(evt, tabId) {
  // Hide all panels
  document.querySelectorAll('.tab-content-panel').forEach(panel => {
    panel.style.display = 'none';
  });

  // Remove active from headers
  document.querySelectorAll('.tab-header-btn').forEach(btn => {
    btn.classList.remove('active');
    btn.style.borderBottomColor = 'transparent';
  });

  // Show active panel
  const activePanel = document.getElementById(tabId);
  if (activePanel) {
    activePanel.style.display = 'block';
  }

  // Set active class on target button
  evt.currentTarget.classList.add('active');
  evt.currentTarget.style.borderBottomColor = 'var(--color-gold)';
}

function togglePDPFAQ(btn) {
  const content = btn.nextElementSibling;
  const icon = btn.querySelector('span');
  
  if (content.style.display === 'block') {
    content.style.display = 'none';
    if (icon) icon.textContent = '+';
  } else {
    content.style.display = 'block';
    if (icon) icon.textContent = '-';
  }
}

// Show/Hide Sticky ATC Bar on scroll
document.addEventListener('DOMContentLoaded', () => {
  const stickyAtc = document.getElementById('stickyAtcBar');
  const triggerElement = document.getElementById('pdpAddToCartBtn');
  
  if (!stickyAtc || !triggerElement) return;

  window.addEventListener('scroll', () => {
    const triggerY = triggerElement.getBoundingClientRect().top + window.scrollY;
    
    if (window.scrollY > triggerY + 100) {
      stickyAtc.classList.add('active');
    } else {
      stickyAtc.classList.remove('active');
    }
  });
});
</script>
