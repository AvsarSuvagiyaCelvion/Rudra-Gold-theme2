{% schema %}
{
  "name": "Store Locator",
  "settings": []
}
{% endschema %}

<section class="store-locator-page section-padding">
  <div class="container">

    <div class="section-header">
      <p class="section-subtitle">Visit Us In Person</p>
      <h1 class="section-title">Our Boutiques</h1>
    </div>

    <div class="store-locator-layout">

      <!-- Store Cards -->
      <div class="store-cards">

        <div class="store-card active" data-store="surat">
          <div class="store-card-header">
            <div>
              <h3 class="store-card-name">Flagship Boutique — Surat</h3>
              <span class="store-card-tag">Main Store</span>
            </div>
            <div class="store-status open">Open Now</div>
          </div>
          <div class="store-card-details">
            <div class="store-detail-row">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>340, First Floor, Varsha Society, Matavadi, Varachha, Surat — 395006</span>
            </div>
            <div class="store-detail-row">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Mon – Sat: 10:00 AM – 8:00 PM &nbsp;|&nbsp; Sun: 11:00 AM – 6:00 PM</span>
            </div>
            <div class="store-detail-row">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.82a16 16 0 0 0 6.29 6.29l.96-.96a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <a href="https://wa.me/917405544338">+91 74055 44338</a>
            </div>
          </div>
          <a href="https://maps.google.com/?q=Varachha+Surat+Gujarat" target="_blank" rel="noopener" class="store-directions-btn">
            Get Directions
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>

       

      </div>

      <!-- Map Panel -->
      <div class="store-map-panel">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3719.65326722516!2d72.85312572344006!3d21.205928681673374!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be04f0119904fb5%3A0x30429ce3ce80b3ef!2sVarsha%20Society%201%2C%20Ambavadi%2C%20Varachha%2C%20Surat%2C%20Gujarat%20395006!5e0!3m2!1sen!2sin!4v1785414344417!5m2!1sen!2sin"
          width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin" title="Rudra Gold Store Location">
        </iframe>
      </div>

    </div>

    <!-- VIP Home Trial CTA -->
    <div class="store-home-trial-cta">
      <div>
        <h3>Can't Visit Us? We'll Come to You.</h3>
        <p>Book our exclusive VIP Home Trial Curation — our jewellery concierge brings the boutique experience to your doorstep.</p>
      </div>
      <button class="btn-primary" data-modal-type="vip-visit">Book Home Trial</button>
    </div>

  </div>
</section>

<style>
.store-locator-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  margin-bottom: 50px;
  align-items: start;
}

.store-cards {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.store-card {
  border: 1px solid var(--color-gray-border);
  padding: 24px;
  background-color: var(--color-light);
  transition: var(--transition-smooth);
  cursor: pointer;
}

.store-card.active,
.store-card:hover {
  border-color: var(--color-gold);
  box-shadow: 0 4px 20px rgba(212,175,55,0.1);
}

.store-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.store-card-name {
  font-family: var(--font-serif);
  font-size: 17px;
  color: var(--color-dark);
  margin-bottom: 4px;
}

.store-card-tag {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-gold);
  font-weight: 600;
}

.store-status {
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 4px 10px;
  border-radius: 20px;
  white-space: nowrap;
}

.store-status.open {
  background-color: rgba(74, 222, 128, 0.1);
  color: #16a34a;
  border: 1px solid rgba(74,222,128,0.3);
}

.store-status.soon {
  background-color: rgba(212,175,55,0.1);
  color: var(--color-gold);
  border: 1px solid rgba(212,175,55,0.3);
}

.store-card-details {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 20px;
}

.store-detail-row {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  font-size: 12px;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.store-detail-row svg { flex-shrink: 0; color: var(--color-gold); margin-top: 1px; }
.store-detail-row a { color: var(--color-gold); }
.store-detail-row a:hover { text-decoration: underline; }

.store-directions-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-dark);
  border-bottom: 1px solid var(--color-gold);
  padding-bottom: 2px;
  transition: var(--transition-fast);
}

.store-directions-btn:hover { color: var(--color-gold); }

.store-map-panel {
  height: 520px;
  border: 1px solid var(--color-gray-border);
  overflow: hidden;
  position: sticky;
  top: 100px;
}

.store-home-trial-cta {
  background-color: var(--color-dark);
  border: 1px solid rgba(212,175,55,0.3);
  padding: 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.store-home-trial-cta h3 {
  font-family: var(--font-serif);
  font-size: 22px;
  color: var(--color-gold);
  margin-bottom: 8px;
}

.store-home-trial-cta p {
  font-size: 13px;
  color: rgba(255,255,255,0.6);
  max-width: 500px;
}

@media (max-width: 991px) {
  .store-locator-layout { grid-template-columns: 1fr; }
  .store-map-panel { height: 350px; position: static; }
  .store-home-trial-cta { flex-direction: column; text-align: center; }
}
</style>
