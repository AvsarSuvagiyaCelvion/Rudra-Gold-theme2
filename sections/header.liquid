{% schema %}
{
  "name": "Luxury Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "RUDRA GOLD"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Timeless Purity, Crafted for Royalty"
    }
  ]
}
{% endschema %}

<header class="site-header" id="siteHeader">
  <div class="container header-container">
    
    <!-- Left: Mobile Menu Trigger & Logo -->
    <div class="header-left">
      <button class="mobile-menu-trigger" id="mobileMenuTrigger" aria-label="Open navigation menu">
        {% render 'icon-hamburger' %}
      </button>
      <a href="/" class="header-logo-group">
        <h1 class="logo-title">{{ section.settings.brand_name }}</h1>
        <span class="logo-tagline">{{ section.settings.tagline }}</span>
      </a>
    </div>

    <!-- Center: Main Navigation & Mega Menus -->
    <nav class="main-navigation" id="mainNavigation">
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="/" class="nav-link">Home</a>
        </li>
        <li class="nav-item has-mega-menu">
          <a href="/collections" class="nav-link">
            Collections 
            <svg class="nav-arrow" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </a>
          <!-- Visual Mega Menu -->
          <div class="mega-menu">
            <div class="container mega-menu-grid">
              
              <a href="/collections/bridal" class="mega-menu-column">
                <div class="mega-image-wrapper">
                  <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=300&q=80" alt="Bridal Heritage">
                </div>
                <h4>Bridal Heritage</h4>
                <span>Grand designs for royal weddings</span>
              </a>

              <a href="/collections/temple" class="mega-menu-column">
                <div class="mega-image-wrapper">
                  <img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=300&q=80" alt="Temple Gold">
                </div>
                <h4>Temple Gold</h4>
                <span>Traditional hand-carved heritage</span>
              </a>

              <a href="/collections/daily-wear" class="mega-menu-column">
                <div class="mega-image-wrapper">
                  <img src="https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=300&q=80" alt="Daily Wear">
                </div>
                <h4>Daily Wear</h4>
                <span>Minimalist modern gold essentials</span>
              </a>

              <a href="/collections/solitaires" class="mega-menu-column">
                <div class="mega-image-wrapper">
                  <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=300&q=80" alt="Ethical Diamonds">
                </div>
                <h4>Solitaires</h4>
                <span>Rare diamonds of timeless purity</span>
              </a>

            </div>
          </div>
        </li>
        <li class="nav-item">
          <a href="/collections/necklaces" class="nav-link">Necklaces</a>
        </li>
        <li class="nav-item">
          <a href="/collections/rings" class="nav-link">Rings & Bangles</a>
        </li>
        <li class="nav-item">
          <a href="#" data-modal-type="vip-visit" class="nav-link vip-link">VIP Home Trial</a>
        </li>
      </ul>
    </nav>

    <!-- Right: Utility Icons -->
    <div class="header-right">
      <button class="header-icon-btn" id="headerSearchTrigger" aria-label="Open Search">
        {% render 'icon-search' %}
      </button>
      <a href="/pages/wishlist" class="header-icon-btn wishlist-icon-btn" aria-label="Wishlist">
        {% render 'icon-wishlist' %}
        <span class="wishlist-count header-badge">0</span>
      </a>
      <button class="header-icon-btn" data-cart-drawer-trigger aria-label="Open Bag">
        {% render 'icon-cart' %}
        <span class="cart-count-badge header-badge">0</span>
      </button>
    </div>

  </div>
</header>

<!-- Search Overlay Drawer -->
<div class="search-drawer-overlay" id="searchDrawerOverlay">
  <button class="search-drawer-close" id="searchDrawerClose">
    {% render 'icon-close' %}
  </button>
  <div class="search-drawer-container">
    <h3 style="font-family: var(--font-serif); font-size: 20px; text-transform: uppercase; margin-bottom: 20px; color: var(--color-gold);">Search RUDRA GOLD</h3>
    <div class="search-drawer-input-wrapper">
      <input type="text" class="search-drawer-input" id="searchDrawerInput" placeholder="Search rings, necklaces, bridal sets..." autocomplete="off">
      <span class="search-drawer-icon">{% render 'icon-search' %}</span>
    </div>
    <!-- Search Output Results -->
    <div class="search-results-output" id="searchResultsOutput">
      <!-- Search results will dynamically populate here -->
    </div>
  </div>
</div>

<!-- Mobile Navigation Drawer Overlay -->
<div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>

<!-- Mobile Navigation Drawer -->
<div class="mobile-menu-drawer" id="mobileMenuDrawer" role="dialog" aria-modal="true" aria-labelledby="mobileMenuTitle">
  <div class="mobile-menu-header">
    <a href="/" class="header-logo-group">
      <span class="logo-title">{{ section.settings.brand_name }}</span>
      <span class="logo-tagline">{{ section.settings.tagline }}</span>
    </a>
    <button class="mobile-menu-close-btn" id="mobileMenuClose" aria-label="Close menu">
      {% render 'icon-close' %}
    </button>
  </div>
  <div class="mobile-menu-body">
    <ul class="mobile-nav-list">
      <li class="mobile-nav-item">
        <a href="/" class="mobile-nav-link">Home</a>
      </li>
      <li class="mobile-nav-item has-submenu">
        <button class="mobile-submenu-toggle" id="mobileCollectionsToggle" aria-expanded="false">
          Collections
          <svg class="submenu-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <ul class="mobile-submenu">
          <li>
            <a href="/collections/bridal" class="mobile-submenu-link">
              <span class="title">Bridal Heritage</span>
              <span class="desc">Grand designs for royal weddings</span>
            </a>
          </li>
          <li>
            <a href="/collections/temple" class="mobile-submenu-link">
              <span class="title">Temple Gold</span>
              <span class="desc">Traditional hand-carved heritage</span>
            </a>
          </li>
          <li>
            <a href="/collections/daily-wear" class="mobile-submenu-link">
              <span class="title">Daily Wear</span>
              <span class="desc">Minimalist modern gold essentials</span>
            </a>
          </li>
          <li>
            <a href="/collections/solitaires" class="mobile-submenu-link">
              <span class="title">Solitaires</span>
              <span class="desc">Rare diamonds of timeless purity</span>
            </a>
          </li>
        </ul>
      </li>
      <li class="mobile-nav-item">
        <a href="/collections/necklaces" class="mobile-nav-link">Necklaces</a>
      </li>
      <li class="mobile-nav-item">
        <a href="/collections/rings" class="mobile-nav-link">Rings & Bangles</a>
      </li>
      <li class="mobile-nav-item">
        <a href="#" data-modal-type="vip-visit" class="mobile-nav-link vip-link">VIP Home Trial</a>
      </li>
      <li class="mobile-nav-item">
        <a href="/pages/contact" class="mobile-nav-link">Contact</a>
      </li>
      <li class="mobile-nav-item">
        <a href="/pages/faq" class="mobile-nav-link">FAQ</a>
      </li>
      <li class="mobile-nav-item">
        <a href="/pages/store-locator" class="mobile-nav-link">Store Locator</a>
      </li>
    </ul>
  </div>
  <div class="mobile-menu-footer">
    <p class="premium-badge">{{ section.settings.tagline }}</p>
  </div>
</div>

<style>
/* Header CSS Layout styling */
.site-header {
  position: fixed;
  top: 36px; /* Below announcement bar default */
  left: 0;
  width: 100%;
  height: 90px;
  background-color: transparent;
  display: flex;
  align-items: center;
  z-index: 997;
  transition: var(--transition-smooth);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.announcement-bar-section ~ .site-header {
  top: auto;
}

/* Force dark header on pages without a hero (contact, cart, collection, list-collections, search, etc.) */
.template-page .site-header,
.template-cart .site-header,
.template-collection .site-header,
.template-list-collections .site-header,
.template-search .site-header,
.template-404 .site-header,
.template-product .site-header {
  background-color: var(--color-dark) !important;
  border-bottom-color: rgba(212, 175, 55, 0.2) !important;
}

.site-header.scrolled {
  top: 0;
  background-color: var(--color-dark);
  height: 75px;
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
}

.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 15px;
}

.header-logo-group {
  display: flex;
  flex-direction: column;
}

.logo-title {
  font-family: var(--font-serif);
  font-size: 24px;
  font-weight: 600;
  letter-spacing: 0.15em;
  color: var(--color-gold);
  line-height: 1.1;
}

.logo-tagline {
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 2px;
}

.site-header.scrolled .logo-tagline {
  color: rgba(255, 255, 255, 0.4);
}

.main-navigation {
  flex: 1;
  display: flex;
  justify-content: center;
}

.nav-menu {
  display: flex;
  list-style: none;
  gap: 36px;
  align-items: center;
}

.nav-link {
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-light);
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 10px 0;
  position: relative;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1px;
  background-color: var(--color-gold);
  transition: var(--transition-fast);
}

.nav-link:hover::after {
  width: 100%;
}

.nav-link:hover {
  color: var(--color-gold-glow);
}

.nav-arrow {
  transition: transform 0.3s;
}

.has-mega-menu:hover .nav-arrow {
  transform: rotate(180deg);
}

.vip-link {
  color: var(--color-gold);
  font-weight: 600;
}

/* Mega Menu Structure */
.has-mega-menu {
  position: static;
}

.mega-menu {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  background-color: var(--color-dark);
  border-bottom: 1.5px solid var(--color-gold);
  opacity: 0;
  visibility: hidden;
  transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  transform: translateY(10px);
  padding: 40px 0;
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
}

.has-mega-menu:hover .mega-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.mega-menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
}

.mega-menu-column {
  text-align: center;
  transition: var(--transition-smooth);
}

.mega-menu-column:hover {
  transform: translateY(-5px);
}

.mega-image-wrapper {
  overflow: hidden;
  border: 1px solid rgba(212, 175, 55, 0.15);
  margin-bottom: 15px;
  border-radius: 2px;
  aspect-ratio: 1 / 1;
}

.mega-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s;
}

.mega-menu-column:hover .mega-image-wrapper img {
  transform: scale(1.05);
}

.mega-menu-column h4 {
  font-family: var(--font-serif);
  font-size: 15px;
  color: var(--color-gold);
  margin-bottom: 4px;
}

.mega-menu-column span {
  font-size: 10px;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

/* Utilities Right Icons */
.header-right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.header-icon-btn {
  color: var(--color-light);
  cursor: pointer;
  position: relative;
  transition: var(--transition-fast);
}

.header-icon-btn:hover {
  color: var(--color-gold);
}

.wishlist-icon-btn svg, .header-icon-btn svg {
  width: 22px;
  height: 22px;
  display: block;
}

.header-badge {
  position: absolute;
  top: -6px;
  right: -8px;
  background-color: var(--color-gold);
  color: var(--color-dark);
  font-size: 8px;
  font-weight: 700;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mobile-menu-trigger {
  display: none;
  color: var(--color-light);
  cursor: pointer;
}

/* Mobile & Tablet Styles */
@media (max-width: 991px) {
  #shopify-section-header {
    position: sticky;
    top: 0;
    z-index: 997;
  }
  .site-header {
    position: relative !important;
    top: auto !important;
    height: 70px;
    background-color: var(--color-dark);
  }
  .main-navigation {
    display: none; /* Controlled by slide drawer */
  }
  .mobile-menu-trigger {
    display: block;
  }
  .mega-menu {
    display: none; /* Hide standard desktop mega menu */
  }
  .logo-title {
    font-size: 18px !important;
    letter-spacing: 0.1em !important;
  }
  .logo-tagline {
    font-size: 7px !important;
    letter-spacing: 0.1em !important;
    max-width: 150px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
}

@media (max-width: 480px) {
  .logo-title {
    font-size: 15px !important;
    letter-spacing: 0.08em !important;
  }
  .logo-tagline {
    display: none !important; /* Hide tagline on small screens to prevent vertical/horizontal overflow */
  }
  .header-left {
    gap: 8px !important;
  }
  .header-right {
    gap: 10px !important;
  }
  .site-header {
    height: 60px !important; /* Reduce height slightly on mobile for a tighter, premium feel */
  }
}

/* Mobile Menu Drawer Overlay */
.mobile-menu-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(11, 11, 11, 0.85);
  backdrop-filter: blur(5px);
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.4s ease, visibility 0.4s;
}

.mobile-menu-overlay.active {
  visibility: visible;
  opacity: 1;
}

/* Mobile Menu Drawer */
.mobile-menu-drawer {
  position: fixed;
  top: 0;
  left: -100%;
  width: 100%;
  max-width: 320px;
  height: 100%;
  background-color: var(--color-dark);
  border-right: 1px solid var(--color-gold);
  z-index: 1001;
  display: flex;
  flex-direction: column;
  transition: left 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  box-shadow: 10px 0 30px rgba(0, 0, 0, 0.5);
  color: var(--color-light);
}

.mobile-menu-drawer.active {
  left: 0;
}

.mobile-menu-header {
  padding: 20px 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mobile-menu-close-btn {
  cursor: pointer;
  color: var(--color-light);
  transition: var(--transition-fast);
  background: none;
  border: none;
}

.mobile-menu-close-btn:hover {
  color: var(--color-gold);
}

.mobile-menu-close-btn svg {
  width: 24px;
  height: 24px;
  display: block;
}

.mobile-menu-body {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
}

.mobile-nav-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.mobile-nav-item {
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  padding-bottom: 12px;
}

.mobile-nav-item:last-child {
  border-bottom: none;
}

.mobile-nav-link {
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-light);
  display: block;
  transition: var(--transition-fast);
}

.mobile-nav-link:hover,
.mobile-nav-link.active {
  color: var(--color-gold);
  padding-left: 5px;
}

.mobile-nav-link.vip-link {
  color: var(--color-gold);
  font-weight: 600;
}

.mobile-submenu-toggle {
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-light);
  width: 100%;
  text-align: left;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  padding: 0;
  background: none;
  border: none;
  transition: var(--transition-fast);
}

.mobile-submenu-toggle:hover {
  color: var(--color-gold);
}

.submenu-arrow {
  transition: transform 0.3s;
}

.mobile-submenu-toggle.active .submenu-arrow {
  transform: rotate(180deg);
}

.mobile-submenu {
  list-style: none;
  margin-top: 10px;
  padding-left: 15px;
  display: none;
  flex-direction: column;
  gap: 12px;
  border-left: 1px solid rgba(212, 175, 55, 0.3);
}

.mobile-submenu.active {
  display: flex;
}

.mobile-submenu-link {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 4px 0;
}

.mobile-submenu-link .title {
  font-size: 13px;
  font-weight: 500;
  color: var(--color-gold);
}

.mobile-submenu-link .desc {
  font-size: 10px;
  color: rgba(255, 255, 255, 0.5);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.mobile-menu-footer {
  padding: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  background-color: rgba(0, 0, 0, 0.2);
  text-align: center;
}

.premium-badge {
  font-family: var(--font-serif);
  font-size: 12px;
  color: var(--color-gold);
  letter-spacing: 0.1em;
  font-style: italic;
}
</style>

<!-- Mobile Navigation Menu Drawer JS Toggle Code in theme.js -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  // Mobile search trigger
  const mobileSearch = document.getElementById('mobileSearchTrigger');
  const searchDrawer = document.getElementById('searchDrawerOverlay');
  const searchClose = document.getElementById('searchDrawerClose');
  const searchOverlay = document.getElementById('searchDrawerOverlay');
  const desktopSearch = document.getElementById('headerSearchTrigger');

  const openSearch = () => {
    searchDrawer.classList.add('active');
    document.getElementById('searchDrawerInput').focus();
  };

  const closeSearch = () => {
    searchDrawer.classList.remove('active');
  };

  if (mobileSearch) mobileSearch.addEventListener('click', openSearch);
  if (desktopSearch) desktopSearch.addEventListener('click', openSearch);
  if (searchClose) searchClose.addEventListener('click', closeSearch);

  // Simple Mock live search results simulation
  const searchInput = document.getElementById('searchDrawerInput');
  const resultsOutput = document.getElementById('searchResultsOutput');
  
  const mockProducts = [
    { title: "Rudra Royal Signature Necklace", price: "₹2,45,000", img: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=150&q=80" },
    { title: "Bridal Heritage Diamond Choker", price: "₹4,12,000", img: "https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=150&q=80" },
    { title: "Mayur Heritage Temple Ring", price: "₹65,000", img: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=150&q=80" },
    { title: "Golden Glow Filigree Bangles", price: "₹1,85,000", img: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=150&q=80" }
  ];

  if (searchInput && resultsOutput) {
    let debounceTimer;

    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const val = searchInput.value.trim();
      
      if (val.length < 2) {
        resultsOutput.innerHTML = '';
        return;
      }

      debounceTimer = setTimeout(async () => {
        resultsOutput.innerHTML = '<p style="color: rgba(255,255,255,0.6); text-align: center; margin-top: 20px;">Searching curation...</p>';
        
        try {
          const res = await fetch(`/search/suggest.json?q=${encodeURIComponent(val)}&resources[type]=product`);
          if (!res.ok) throw new Error("Predictive search failed");
          const data = await res.json();
          
          const products = data.resources.results.products;
          resultsOutput.innerHTML = '';
          
          if (!products || products.length === 0) {
            resultsOutput.innerHTML = '<p style="color: rgba(255,255,255,0.4); text-align: center; margin-top: 20px;">No exquisite pieces match your search.</p>';
          } else {
            products.forEach(p => {
              // Convert price to number without cents for quickview display if needed
              let rawPriceStr = String(p.price || '');
              let priceInt = 0;
              let formattedPrice = '';
              
              if (rawPriceStr.includes('₹') || rawPriceStr.includes(',') || rawPriceStr.includes('Rs')) {
                // If it is already formatted, use it directly
                formattedPrice = rawPriceStr;
                priceInt = Math.round(parseFloat(rawPriceStr.replace(/[^\d.]/g, '')) || 0);
              } else {
                // If it is a raw number (rupees or cents)
                let numVal = parseFloat(rawPriceStr) || 0;
                if (numVal > 99999) {
                  // Standard Shopify cents conversion
                  numVal = numVal / 100;
                }
                priceInt = Math.round(numVal);
                formattedPrice = "₹" + priceInt.toLocaleString('en-IN');
              }
              
              resultsOutput.innerHTML += `
                <a href="${p.url}" class="search-result-item">
                  <img src="${p.image || 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=150&q=80'}" alt="${p.title}">
                  <div>
                    <h4 class="search-result-item-title">${p.title}</h4>
                    <p class="search-result-item-price">${formattedPrice}</p>
                  </div>
                </a>
              `;
            });
          }
        } catch (err) {
          console.warn("Predictive search API failed, falling back to mock search:", err);
          const valLower = val.toLowerCase();
          const filtered = mockProducts.filter(p => p.title.toLowerCase().includes(valLower));
          resultsOutput.innerHTML = '';
          
          if (filtered.length === 0) {
            resultsOutput.innerHTML = '<p style="color: rgba(255,255,255,0.4); text-align: center; margin-top: 20px;">No exquisite pieces match your search.</p>';
          } else {
            filtered.forEach(p => {
              resultsOutput.innerHTML += `
                <a href="#" class="search-result-item" onclick="event.preventDefault(); triggerQuickView('${p.title}', ${parseInt(p.price.replace(/[₹,]/g,''))}, '${p.img}'); document.getElementById('searchDrawerClose').click();">
                  <img src="${p.img}" alt="${p.title}">
                  <div>
                    <h4 class="search-result-item-title">${p.title}</h4>
                    <p class="search-result-item-price">${p.price}</p>
                  </div>
                </a>
              `;
            });
          }
        }
      }, 300);
    });
  }
});
</script>
