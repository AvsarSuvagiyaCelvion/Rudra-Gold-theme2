<!-- Mobile Navigation Menu Drawer JS Toggle Code in theme.js -->
<script>
  window.openBrandSwitcherModal = function() {
    const backdrop = document.getElementById('brandSwitcherModalBackdrop');
    if (backdrop) backdrop.classList.add('active');
  };

  window.closeBrandSwitcherModal = function(e) {
    if (e) e.stopPropagation();
    const backdrop = document.getElementById('brandSwitcherModalBackdrop');
    if (backdrop) backdrop.classList.remove('active');
  };

  window.switchBrandFromPopup = function(brand) {
    window.closeBrandSwitcherModal();
    window.switchBrand(brand);
  };

  // Global brand switcher helper function
  window.switchBrand = function(brand) {
    try {
      localStorage.setItem('active_brand', brand);
      sessionStorage.setItem('active_brand', brand);
    } catch(e) {}
    
    if (brand === 'silver') {
      document.documentElement.classList.add('theme-silver');
      document.documentElement.classList.remove('theme-gold');
      
      const path = window.location.pathname.toLowerCase();
      if (path === '/' || path.includes('gold') || path.includes('silver') || path.includes('grand-mother')) {
        window.location.replace('/?brand=silver');
      } else {
        const url = new URL(window.location.href);
        url.searchParams.set('brand', 'silver');
        window.location.replace(url.toString());
      }
    } else {
      document.documentElement.classList.add('theme-gold');
      document.documentElement.classList.remove('theme-silver');
      
      const path = window.location.pathname.toLowerCase();
      if (path === '/' || path.includes('gold') || path.includes('silver') || path.includes('grand-mother')) {
        window.location.replace('/?brand=gold');
      } else {
        const url = new URL(window.location.href);
        url.searchParams.set('brand', 'gold');
        window.location.replace(url.toString());
      }
    }
  };

document.addEventListener('DOMContentLoaded', () => {
  // Apply visual switcher states & texts dynamically
  const activeBrand = sessionStorage.getItem('active_brand') || (document.documentElement.classList.contains('theme-silver') ? 'silver' : 'gold');
  
  document.querySelectorAll('.brand-switcher .switcher-btn').forEach(btn => {
    if (btn.getAttribute('data-brand') === activeBrand) {
      btn.classList.add('active');
    } else {
      btn.classList.remove('active');
    }
  });

  const logoTitles = document.querySelectorAll('.logo-title');
  const logoTaglines = document.querySelectorAll('.logo-tagline');
  
  if (activeBrand === 'silver') {
    logoTitles.forEach(el => el.textContent = 'THE GRAND MOTHER');
    logoTaglines.forEach(el => {
      el.textContent = 'Sleek Elegance, Silver & Diamond';
      el.style.color = '#9E9E9E';
    });
    
    // Update search overlay title
    const searchTitle = document.querySelector('.search-drawer-container h3');
    if (searchTitle) {
      searchTitle.textContent = 'Search THE GRAND MOTHER';
    }

    // Update collection page titles
    const collTitle = document.querySelector('.collection-page-title');
    if (collTitle) {
      collTitle.textContent = 'The Grand Mother Silver Curation';
    }
  } else {
    logoTitles.forEach(el => el.textContent = 'RUDRA GOLD');
    logoTaglines.forEach(el => {
      el.textContent = 'Timeless Purity, Crafted for Royalty';
      el.style.color = '';
    });

    // Update collection page titles
    const collTitle = document.querySelector('.collection-page-title');
    if (collTitle) {
      collTitle.textContent = 'Heritage Gold Jewellery';
    }
  }

  // Mobile search trigger
  const mobileSearch = document.getElementById('mobileSearchTrigger');
  const searchDrawer = document.getElementById('searchDrawerOverlay');
  const searchClose = document.getElementById('searchDrawerClose');
  const searchOverlay = document.getElementById('searchDrawerOverlay');
  const desktopSearch = document.getElementById('headerSearchTrigger');

  const openSearch = () => {
    searchDrawer.classList.add('active');
    document.getElementById('searchDrawerInput').focus();
  };

  const closeSearch = () => {
    searchDrawer.classList.remove('active');
  };

  if (mobileSearch) mobileSearch.addEventListener('click', openSearch);
  if (desktopSearch) desktopSearch.addEventListener('click', openSearch);
  if (searchClose) searchClose.addEventListener('click', closeSearch);

  // Simple Mock live search results simulation
  const searchInput = document.getElementById('searchDrawerInput');
  const resultsOutput = document.getElementById('searchResultsOutput');
  
  const mockProducts = [
    { title: "Rudra Royal Signature Necklace", price: "₹2,45,000", img: "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=150&q=80", brand: "gold" },
    { title: "Bridal Heritage Diamond Choker", price: "₹4,12,000", img: "https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=150&q=80", brand: "gold" },
    { title: "Mayur Heritage Temple Ring", price: "₹65,000", img: "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=150&q=80", brand: "gold" },
    { title: "Golden Glow Filigree Bangles", price: "₹1,85,000", img: "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=150&q=80", brand: "gold" },
    { title: "Silver Sterling Classic Band", price: "₹8,500", img: "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=150&q=80", brand: "silver" },
    { title: "The Grand Mother Oxidized Ring", price: "₹6,800", img: "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=150&q=80", brand: "silver" },
    { title: "Vintage Filigree Kada Bracelet", price: "₹18,500", img: "https://images.unsplash.com/photo-1549439602-43ebca2327af?auto=format&fit=crop&w=150&q=80", brand: "silver" }
  ];

  if (searchInput && resultsOutput) {
    let debounceTimer;

    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      const val = searchInput.value.trim();
      
      if (val.length < 2) {
        resultsOutput.innerHTML = '';
        return;
      }

      debounceTimer = setTimeout(async () => {
        resultsOutput.innerHTML = '<p style="color: rgba(255,255,255,0.6); text-align: center; margin-top: 20px;">Searching curation...</p>';
        
        try {
          const isSilver = document.documentElement.classList.contains('theme-silver');
          const searchTag = isSilver ? 'tag:silver' : 'tag:gold';
          const query = `${val} AND (${searchTag})`;
          
          const res = await fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product`);
          if (!res.ok) throw new Error("Predictive search failed");
          const data = await res.json();
          
          const products = data.resources.results.products;
          resultsOutput.innerHTML = '';
          
          if (!products || products.length === 0) {
            resultsOutput.innerHTML = '<p style="color: rgba(255,255,255,0.4); text-align: center; margin-top: 20px;">No exquisite pieces match your search.</p>';
          } else {
            products.forEach(p => {
              // Convert price to number without cents for quickview display if needed
              let rawPriceStr = String(p.price || '');
              let priceInt = 0;
              let formattedPrice = '';
              
              if (rawPriceStr.includes('₹') || rawPriceStr.includes(',') || rawPriceStr.includes('Rs')) {
                // If it is already formatted, use it directly
                formattedPrice = rawPriceStr;
                priceInt = Math.round(parseFloat(rawPriceStr.replace(/[^\d.]/g, '')) || 0);
              } else {
                // If it is a raw number (rupees or cents)
                let numVal = parseFloat(rawPriceStr) || 0;
                if (numVal > 99999) {
                  // Standard Shopify cents conversion
                  numVal = numVal / 100;
                }
                priceInt = Math.round(numVal);
                formattedPrice = "₹" + priceInt.toLocaleString('en-IN');
              }
              
              resultsOutput.innerHTML += `
                <a href="${p.url}" class="search-result-item">
                  <img src="${p.image || 'https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=150&q=80'}" alt="${p.title}">
                  <div>
                    <h4 class="search-result-item-title">${p.title}</h4>
                    <p class="search-result-item-price">${formattedPrice}</p>
                  </div>
                </a>
              `;
            });
          }
        } catch (err) {
          console.warn("Predictive search API failed, falling back to mock search:", err);
          const valLower = val.toLowerCase();
          const activeBrand = document.documentElement.classList.contains('theme-silver') ? 'silver' : 'gold';
          const filtered = mockProducts.filter(p => p.title.toLowerCase().includes(valLower) && p.brand === activeBrand);
          resultsOutput.innerHTML = '';
          
          if (filtered.length === 0) {
            resultsOutput.innerHTML = '<p style="color: rgba(255,255,255,0.4); text-align: center; margin-top: 20px;">No exquisite pieces match your search.</p>';
          } else {
            filtered.forEach(p => {
              resultsOutput.innerHTML += `
                <a href="#" class="search-result-item" onclick="event.preventDefault(); triggerQuickView('${p.title}', ${parseInt(p.price.replace(/[₹,]/g,''))}, '${p.img}'); document.getElementById('searchDrawerClose').click();">
                  <img src="${p.img}" alt="${p.title}">
                  <div>
                    <h4 class="search-result-item-title">${p.title}</h4>
                    <p class="search-result-item-price">${p.price}</p>
                  </div>
                </a>
              `;
            });
          }
        }
      }, 300);
    });
  }
});
</script>



