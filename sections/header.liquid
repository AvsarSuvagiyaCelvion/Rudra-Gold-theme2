{% schema %}
{
  "name": "Luxury Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "RUDRA GOLD"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Brand Tagline",
      "default": "Timeless Purity, Crafted for Royalty"
    },
    {
      "type": "link_list",
      "id": "gold_menu",
      "label": "Gold Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "silver_menu",
      "label": "Silver Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

{%- assign selected_brand = 'gold' -%}
{%- if request.query_string contains 'brand=silver' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif request.query_string contains 'brand=gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif request.path contains 'silver' or request.path contains 'grand-mother' or request.path contains 'tgm' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif request.path contains 'gold' or request.path contains 'rudra-gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif product != blank -%}
  {%- assign product_tags_down = product.tags | join: ',' | downcase -%}
  {%- if product_tags_down contains 'silver' or product_tags_down contains 'grand mother' or product_tags_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- elsif collection != blank -%}
  {%- assign collection_handle_down = collection.handle | downcase -%}
  {%- if collection_handle_down contains 'silver' or collection_handle_down contains 'grand-mother' or collection_handle_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- endif -%}

{%- assign gold_menu_handle = section.settings.gold_menu -%}
{%- if gold_menu_handle == blank or gold_menu_handle == 'main-menu' -%}
  {%- if linklists['gold-menu'] != blank and linklists['gold-menu'].links.size > 0 -%}
    {%- assign gold_menu_handle = 'gold-menu' -%}
  {%- else -%}
    {%- assign gold_menu_handle = 'main-menu' -%}
  {%- endif -%}
{%- endif -%}

{%- assign silver_menu_handle = section.settings.silver_menu -%}
{%- if silver_menu_handle == blank or silver_menu_handle == 'main-menu' -%}
  {%- if linklists['silver-menu'] != blank and linklists['silver-menu'].links.size > 0 -%}
    {%- assign silver_menu_handle = 'silver-menu' -%}
  {%- else -%}
    {%- assign silver_menu_handle = 'silver-menu' -%}
  {%- endif -%}
{%- endif -%}
<header class="site-header" id="siteHeader">
  <div class="container header-container">
    
    <!-- Left: Mobile Menu Trigger & Logo -->
    <div class="header-left">
      <button class="mobile-menu-trigger" id="mobileMenuTrigger" aria-label="Open navigation menu">
        {% render 'icon-hamburger' %}
      </button>
      <a href="/" class="header-logo-group">
        <h1 class="logo-title">
          {%- if selected_brand == 'silver' -%}
            THE GRAND MOTHER
          {%- else -%}
            RUDRA GOLD
          {%- endif -%}
        </h1>
        <span class="logo-tagline">
          {%- if selected_brand == 'silver' -%}
            Sleek Elegance, Silver & Diamond
          {%- else -%}
            Timeless Purity, Crafted for Royalty
          {%- endif -%}
        </span>
      </a>
      <div class="brand-switcher">
        <button class="switcher-btn switch-brand-popup-trigger" onclick="openBrandSwitcherModal()">Switch Brand</button>
      </div>
    </div>

    <!-- Center: Gold Navigation -->
    <nav class="main-navigation gold-nav" id="goldNavigation">
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="/collections/all?brand=gold" class="nav-link">Catalog</a>
        </li>

        <!-- Jewellery Dropdown -->
        <li class="nav-item has-dropdown">
          <a href="/collections/all?brand=gold" class="nav-link">
            Jewellery
            <svg class="nav-arrow" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </a>
          <ul class="dropdown-menu">
            {%- assign gold_links_rendered = 0 -%}
            {%- if linklists[gold_menu_handle].links.size > 0 -%}
              {%- for link in linklists[gold_menu_handle].links -%}
                {%- assign lt_down = link.title | downcase -%}
                {%- unless lt_down == 'home' or lt_down == 'catalog' or lt_down == 'catlog' or lt_down == 'about us' or lt_down == 'contact' -%}
                  {%- assign gold_links_rendered = gold_links_rendered | plus: 1 -%}
                  <li class="dropdown-item"><a href="{{ link.url }}" class="dropdown-link">{{ link.title }}</a></li>
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if gold_links_rendered == 0 -%}
              <li class="dropdown-item"><a href="/collections/all?cat=rings&brand=gold" class="dropdown-link">Gold Rings</a></li>
              <li class="dropdown-item"><a href="/collections/all?cat=chains&brand=gold" class="dropdown-link">Gold Chains</a></li>
              <li class="dropdown-item"><a href="/collections/all?cat=mangalsutras&brand=gold" class="dropdown-link">Gold Mangalsutras</a></li>
              <li class="dropdown-item"><a href="/collections/all?cat=bangles&brand=gold" class="dropdown-link">Gold Bracelets</a></li>
              <li class="dropdown-item"><a href="/collections/all?cat=pendants&brand=gold" class="dropdown-link">Gold Pendants</a></li>
              <li class="dropdown-item"><a href="/collections/all?cat=earrings&brand=gold" class="dropdown-link">Gold Earrings</a></li>
            {%- endif -%}
          </ul>
        </li>

        <li class="nav-item">
          <a href="/pages/about-us" class="nav-link">About Us</a>
        </li>
        <li class="nav-item">
          <a href="/pages/contact" class="nav-link">Contact</a>
        </li>
      </ul>
    </nav>

    <!-- Center: Silver Navigation -->
    <nav class="main-navigation silver-nav" id="silverNavigation">
      <ul class="nav-menu">
        <li class="nav-item">
          <a href="/collections/all?brand=silver" class="nav-link">Catalog</a>
        </li>

        <!-- Silver Jewellery Dropdown -->
        <li class="nav-item has-dropdown">
          <a href="/collections/all?brand=silver" class="nav-link">
            Jewellery
            <svg class="nav-arrow" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </a>
          <ul class="dropdown-menu">
            {%- assign silver_links_rendered = 0 -%}
            {%- if linklists[silver_menu_handle].links.size > 0 -%}
              {%- for link in linklists[silver_menu_handle].links -%}
                {%- assign lt_down = link.title | downcase -%}
                {%- unless lt_down == 'home' or lt_down == 'catalog' or lt_down == 'catlog' or lt_down == 'about us' or lt_down == 'contact' -%}
                  {%- assign silver_links_rendered = silver_links_rendered | plus: 1 -%}
                  <li class="dropdown-item"><a href="{{ link.url }}" class="dropdown-link">{{ link.title }}</a></li>
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if silver_links_rendered == 0 -%}
              <li class="dropdown-item"><a href="/collections/all?cat=rings&brand=silver" class="dropdown-link">Silver Rings</a></li>
              <li class="dropdown-item"><a href="/collections/all?cat=chains&brand=silver" class="dropdown-link">Silver Chains</a></li>
              <li class="dropdown-item"><a href="/collections/all?cat=bangles&brand=silver" class="dropdown-link">Silver Bracelets</a></li>
              <li class="dropdown-item"><a href="/collections/all?cat=pendants&brand=silver" class="dropdown-link">Silver Pendants</a></li>
              <li class="dropdown-item"><a href="/collections/all?cat=earrings&brand=silver" class="dropdown-link">Silver Earrings</a></li>
            {%- endif -%}
          </ul>
        </li>

        <li class="nav-item">
          <a href="/pages/about-us" class="nav-link">About Us</a>
        </li>
        <li class="nav-item">
          <a href="/pages/contact" class="nav-link">Contact</a>
        </li>
      </ul>
    </nav>

    <!-- Right: Utility Icons -->
    <div class="header-right">
      <button class="header-icon-btn" id="headerSearchTrigger" aria-label="Open Search">
        {% render 'icon-search' %}
      </button>
      <a href="/pages/wishlist" class="header-icon-btn wishlist-icon-btn" aria-label="Wishlist">
        {% render 'icon-wishlist' %}
        <span class="wishlist-count header-badge">0</span>
      </a>
      <button class="header-icon-btn" data-cart-drawer-trigger aria-label="Open Bag">
        {% render 'icon-cart' %}
        <span class="cart-count-badge header-badge">0</span>
      </button>
    </div>

  </div>
</header>

<!-- Search Overlay Drawer -->
<div class="search-drawer-overlay" id="searchDrawerOverlay">
  <button class="search-drawer-close" id="searchDrawerClose" aria-label="Close search overlay" title="Close Search">
    <span class="close-label" style="font-size: 11px; letter-spacing: 0.15em; font-weight: 600; text-transform: uppercase; margin-right: 6px;">CLOSE</span>
    {% render 'icon-close' %}
  </button>
  <div class="search-drawer-container">
    <h3 style="font-family: var(--font-serif); font-size: 20px; text-transform: uppercase; margin-bottom: 20px; color: var(--color-gold);">
      {%- if selected_brand == 'silver' -%}
        Search THE GRAND MOTHER
      {%- else -%}
        Search RUDRA GOLD
      {%- endif -%}
    </h3>
    <div class="search-drawer-input-wrapper">
      <input type="text" class="search-drawer-input" id="searchDrawerInput" placeholder="Search rings, necklaces, bridal sets..." autocomplete="off">
      <span class="search-drawer-icon">{% render 'icon-search' %}</span>
    </div>
    <!-- Search Output Results -->
    <div class="search-results-output" id="searchResultsOutput">
      <!-- Search results will dynamically populate here -->
    </div>
  </div>
</div>

<!-- Mobile Navigation Drawer Overlay -->
<div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>

<!-- Mobile Navigation Drawer -->
<div class="mobile-menu-drawer" id="mobileMenuDrawer" role="dialog" aria-modal="true" aria-labelledby="mobileMenuTitle">
  <div class="mobile-menu-header">
    <a href="/" class="header-logo-group">
      <span class="logo-title">
        {%- if selected_brand == 'silver' -%}
          THE GRAND MOTHER
        {%- else -%}
          RUDRA GOLD
        {%- endif -%}
      </span>
      <span class="logo-tagline">
        {%- if selected_brand == 'silver' -%}
          Sleek Elegance, Silver & Diamond
        {%- else -%}
          Timeless Purity, Crafted for Royalty
        {%- endif -%}
      </span>
    </a>
    <button class="mobile-menu-close-btn" id="mobileMenuClose" aria-label="Close menu">
      {% render 'icon-close' %}
    </button>
  </div>
  <div style="padding: 12px 20px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); background-color: rgba(0,0,0,0.15);">
    <button class="switcher-btn switch-brand-popup-trigger mobile-switcher" onclick="openBrandSwitcherModal()">Switch Brand</button>
  </div>
  <div class="mobile-menu-body">
    <!-- Gold Mobile Menu -->
    <ul class="mobile-nav-list mobile-nav-gold">
      {%- assign menu_handle = gold_menu_handle -%}
      {%- for link in linklists[menu_handle].links -%}
        {%- assign link_title_down = link.title | downcase -%}
        {%- if link.links != blank -%}
          <li class="mobile-nav-item has-submenu">
            <button class="mobile-submenu-toggle" aria-expanded="false">
              {{ link.title }}
              <svg class="submenu-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            <ul class="mobile-submenu">
              {%- if link_title_down == 'collections' or link_title_down == 'collection' -%}
                <!-- Gold Menu Items -->
                <div class="brand-menu-gold" style="width: 100%;">
                  <li>
                    <a href="/collections/bridal" class="mobile-submenu-link">
                      <span class="title">Bridal Heritage</span>
                      <span class="desc">Grand designs for royal weddings</span>
                    </a>
                  </li>
                  <li>
                    <a href="/collections/temple" class="mobile-submenu-link">
                      <span class="title">Temple Gold</span>
                      <span class="desc">Traditional hand-carved heritage</span>
                    </a>
                  </li>
                  <li>
                    <a href="/collections/daily-wear" class="mobile-submenu-link">
                      <span class="title">Daily Wear</span>
                      <span class="desc">Minimalist modern gold essentials</span>
                    </a>
                  </li>
                  <li>
                    <a href="/collections/solitaires" class="mobile-submenu-link">
                      <span class="title">Solitaires</span>
                      <span class="desc">Rare diamonds of timeless purity</span>
                    </a>
                  </li>
                </div>
              {%- else -%}
                {%- for childlink in link.links -%}
                  <li>
                    <a href="{{ childlink.url }}" class="mobile-submenu-link">
                      <span class="title">{{ childlink.title }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </li>
        {%- else -%}
          <li class="mobile-nav-item">
            <a href="{{ link.url }}" class="mobile-nav-link {% if link.url contains '#vip' or link_title_down contains 'vip' %}vip-link{% endif %}" {% if link.url contains '#vip' or link_title_down contains 'vip' %}data-modal-type="vip-visit"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <!-- Silver Mobile Menu -->
    <ul class="mobile-nav-list mobile-nav-silver">
      {%- assign menu_handle = silver_menu_handle -%}
      {%- for link in linklists[menu_handle].links -%}
        {%- assign link_title_down = link.title | downcase -%}
        {%- if link.links != blank -%}
          <li class="mobile-nav-item has-submenu">
            <button class="mobile-submenu-toggle" aria-expanded="false">
              {{ link.title }}
              <svg class="submenu-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>
            <ul class="mobile-submenu">
              {%- if link_title_down == 'collections' or link_title_down == 'collection' -%}
                <!-- Silver Menu Items -->
                <div class="brand-menu-silver" style="width: 100%;">
                  <li>
                    <a href="/collections/sterling-silver" class="mobile-submenu-link">
                      <span class="title">Contemporary Sterling</span>
                      <span class="desc">Elegant daily 925 silver pieces</span>
                    </a>
                  </li>
                  <li>
                    <a href="/collections/oxidized-silver" class="mobile-submenu-link">
                      <span class="title">Oxidized Heritage</span>
                      <span class="desc">Artisanal hand-crafted vintage styles</span>
                    </a>
                  </li>
                  <li>
                    <a href="/collections/silver-crystal" class="mobile-submenu-link">
                      <span class="title">Silver Zirconia</span>
                      <span class="desc">Sparkling diamond-cut crystal accents</span>
                    </a>
                  </li>
                  <li>
                    <a href="/collections/gifts-silver" class="mobile-submenu-link">
                      <span class="title">Luxury Gifting</span>
                      <span class="desc">Curated silver gifts for loved ones</span>
                    </a>
                  </li>
                </div>
              {%- else -%}
                {%- for childlink in link.links -%}
                  <li>
                    <a href="{{ childlink.url }}" class="mobile-submenu-link">
                      <span class="title">{{ childlink.title }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </li>
        {%- else -%}
          <li class="mobile-nav-item">
            <a href="{{ link.url }}" class="mobile-nav-link {% if link.url contains '#vip' or link_title_down contains 'vip' %}vip-link{% endif %}" {% if link.url contains '#vip' or link_title_down contains 'vip' %}data-modal-type="vip-visit"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
  <div class="mobile-menu-footer">
    <p class="premium-badge">{{ section.settings.tagline }}</p>
  </div>
</div>

<!-- Brand Switcher Popup Modal -->
<div class="brand-switcher-modal-backdrop" id="brandSwitcherModalBackdrop" onclick="closeBrandSwitcherModal(event)">
  <div class="brand-switcher-modal" onclick="event.stopPropagation()">
    <button class="brand-switcher-modal-close" onclick="closeBrandSwitcherModal(event)" aria-label="Close Brand Switcher">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    
    <h3 class="Cormorant">Choose Your Brand</h3>
    
    <div class="selection-cards-grid">
      <!-- Card 1: Rudra Gold -->
      <div class="selection-card card-gold-theme" onclick="switchBrandFromPopup('gold')">
        <div class="selection-card-border"></div>
        <div class="selection-card-content">
          <span class="brand-badge gold-badge" style="margin-bottom: 12px;">✨</span>
          <h4 class="brand-title Cormorant" style="font-size: 20px;">Rudra Gold</h4>
          <p class="brand-desc" style="font-size: 11px; margin-bottom: 16px;">Luxury Gold Jewellery</p>
          <button class="selection-btn gold-btn" style="padding: 10px 20px; font-size: 10px;">Select Gold</button>
        </div>
      </div>

      <!-- Card 2: The Grand Mother -->
      <div class="selection-card card-silver-theme" onclick="switchBrandFromPopup('silver')">
        <div class="selection-card-border"></div>
        <div class="selection-card-content">
          <span class="brand-badge silver-badge" style="margin-bottom: 12px;">💎</span>
          <h4 class="brand-title Cormorant" style="font-size: 20px;">The Grand Mother</h4>
          <p class="brand-desc" style="font-size: 11px; margin-bottom: 16px;">925 Sterling Silver Jewellery</p>
          <button class="selection-btn silver-btn" style="padding: 10px 20px; font-size: 10px;">Select Silver</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
/* Header CSS Layout styling */
.site-header {
  position: fixed;
  top: 36px; /* Below announcement bar default */
  left: 0;
  width: 100%;
  height: 90px;
  background-color: transparent;
  display: flex;
  align-items: center;
  z-index: 997;
  transition: var(--transition-smooth);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.announcement-bar-section ~ .site-header {
  top: auto;
}

/* Force dark header on pages without a hero (contact, cart, collection, list-collections, search, etc.) */
.template-page .site-header,
.template-cart .site-header,
.template-collection .site-header,
.template-list-collections .site-header,
.template-search .site-header,
.template-404 .site-header,
.template-product .site-header {
  background-color: var(--color-dark) !important;
  border-bottom-color: rgba(212, 175, 55, 0.2) !important;
}

.site-header.scrolled {
  top: 0;
  background-color: var(--color-dark);
  height: 75px;
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
}

.header-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 15px;
}

.header-logo-group {
  display: flex;
  flex-direction: column;
}

.logo-title {
  font-family: var(--font-serif);
  font-size: 24px;
  font-weight: 600;
  letter-spacing: 0.15em;
  color: var(--color-gold);
  line-height: 1.1;
}

.logo-tagline {
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 2px;
}

.site-header.scrolled .logo-tagline {
  color: rgba(255, 255, 255, 0.4);
}

.main-navigation {
  flex: 1;
  display: flex;
  justify-content: center;
}

.nav-menu {
  display: flex;
  list-style: none;
  gap: 36px;
  align-items: center;
}

.nav-link {
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--color-light);
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 10px 0;
  position: relative;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 1px;
  background-color: var(--color-gold);
  transition: var(--transition-fast);
}

.nav-link:hover::after {
  width: 100%;
}

.nav-link:hover {
  color: var(--color-gold-glow);
}

.nav-arrow {
  transition: transform 0.3s;
}

.has-mega-menu:hover .nav-arrow {
  transform: rotate(180deg);
}

.vip-link {
  color: var(--color-gold);
  font-weight: 600;
}

/* Dropdown Menu Style */
.has-dropdown {
  position: relative;
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  background-color: var(--color-dark);
  border: 1px solid rgba(212, 175, 55, 0.2);
  border-top: 1.5px solid var(--color-gold);
  list-style: none;
  min-width: 200px;
  padding: 12px 0;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.25);
  z-index: 100;
  text-align: left;
}

.has-dropdown:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.dropdown-item {
  width: 100%;
}

.dropdown-link {
  display: block;
  padding: 8px 20px;
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-light);
  transition: var(--transition-fast);
  text-decoration: none;
}

.dropdown-link:hover {
  color: var(--color-gold);
  background-color: rgba(255, 255, 255, 0.03);
}

.has-dropdown:hover .nav-arrow {
  transform: rotate(180deg);
}

/* Mega Menu Structure */
.has-mega-menu {
  position: static;
}

.mega-menu {
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  background-color: var(--color-dark);
  border-bottom: 1.5px solid var(--color-gold);
  opacity: 0;
  visibility: hidden;
  transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  transform: translateY(10px);
  padding: 40px 0;
  box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
}

.has-mega-menu:hover .mega-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.mega-menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
