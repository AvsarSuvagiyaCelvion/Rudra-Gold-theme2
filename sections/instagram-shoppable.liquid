{% schema %}
{
  "name": "Instagram Follow Section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Gold Subtitle",
      "default": "LIFESTYLE INSPIRATION"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Gold Title",
      "default": "Follow Our Instagram Journey"
    },
    {
      "type": "text",
      "id": "gold_handle",
      "label": "Gold Instagram Handle",
      "default": "@rudragold_official"
    },
    {
      "type": "url",
      "id": "gold_url",
      "label": "Gold Instagram Profile URL"
    },
    {
      "type": "text",
      "id": "silver_subtitle",
      "label": "Silver Subtitle",
      "default": "THE GRAND MOTHER • STERLING SILVER"
    },
    {
      "type": "text",
      "id": "silver_title",
      "label": "Silver Title",
      "default": "Follow TGM on Instagram"
    },
    {
      "type": "text",
      "id": "silver_handle",
      "label": "Silver Instagram Handle",
      "default": "@thegrandmother_official"
    },
    {
      "type": "url",
      "id": "silver_url",
      "label": "Silver Instagram Profile URL"
    }
  ],
  "blocks": [
    {
      "type": "instagram_post",
      "name": "Instagram Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Post Photo (Upload in Admin)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Post Caption",
          "default": "Heritage Gold Collection"
        },
        {
          "type": "url",
          "id": "post_url",
          "label": "Post Instagram Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Follow Section",
      "blocks": [
        { "type": "instagram_post", "settings": { "caption": "Royal Temple Carvings" } },
        { "type": "instagram_post", "settings": { "caption": "Certified Bridal Heritage" } },
        { "type": "instagram_post", "settings": { "caption": "Handcrafted Solitaires" } },
        { "type": "instagram_post", "settings": { "caption": "Antique Gold Bangles" } },
        { "type": "instagram_post", "settings": { "caption": "Master Karigar Artistry" } },
        { "type": "instagram_post", "settings": { "caption": "Bespoke Boutique Preview" } }
      ]
    }
  ]
}
{% endschema %}

<section class="instagram-shoppable section-padding">
  <div class="container">
    
    <!-- GOLD BRAND INSTAGRAM FOLLOW -->
    <div class="brand-gold-only">
      <div class="section-header text-center">
        <span class="section-subtitle">{{ section.settings.subtitle }} • {{ section.settings.gold_handle }}</span>
        <h2 class="section-title">{{ section.settings.title }}</h2>
        <p class="insta-description">
          Join our royal community on Instagram for daily handcrafted heritage inspirations, bespoke karigar stories, and exclusive boutique previews.
        </p>

        <a href="{{ section.settings.gold_url | default: 'https://instagram.com' }}" target="_blank" class="insta-follow-btn gold-insta-btn">
          <svg class="insta-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          Follow {{ section.settings.gold_handle }}
        </a>
      </div>

      <div class="insta-grid">
        {%- assign gold_blocks = section.blocks | where: "type", "instagram_post" -%}
        {%- if gold_blocks.size > 0 -%}
          {%- for block in gold_blocks -%}
            {%- assign photo_url = "" -%}
            {%- if block.settings.image != blank -%}
              {%- assign photo_url = block.settings.image | image_url: width: 600 -%}
            {%- endif -%}
            {%- if photo_url == blank -%}
              {%- assign mod_idx = forloop.index0 | modulo: 6 -%}
              {%- if mod_idx == 0 -%}
                {%- assign photo_url = "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=400&q=80" -%}
              {%- elsif mod_idx == 1 -%}
                {%- assign photo_url = "https://images.unsplash.com/photo-1602751584552-8ba73aad10e1?auto=format&fit=crop&w=400&q=80" -%}
              {%- elsif mod_idx == 2 -%}
                {%- assign photo_url = "https://images.unsplash.com/photo-1603561591411-07134e71a2a9?auto=format&fit=crop&w=400&q=80" -%}
              {%- elsif mod_idx == 3 -%}
                {%- assign photo_url = "https://images.unsplash.com/photo-1599643477877-530eb83abc8e?auto=format&fit=crop&w=400&q=80" -%}
              {%- elsif mod_idx == 4 -%}
                {%- assign photo_url = "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?auto=format&fit=crop&w=400&q=80" -%}
              {%- else -%}
                {%- assign photo_url = "https://images.unsplash.com/photo-1605100804763-247f67b3557e?auto=format&fit=crop&w=400&q=80" -%}
              {%- endif -%}
            {%- endif -%}

            <a href="{{ block.settings.post_url | default: section.settings.gold_url | default: 'https://instagram.com' }}" target="_blank" class="insta-item" {{ block.shopify_attributes }}>
              <img src="{{ photo_url }}" alt="{{ block.settings.caption }}" loading="lazy">
              <div class="insta-overlay">
                <div class="insta-hover-box">
                  <svg class="insta-hover-icon" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                  <span class="insta-hover-text">{{ block.settings.caption }}</span>
                </div>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Default Fallback Grid -->
          <a href="https://instagram.com" target="_blank" class="insta-item">
            <img src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=400&q=80" alt="Bridal Heritage" loading="lazy">
