<style>
.section-header.text-center {
  text-align: center;
  margin-bottom: 36px;
}

.insta-description {
  max-width: 600px;
  margin: 10px auto 20px;
  font-size: 13px;
  color: var(--color-text-muted);
  line-height: 1.6;
}

.insta-follow-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  border-radius: 30px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

.gold-insta-btn {
  background: linear-gradient(135deg, #C8A13D 0%, #E6C575 50%, #B38828 100%);
  color: #000000;
}

.gold-insta-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(200, 161, 61, 0.4);
}

.silver-insta-btn {
  background: linear-gradient(135deg, #E0E0E0 0%, #FFFFFF 50%, #A0A0A0 100%);
  color: #000000;
}

.silver-insta-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(192, 192, 192, 0.4);
}

.insta-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16px;
}

.insta-item {
  position: relative;
  overflow: hidden;
  border-radius: 10px;
  border: 1px solid rgba(200, 161, 61, 0.25);
  aspect-ratio: 1 / 1;
  display: block;
  text-decoration: none;
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}

.insta-item img {
  width: 100%;
