{% schema %}
{
  "name": "Wishlist Page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Wishlist" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Your curated collection of desires" }
  ]
}
{% endschema %}

<section class="wishlist-page section-padding">
  <div class="container">

    <div class="section-header">
      <p class="section-subtitle">{{ section.settings.subheading }}</p>
      <h1 class="section-title">{{ section.settings.heading }}</h1>
    </div>

    <!-- Empty State -->
    <div id="wishlistEmpty" class="wishlist-empty" style="display:none;">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <h3>Your wishlist is empty</h3>
      <p>Save pieces you love and find them here anytime.</p>
      <a href="/collections" class="btn-primary" style="margin-top: 24px; display: inline-flex;">Explore Collections</a>
    </div>

    <!-- Wishlist Grid -->
    <div id="wishlistGrid" class="wishlist-grid"></div>

  </div>
</section>

<style>
.wishlist-empty {
  text-align: center;
  padding: 80px 20px;
  color: var(--color-text-muted);
}

.wishlist-empty svg {
  color: var(--color-gold);
  margin: 0 auto 20px;
  opacity: 0.6;
}

.wishlist-empty h3 {
  font-family: var(--font-serif);
  font-size: 24px;
  color: var(--color-dark);
  margin-bottom: 10px;
}

.wishlist-empty p {
  font-size: 13px;
}

.wishlist-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.wishlist-card {
  background-color: var(--color-light);
  border: 1px solid rgba(11, 11, 11, 0.06);
  position: relative;
  display: flex;
  flex-direction: column;
}

.wishlist-card-img-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 115%;
  overflow: hidden;
  background-color: var(--color-cream);
}

.wishlist-card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
}

.wishlist-card:hover .wishlist-card-img {
  transform: scale(1.05);
}

.wishlist-remove-btn {
  position: absolute;
  top: 12px; right: 12px;
  width: 32px; height: 32px;
  border-radius: 50%;
  background-color: var(--color-light);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 8px rgba(11,11,11,0.12);
  cursor: pointer;
  z-index: 3;
  border: none;
  transition: var(--transition-fast);
}

.wishlist-remove-btn:hover {
  background-color: #fee2e2;
}

.wishlist-remove-btn svg {
  width: 14px; height: 14px;
  stroke: #e53e3e;
}

.wishlist-card-info {
  padding: 16px;
  text-align: center;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.wishlist-card-title {
  font-family: var(--font-serif);
  font-size: 15px;
  font-weight: 500;
  color: var(--color-dark);
  margin-bottom: 6px;
}

.wishlist-card-price {
  font-size: 13px;
  font-weight: 600;
  color: var(--color-dark);
  margin-bottom: 14px;
  margin-top: auto;
}

.wishlist-card-add-btn {
  width: 100%;
  padding: 11px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  background-color: var(--color-dark);
  color: var(--color-light);
  border: 1px solid var(--color-gold);
  cursor: pointer;
  transition: var(--transition-fast);
}

.wishlist-card-add-btn:hover {
  background-color: var(--color-gold);
  color: var(--color-dark);
}

@media (max-width: 991px) {
  .wishlist-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 768px) {
  .wishlist-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
}

@media (max-width: 400px) {
  .wishlist-grid { grid-template-columns: 1fr; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const grid = document.getElementById('wishlistGrid');
  const empty = document.getElementById('wishlistEmpty');

  function getWishlist() {
    try { return JSON.parse(localStorage.getItem('rudra_gold_wishlist') || '[]'); }
    catch { return []; }
  }

  function saveWishlist(items) {
    localStorage.setItem('rudra_gold_wishlist', JSON.stringify(items));
  }

  function renderWishlist() {
    const items = getWishlist();
    grid.innerHTML = '';

    if (items.length === 0) {
      empty.style.display = 'block';
      grid.style.display = 'none';
      return;
    }

    empty.style.display = 'none';
    grid.style.display = 'grid';

    items.forEach((item, index) => {
      const card = document.createElement('div');
      card.className = 'wishlist-card';
      card.innerHTML = `
        <div class="wishlist-card-img-wrapper">
          <img class="wishlist-card-img" src="${item.img}" alt="${item.title}">
          <button class="wishlist-remove-btn" data-index="${index}" aria-label="Remove from wishlist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
            </svg>
          </button>
        </div>
        <div class="wishlist-card-info">
          <h3 class="wishlist-card-title">${item.title}</h3>
          <p class="wishlist-card-price">${item.price}</p>
          <button class="wishlist-card-add-btn" onclick="addToCartAjax('${item.title}', ${item.rawPrice}, '${item.img}', '22K Gold', '')">
            Add to Bag
          </button>
        </div>
      `;
      grid.appendChild(card);
    });

    // Remove buttons
    grid.querySelectorAll('.wishlist-remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const items = getWishlist();
        items.splice(parseInt(btn.dataset.index), 1);
        saveWishlist(items);
        // Sync counter
        const counter = document.querySelector('.wishlist-count');
        if (counter) counter.textContent = items.length;
        renderWishlist();
      });
    });
  }

  renderWishlist();
});
</script>
