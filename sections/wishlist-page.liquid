{% schema %}
{
  "name": "Wishlist Page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Wishlist" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Your curated collection of desires" }
  ]
}
{% endschema %}

<section class="wishlist-page section-padding">
  <div class="container">

    <div class="section-header text-center">
      <p class="section-subtitle">{{ section.settings.subheading }}</p>
      <h1 class="section-title">{{ section.settings.heading }}</h1>

      <!-- Brand Filter Tabs -->
      <div class="wishlist-brand-tabs" id="wishlistBrandTabs">
        <button class="wishlist-tab-btn active" data-tab="active">
          <span class="tab-icon">✨</span>
          <span class="tab-label">Current Curation</span>
          <span class="tab-count" id="tabCountActive">0</span>
        </button>
        <button class="wishlist-tab-btn" data-tab="gold">
          <span class="tab-label">Rudra Gold</span>
          <span class="tab-count" id="tabCountGold">0</span>
        </button>
        <button class="wishlist-tab-btn" data-tab="silver">
          <span class="tab-label">The Grand Mother</span>
          <span class="tab-count" id="tabCountSilver">0</span>
        </button>
        <button class="wishlist-tab-btn" data-tab="all">
          <span class="tab-label">All Saved</span>
          <span class="tab-count" id="tabCountAll">0</span>
        </button>
      </div>
    </div>

    <!-- Empty State -->
    <div id="wishlistEmpty" class="wishlist-empty" style="display:none;">
      <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <h3 id="emptyHeading">Your wishlist is empty</h3>
      <p id="emptyText">Save pieces you love and find them here anytime.</p>
      <div id="emptyActions" style="margin-top: 24px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a id="emptyExploreBtn" href="/collections/all" class="btn-primary">Explore Collections</a>
        <button id="emptySwitchTabBtn" class="btn-secondary" style="display:none;"></button>
      </div>
    </div>

    <!-- Wishlist Grid -->
    <div id="wishlistGrid" class="wishlist-grid"></div>

  </div>
</section>

<style>
.wishlist-brand-tabs {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;
  margin-top: 24px;
  margin-bottom: 36px;
  flex-wrap: wrap;
}

.wishlist-tab-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 22px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  background: rgba(0, 0, 0, 0.03);
  border: 1px solid var(--color-gray-border);
  border-radius: 30px;
  cursor: pointer;
  color: var(--color-dark);
  transition: var(--transition-fast);
}

.wishlist-tab-btn:hover {
  border-color: var(--color-gold);
  background: rgba(200, 161, 61, 0.08);
}

.wishlist-tab-btn.active {
  background: var(--color-dark);
  color: var(--color-light);
  border-color: var(--color-gold);
}

html.theme-silver .wishlist-tab-btn.active {
  border-color: #C0C0C0;
}

.tab-count {
  font-size: 10px;
  padding: 2px 7px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.2);
  color: inherit;
}

.wishlist-tab-btn:not(.active) .tab-count {
  background: rgba(0, 0, 0, 0.08);
}

.wishlist-empty {
  text-align: center;
  padding: 60px 20px;
  color: var(--color-text-muted);
}

.wishlist-empty svg {
  color: var(--color-gold);
  margin: 0 auto 20px;
  opacity: 0.6;
}

.wishlist-empty h3 {
  font-family: var(--font-serif);
  font-size: 24px;
  color: var(--color-dark);
  margin-bottom: 10px;
}

.wishlist-empty p {
  font-size: 13px;
}

.wishlist-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.wishlist-card {
  background-color: var(--color-light);
  border: 1px solid rgba(11, 11, 11, 0.08);
  border-radius: 4px;
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: var(--transition-fast);
}

.wishlist-card:hover {
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}

.wishlist-brand-tag {
  position: absolute;
  top: 12px;
  left: 12px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 20px;
  z-index: 2;
}

.wishlist-brand-tag.tag-gold {
  background: rgba(11, 11, 11, 0.85);
  color: var(--color-gold);
  border: 1px solid var(--color-gold);
}

.wishlist-brand-tag.tag-silver {
  background: rgba(11, 11, 11, 0.85);
  color: #C0C0C0;
  border: 1px solid #C0C0C0;
}

.wishlist-card-img-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 110%;
  overflow: hidden;
  background-color: var(--color-cream);
}

.wishlist-card-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
}

.wishlist-card:hover .wishlist-card-img {
  transform: scale(1.05);
}

.wishlist-remove-btn {
  position: absolute;
  top: 12px; right: 12px;
  width: 32px; height: 32px;
  border-radius: 50%;
  background-color: var(--color-light);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2px 8px rgba(11,11,11,0.12);
  cursor: pointer;
  z-index: 3;
  border: none;
  transition: var(--transition-fast);
}

.wishlist-remove-btn:hover {
  background-color: #fee2e2;
}

.wishlist-remove-btn svg {
  width: 14px; height: 14px;
  stroke: #e53e3e;
}

.wishlist-card-info {
  padding: 18px;
  text-align: center;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.wishlist-card-title {
  font-family: var(--font-serif);
  font-size: 16px;
  font-weight: 500;
  color: var(--color-dark);
  margin-bottom: 6px;
}

.wishlist-card-meta {
  font-size: 11px;
  color: var(--color-text-muted);
  margin-bottom: 8px;
}

.wishlist-card-price {
  font-size: 14px;
  font-weight: 600;
  color: var(--color-dark);
  margin-bottom: 14px;
  margin-top: auto;
}

.wishlist-card-add-btn {
  width: 100%;
  padding: 12px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  background-color: var(--color-dark);
  color: var(--color-light);
  border: 1px solid var(--color-gold);
  cursor: pointer;
  transition: var(--transition-fast);
}

html.theme-silver .wishlist-card-add-btn {
  border-color: #C0C0C0;
}

.wishlist-card-add-btn:hover {
  background-color: var(--color-gold);
  color: var(--color-dark);
}

html.theme-silver .wishlist-card-add-btn:hover {
  background-color: #C0C0C0;
  color: var(--color-dark);
}

@media (max-width: 991px) {
  .wishlist-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 768px) {
  .wishlist-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
}

@media (max-width: 480px) {
  .wishlist-grid { grid-template-columns: 1fr; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const grid = document.getElementById('wishlistGrid');
  const empty = document.getElementById('wishlistEmpty');
  const tabBtns = document.querySelectorAll('.wishlist-tab-btn');
  let currentTab = 'active'; // 'active', 'gold', 'silver', 'all'

  function getActiveBrand() {
    return document.documentElement.classList.contains('theme-silver') ? 'silver' : 'gold';
  }

  function getWishlist() {
    try {
      const items = JSON.parse(localStorage.getItem('rudra_gold_wishlist') || '[]');
      return items.map(item => {
        if (!item.brand) {
          const lower = (item.title + ' ' + (item.purity || '')).toLowerCase();
          item.brand = (lower.includes('silver') || lower.includes('grand mother') || lower.includes('tgm') || lower.includes('925')) ? 'silver' : 'gold';
        }
        if (!item.purity) {
          item.purity = item.brand === 'silver' ? '925 Sterling Silver' : '22K Gold';
        }
        return item;
      });
    } catch { return []; }
  }

  function saveWishlist(items) {
    localStorage.setItem('rudra_gold_wishlist', JSON.stringify(items));
    document.querySelectorAll('.wishlist-count').forEach(el => el.textContent = items.length);
  }

  function updateCounts() {
    const allItems = getWishlist();
    const activeBrand = getActiveBrand();
    
    const goldItems = allItems.filter(i => i.brand === 'gold');
    const silverItems = allItems.filter(i => i.brand === 'silver');
    const activeItems = allItems.filter(i => i.brand === activeBrand);

    document.getElementById('tabCountActive').textContent = activeItems.length;
    document.getElementById('tabCountGold').textContent = goldItems.length;
    document.getElementById('tabCountSilver').textContent = silverItems.length;
    document.getElementById('tabCountAll').textContent = allItems.length;

    const activeBtn = document.querySelector('[data-tab="active"] .tab-label');
    if (activeBtn) {
      activeBtn.textContent = activeBrand === 'silver' ? 'Silver Curation' : 'Gold Curation';
    }
  }

  function renderWishlist() {
    const allItems = getWishlist();
    const activeBrand = getActiveBrand();
    updateCounts();

    let displayItems = [];

    if (currentTab === 'active') {
      displayItems = allItems.filter(i => i.brand === activeBrand);
    } else if (currentTab === 'gold') {
      displayItems = allItems.filter(i => i.brand === 'gold');
    } else if (currentTab === 'silver') {
      displayItems = allItems.filter(i => i.brand === 'silver');
    } else {
      displayItems = allItems;
    }

    grid.innerHTML = '';

    if (displayItems.length === 0) {
      empty.style.display = 'block';
      grid.style.display = 'none';

      const emptyHeading = document.getElementById('emptyHeading');
      const emptyText = document.getElementById('emptyText');
      const exploreBtn = document.getElementById('emptyExploreBtn');
      const switchTabBtn = document.getElementById('emptySwitchTabBtn');

      if (currentTab === 'active' || currentTab === activeBrand) {
        const otherBrand = activeBrand === 'gold' ? 'silver' : 'gold';
        const otherItems = allItems.filter(i => i.brand === otherBrand);

        emptyHeading.textContent = `Your ${activeBrand === 'silver' ? 'Silver' : 'Gold'} Wishlist is Empty`;
        emptyText.textContent = `Save pieces from ${activeBrand === 'silver' ? 'The Grand Mother Silver' : 'Rudra Gold'} to view them here.`;
        exploreBtn.setAttribute('href', `/collections/all?brand=${activeBrand}`);
        exploreBtn.textContent = `Explore ${activeBrand === 'silver' ? 'Silver' : 'Gold'} Collection`;

        if (otherItems.length > 0) {
          switchTabBtn.style.display = 'inline-flex';
          switchTabBtn.textContent = `View ${otherBrand === 'silver' ? 'Silver' : 'Gold'} Wishlist (${otherItems.length})`;
          switchTabBtn.onclick = () => {
            currentTab = otherBrand;
            tabBtns.forEach(btn => btn.classList.toggle('active', btn.dataset.tab === otherBrand));
            renderWishlist();
          };
        } else {
          switchTabBtn.style.display = 'none';
        }
      } else {
        emptyHeading.textContent = 'No Items Found';
        emptyText.textContent = 'Your wishlist for this filter is empty.';
        exploreBtn.setAttribute('href', '/collections/all');
        exploreBtn.textContent = 'Explore Collections';
        switchTabBtn.style.display = 'none';
      }
      return;
    }

    empty.style.display = 'none';
    grid.style.display = 'grid';

    displayItems.forEach((item) => {
      const originalIndex = allItems.findIndex(i => i.title === item.title && i.img === item.img);

      const card = document.createElement('div');
      card.className = 'wishlist-card';
      const isSilverItem = item.brand === 'silver';

      card.innerHTML = `
        <div class="wishlist-brand-tag ${isSilverItem ? 'tag-silver' : 'tag-gold'}">
          ${isSilverItem ? '💎 Silver' : '✨ Gold'}
        </div>
        <div class="wishlist-card-img-wrapper">
          <a href="${item.url || '#'}">
            <img class="wishlist-card-img" src="${item.img}" alt="${item.title}">
          </a>
          <button class="wishlist-remove-btn" data-index="${originalIndex}" aria-label="Remove from wishlist">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
            </svg>
          </button>
        </div>
        <div class="wishlist-card-info">
          <h3 class="wishlist-card-title">
            <a href="${item.url || '#'}">${item.title}</a>
          </h3>
          <div class="wishlist-card-meta">${item.purity || (isSilverItem ? '925 Sterling Silver' : '22K Gold')}</div>
          <p class="wishlist-card-price">${item.price}</p>
          <button class="wishlist-card-add-btn" onclick="addToCartAjax('${item.title.replace(/'/g, "\\'")}', ${item.rawPrice || 0}, '${item.img}', '${item.purity || ''}', '${item.variantId || ''}')">
            Add to Bag
          </button>
        </div>
      `;
      grid.appendChild(card);
    });

    // Remove buttons
    grid.querySelectorAll('.wishlist-remove-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const index = parseInt(btn.dataset.index);
        const allItems = getWishlist();
        if (index > -1 && index < allItems.length) {
          allItems.splice(index, 1);
          saveWishlist(allItems);
          renderWishlist();
        }
      });
    });
  }

  // Tab switching
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentTab = btn.dataset.tab;
      renderWishlist();
    });
  });

  // Re-render when active theme changes
  const observer = new MutationObserver(() => {
    updateCounts();
    renderWishlist();
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  renderWishlist();
});
</script>
