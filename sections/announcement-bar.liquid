{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "✨ Exclusive Bridal Curation: Complimentary Home Trials Available Across Selected Flagships"
    },
    {
      "type": "checkbox",
      "id": "show_gold_rate",
      "label": "Show Live Gold Rate Ticker",
      "default": true
    },
    {
      "type": "text",
      "id": "gold_rate_22k",
      "label": "Base Gold Rate 22K (per gram in INR)",
      "default": "6,850"
    },
    {
      "type": "text",
      "id": "gold_rate_18k",
      "label": "Base Gold Rate 18K (per gram in INR)",
      "default": "5,605"
    }
  ]
}
{% endschema %}

<div class="announcement-bar-section">
  <div class="container announcement-bar-container">
    <div class="announcement-message slide-item active">
      {{ section.settings.announcement_text }}
    </div>
    {% if section.settings.show_gold_rate %}
      <div class="announcement-gold-ticker slide-item">
        {% render 'gold-rate-ticker', gold_rate_22k: section.settings.gold_rate_22k, gold_rate_18k: section.settings.gold_rate_18k %}
      </div>
    {% endif %}
  </div>
</div>

<style>
.announcement-bar-section {
  background-color: var(--color-dark);
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  padding: 8px 0;
  z-index: 1000;
  position: relative;
}

.announcement-bar-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.announcement-message {
  font-size: 11px;
  color: var(--color-light);
  font-weight: 400;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  flex: 1;
}

@media (max-width: 768px) {
  .announcement-bar-section {
    padding: 8px 0;
  }
  .announcement-bar-container {
    position: relative;
    height: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
  .announcement-bar-container .slide-item {
    position: absolute;
    width: 100%;
    text-align: center;
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .announcement-bar-container .slide-item.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .announcement-message {
    display: block !important;
    font-size: 9px;
    text-align: center;
    letter-spacing: 0.05em;
    line-height: 1.4;
    color: var(--color-light);
    max-width: 90%;
  }
  .announcement-gold-ticker {
    width: 100%;
    display: flex !important;
    justify-content: center;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const slides = document.querySelectorAll('.announcement-bar-container .slide-item');
  if (slides.length <= 1) return;

  const isMobile = () => window.innerWidth <= 768;
  let currentIndex = 0;

  function showNextSlide() {
    if (!isMobile()) {
      slides.forEach(slide => {
        slide.classList.remove('active');
        slide.style.opacity = '';
        slide.style.transform = '';
      });
      return;
    }

    slides[currentIndex].classList.remove('active');
    currentIndex = (currentIndex + 1) % slides.length;
    slides[currentIndex].classList.add('active');
  }

  // Auto-slide transition every 4.5 seconds
  setInterval(showNextSlide, 4500);

  // Initial layout activation
  if (isMobile()) {
    slides.forEach((slide, idx) => {
      if (idx === 0) slide.classList.add('active');
      else slide.classList.remove('active');
    });
  }

  window.addEventListener('resize', () => {
    if (!isMobile()) {
      slides.forEach(slide => {
        slide.classList.remove('active');
        slide.style.opacity = '';
        slide.style.transform = '';
      });
    } else {
      slides.forEach((slide, idx) => {
        if (idx === currentIndex) slide.classList.add('active');
        else slide.classList.remove('active');
      });
    }
  });
});
</script>
