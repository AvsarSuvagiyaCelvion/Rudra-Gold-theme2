{%- assign selected_brand = 'gold' -%}
{%- if request.query_string contains 'brand=silver' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif request.query_string contains 'brand=gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif request.path contains 'silver' or request.path contains 'grand-mother' or request.path contains 'tgm' -%}
  {%- assign selected_brand = 'silver' -%}
{%- elsif request.path contains 'gold' or request.path contains 'rudra-gold' -%}
  {%- assign selected_brand = 'gold' -%}
{%- elsif product != blank -%}
  {%- assign product_tags_down = product.tags | join: ',' | downcase -%}
  {%- if product_tags_down contains 'silver' or product_tags_down contains 'grand mother' or product_tags_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- elsif collection != blank -%}
  {%- assign collection_handle_down = collection.handle | downcase -%}
  {%- if collection_handle_down contains 'silver' or collection_handle_down contains 'grand-mother' or collection_handle_down contains 'tgm' -%}
    {%- assign selected_brand = 'silver' -%}
  {%- endif -%}
{%- endif -%}
{%- capture initial_theme -%}
  theme-{{ selected_brand }}
{%- endcapture -%}
<!doctype html>
<html class="no-js {{ initial_theme | strip }}" lang="{{ request.locale.iso_code }}">
  <head>
    <script>
      (function() {
        const params = new URLSearchParams(window.location.search);
        let brand = params.get('brand') || params.get('theme');
        
        const path = window.location.pathname.toLowerCase();
        if (path.includes('grand-mother') || path.includes('silver')) {
          brand = 'silver';
        } else if (path.includes('rudra-gold') || path.includes('gold')) {
          brand = 'gold';
        }
        
        if (!brand) {
          try {
            brand = localStorage.getItem('active_brand');
          } catch(e) {}
        }
        
        const isHomepage = window.location.pathname === '/';
        
        if (brand === 'silver') {
          document.documentElement.classList.add('theme-silver');
          document.documentElement.classList.remove('theme-gold', 'brand-not-selected');
          try {
            localStorage.setItem('active_brand', 'silver');
          } catch(e) {}
        } else if (brand === 'gold') {
          document.documentElement.classList.add('theme-gold');
          document.documentElement.classList.remove('theme-silver', 'brand-not-selected');
          try {
            localStorage.setItem('active_brand', 'gold');
          } catch(e) {}
        } else {
          // Default fallback to gold theme
          document.documentElement.classList.add('theme-gold');
          document.documentElement.classList.remove('theme-silver', 'brand-not-selected');
          try {
            localStorage.setItem('active_brand', 'gold');
          } catch(e) {}
        }
      })();
    </script>
    <script>
      window.ShopifyThemeSettings = {
        goldRate22k: "{{ settings.gold_rate_22k | default: '13000' | escape }}",
        goldRate18k: "{{ settings.gold_rate_18k | default: '12000' | escape }}",
        silverRate925: "{{ settings.silver_rate_925 | default: '160' | escape }}",
        goldWhatsappNumber: "{{ settings.whatsapp_gold_number | default: '917405544338' | escape }}",
        goldWhatsappMessage: "{{ settings.whatsapp_gold_message | default: 'Hello Rudra Gold, I would like to inquire about your gold jewellery.' | escape }}",
        silverWhatsappNumber: "{{ settings.whatsapp_silver_number | default: '918849486223' | escape }}",
        silverWhatsappMessage: "{{ settings.whatsapp_silver_message | default: 'Hello The Grand Mother, I would like to inquire about your 925 sterling silver jewellery.' | escape }}"
      };
    </script>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0B0B0B">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&display=swap" rel="stylesheet">

    <!-- CSS Assets -->
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <!-- Shopify Content For Header -->
    {{ content_for_header }}

    <!-- Animation & Smooth Scroll CDNs -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.27/dist/lenis.min.js" defer></script>

    <!-- Theme JS Asset -->
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "http://schema.org",
        "@type": "Organization",
        "name": "RUDRA GOLD",
        "url": "{{ shop.url }}",
        "logo": "https:{{ 'rudra_logo.png' | asset_url }}",
        "description": "Timeless Purity, Crafted for Royalty - Luxury Gold & Diamond Jewellery.",
        "sameAs": [
          "{{ settings.social_facebook_link }}",
          "{{ settings.social_instagram_link }}"
        ]
      }
    </script>
  </head>

  <body class="template-{{ template.name }}">
    <!-- Brand Selection Landing Screen -->
    <div id="brandSelectionLanding" class="brand-selection-screen">
      <div class="brand-selection-container">
        <span class="selection-welcome">Welcome</span>
        <h2 class="selection-heading Cormorant">Choose Your Jewellery Experience</h2>
        
        <div class="selection-cards-grid">
          <!-- Card 1: Rudra Gold -->
          <div class="selection-card card-gold-theme" onclick="selectBrandLanding('gold')">
            <div class="selection-card-border"></div>
            <div class="selection-card-content">
              <span class="brand-badge gold-badge">✨</span>
              <h3 class="brand-title Cormorant">Rudra Gold</h3>
              <p class="brand-desc">Luxury Gold Jewellery</p>
              <button class="selection-btn gold-btn">Enter Gold Collection</button>
            </div>
          </div>

          <!-- Card 2: The Grand Mother -->
          <div class="selection-card card-silver-theme" onclick="selectBrandLanding('silver')">
            <div class="selection-card-border"></div>
            <div class="selection-card-content">
              <span class="brand-badge silver-badge">💎</span>
              <h3 class="brand-title Cormorant">The Grand Mother</h3>
              <p class="brand-desc">925 Sterling Silver Jewellery</p>
              <button class="selection-btn silver-btn">Enter Silver Collection</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      function selectBrandLanding(brand) {
        try {
          localStorage.setItem('active_brand', brand);
        } catch(e) {}
        
        // Remove selection screen state
        document.documentElement.classList.remove('brand-not-selected');
        
        if (brand === 'silver') {
          document.documentElement.classList.add('theme-silver');
          document.documentElement.classList.remove('theme-gold');
        } else {
          document.documentElement.classList.add('theme-gold');
          document.documentElement.classList.remove('theme-silver');
        }
        
        // Redirect to apply brand query parameter updates
        window.location.href = '/?brand=' + brand;
      }
    </script>

    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      Skip to content
    </a>

    <!-- Theme Header Wrapper -->
    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Theme Footer Wrapper -->
    {% section 'footer' %}

    <!-- Mobile Bottom Navigation Bar -->
    <div class="mobile-bottom-nav">
      <a href="/" class="mobile-nav-link {% if template.name == 'index' %}active{% endif %}">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1v-5a1 1 0 0 0-1-1h-2a1 1 0 0 0-1 1v5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/>
        </svg>
        <span>Home</span>
      </a>
      <a href="/collections" class="mobile-nav-link {% if template.name == 'list-collections' %}active{% endif %}">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="3" y="3" width="7" height="9" rx="1"/>
          <rect x="14" y="3" width="7" height="5" rx="1"/>
          <rect x="14" y="12" width="7" height="9" rx="1"/>
          <rect x="3" y="16" width="7" height="5" rx="1"/>
        </svg>
        <span>Collections</span>
      </a>
      <button class="mobile-nav-link" id="mobileSearchTrigger" aria-label="Open Search">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <span>Search</span>
      </button>
      <a href="/pages/wishlist" class="mobile-nav-link">
        <div class="nav-icon-badge-wrapper">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="wishlist-count nav-badge">0</span>
        </div>
        <span>Wishlist</span>
      </a>
      <button class="mobile-nav-link" id="mobileCartTrigger" aria-label="Open Cart">
        <div class="nav-icon-badge-wrapper">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="cart-count-badge nav-badge" id="mobileCartCount">0</span>
        </div>
        <span>Cart</span>
      </button>
    </div>

    <!-- Floating VIP WhatsApp Concierge -->
    {%- assign whatsapp_number = settings.whatsapp_gold_number | default: '917405544338' -%}
    {%- assign whatsapp_text = settings.whatsapp_gold_message | default: 'Hello Rudra Gold, I would like to inquire about your gold jewellery.' | url_encode -%}
    {%- if selected_brand == 'silver' -%}
      {%- assign whatsapp_number = settings.whatsapp_silver_number | default: '918849486223' -%}
      {%- assign whatsapp_text = settings.whatsapp_silver_message | default: 'Hello The Grand Mother, I would like to inquire about your 925 sterling silver jewellery.' | url_encode -%}
    {%- endif -%}
    <a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_text }}" data-whatsapp-concierge-link class="whatsapp-vip-concierge" target="_blank" rel="noopener" aria-label="Connect with VIP Concierge">
      <div class="whatsapp-pulse"></div>
      <svg viewBox="0 0 24 24" class="whatsapp-icon">
        <path fill="#FFFFFF" d="M12.012 2c-5.506 0-9.989 4.478-9.99 9.984a9.96 9.96 0 0 0 1.333 4.993L2 22l5.233-1.371a9.945 9.945 0 0 0 4.773 1.216h.004c5.505 0 9.986-4.478 9.988-9.984A9.99 9.99 0 0 0 12.012 2zm5.72 13.56c-.244.688-1.22 1.253-1.676 1.302-.455.05-1.024.08-3.007-.74-2.535-1.048-4.17-3.626-4.297-3.796-.127-.17-.993-1.32-.993-2.52 0-1.198.625-1.787.848-2.028.224-.24.488-.301.65-.301.163 0 .325.002.467.008.148.007.348-.056.544.421.2.489.684 1.667.746 1.793.06.127.102.275.019.444-.083.17-.127.275-.253.422-.127.147-.267.33-.38.444-.127.12-.261.25-.112.505.15.253.66 1.09 1.417 1.76.977.868 1.797 1.14 2.054 1.267.257.127.408.106.56-.068.152-.174.65-.762.825-1.02.174-.258.349-.217.587-.127.24.09 1.517.715 1.777.846.26.13.433.195.497.302.064.106.064.617-.18 1.305z"/>
      </svg>
      <div class="tooltip-concierge">VIP Concierge</div>
    </a>

    <!-- AJAX Slide-out Cart Drawer snippet -->
    {% render 'cart-drawer' %}

    <!-- VIP Store Visit / Hallmark Certificate Modal -->
    <div id="luxuryModal" class="luxury-modal" aria-hidden="true">
      <div class="luxury-modal-overlay" id="luxuryModalOverlay"></div>
      <div class="luxury-modal-container">
        <button class="luxury-modal-close" id="luxuryModalClose" aria-label="Close modal">
          {% render 'icon-close' %}
        </button>
        <div class="luxury-modal-content" id="luxuryModalContent">
          <!-- Content injected dynamically via JS -->
        </div>
      </div>
    </div>

    <!-- Quick View Modal -->
    <div id="quickViewModal" class="luxury-modal" aria-hidden="true">
      <div class="luxury-modal-overlay" id="quickViewOverlay"></div>
      <div class="luxury-modal-container quickview-container">
        <button class="luxury-modal-close" id="quickViewClose" aria-label="Close quick view">
          {% render 'icon-close' %}
        </button>
        <div class="luxury-modal-content" id="quickViewContent">
          <!-- Dynamic Content -->
        </div>
      </div>
    </div>
    <!-- Predictive Search Drawer -->
    {% render 'predictive-search-drawer' %}
  </body>
</html>
